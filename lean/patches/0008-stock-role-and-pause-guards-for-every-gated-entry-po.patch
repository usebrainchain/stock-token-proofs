+/-- A function body that first asks `onlyRole(role)` (its `PUSH32 role; PUSH2 c; DUP2; PUSH2
+0x1954` call into entry 88), run from a free pointer moved past one reply of `n < 2 ^ 255` bytes:
+the registry answered `hasRole(role, caller)` with `1` over the run's world. -/
+theorem role_after {R : Exec.Deriv} {sevm : Sevm} (fork : CoveredFork sevm.benvStat.fork)
+    {b0 b' : Devm} {S : List B256} {M' : Mem} {I' : Bytes} {G' : Nat} {n : B256} {o : Outcome}
+    {bs c : Bytes} {le : bs.length ≤ 32} {le2 : c.length ≤ 32} {k : SFunc}
+    (quiet : QuietFrom sevm b0 b') (reads : Mem.Reads M' I') (wf : Mem.Wf M')
+    (hn : n.toNat < 2 ^ 255) (fp : I'.sliceD 64 32 0 = (bumpFp 128 n).toBytes)
+    (run : SFunc.RunP (StepIn R) cert.prog sevm (St b' S M' G')
+      (.dest (.next (.push bs le) (.next (.push c le2) (.next (.reg (.dup 1))
+        (.next (.push [0x19, 0x54] (by decide)) (.callNext 88 k)))))) o) :
+    ∃ (b'' : Devm) (out : Bytes), QuietFrom sevm b0 b'' ∧
+      StaticAnswered sevm b'' registry (hasRoleData (Bytes.toB256 bs) sevm.caller) out ∧
+      32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 1 := by
+  have project : ∀ {s d i d'}, StepIn R s d i d' → Ninst.Run s d i d' := fun h => StepIn.toRun h
+  stock_run
+  obtain ⟨_, _, run⟩ := rpw_into (g := t_1954_c88) rfl run
+  stock_run
+  obtain ⟨_, _, run⟩ := rpw_into (g := t_1e60_c119) rfl run
+  have bounds := bumpFp_bounds (p := 128) (n := n)
+    (by rw [show (128 : B256).toNat = 128 by decide]; omega)
+  rw [show (128 : B256).toNat = 128 by decide] at bounds
+  obtain ⟨out, answered, long, one⟩ :=
+    query_answered_at project fork reads wf fp (by omega) (by omega) run
+  exact ⟨b', out, quiet, by simpa only [hasRoleData, toAdr_toB256] using answered, long, one⟩
