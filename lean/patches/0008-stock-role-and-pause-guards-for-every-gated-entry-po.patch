+      ((out.take 32).length = 32 → I'.sliceD p.toNat 32 0 = out.take 32) ∧
+      SFunc.RunP P cert.prog sevm (St d (x0 :: x1 :: x2 :: x3 :: A :: R :: S) M' G')
