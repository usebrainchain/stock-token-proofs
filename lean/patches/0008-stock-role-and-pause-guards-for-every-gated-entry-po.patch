+theorem tokenFlag_of_stor {sevm : Sevm} {b c : Devm} (h : Devm.getStor c = Devm.getStor b) :
+    tokenFlag sevm c = tokenFlag sevm b := by
+  unfold tokenFlag
+  show _ &&& (Devm.getStor c _).get _ = _ &&& (Devm.getStor b _).get _
+  rw [h]
