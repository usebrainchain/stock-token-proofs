+/-- The reply handler's line, with its return label `lab`: drop the call operands, move the free
+pointer past the reply, and call the ABI `bool` decoder on `[ptr, ptr + returndatasize)`. -/
+def replyLineAt (lab : Bytes) (le : lab.length ≤ 32) : List Ninst :=
+  [.reg .pop, .reg .pop, .reg .pop, .reg .pop, .push [0x40] (by decide), .reg .mload,
+   .reg .returndatasize, .push [0x1f] (by decide), .reg .not, .push [0x1f] (by decide),
+   .reg (.dup 2), .reg .add, .reg .and, .reg (.dup 2), .reg .add, .reg (.dup 0),
+   .push [0x40] (by decide), .reg .mstore, .reg .pop, .reg (.dup 1), .reg .add, .reg (.swap 0),
+   .push lab le, .reg (.swap 1), .reg (.swap 0), .push [0x29, 0xf1] (by decide)]
