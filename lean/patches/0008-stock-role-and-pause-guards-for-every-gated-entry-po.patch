+    {o : Outcome} (fork : CoveredFork sevm.benvStat.fork)
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = p.toBytes)
+    (lo : 96 ≤ p.toNat) (hi : p.toNat + 68 < 2 ^ 256)
+    (run : SFunc.RunP P cert.prog sevm (St b (A :: R :: S) M G) t_1e60_c119 o) :
+    ∃ (out : Bytes) (d : Devm) (x0 x1 x2 x3 : B256) (M' : Mem) (I' : Bytes) (G' : Nat),
+      StaticAnswered sevm b registry
+        ([0x91, 0xd1, 0x48, 0x54] ++ R.toBytes ++ A.toAdr.toB256.toBytes) out ∧
+      out.length < 2 ^ 256 ∧ d.returnData = out ∧ QuietFrom sevm b d ∧
