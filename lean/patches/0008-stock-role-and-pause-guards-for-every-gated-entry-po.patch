+    ∃ G', d = St b (Bytes.toB256 [0x0e, 0x4d] :: B256.eqCheck (B256.eqCheck flag 0) 0 ::
+      B256.eqCheck flag 0 :: S) M G' := by
+  stock_line
+  cases run
