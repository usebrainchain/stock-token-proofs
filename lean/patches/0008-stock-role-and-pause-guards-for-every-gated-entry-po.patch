+import Blanc.Lift.Stock.Query
+
+/-!
+# Stock: the paused guard, and the multiplier updater's role
+
+Plain statement (property 3, one theorem per entry point): for every state, environment, caller
+and registry code, if a run of Stock's deployed bytes with the entry point's selector succeeds,
+then the token's own paused flag (the low byte of its ERC-7201 slot `0x8d25…bc01`, in the frame's
+starting storage) was clear, and a static call to the registry with calldata `paused()` succeeds
+with at least 32 bytes whose first word is `0`.
+
+| entry point | selector | registry world of the `paused()` answer |
+|---|---|---|
+| `transfer(address,uint256)` | `0xa9059cbb` | the frame's starting world |
+| `transferFrom(address,address,uint256)` | `0x23b872dd` | the frame's starting world |
+| `approve(address,uint256)` | `0x095ea7b3` | the frame's starting world |
+| `permit(…)` | `0xd505accf` | the frame's starting world |
+| `updateMultiplier(uint256)` | `0x5ffe6146` | the frame's starting world |
+| `updateMultiplier(uint256,uint256)` | `0xbad60f18` | the frame's starting world |
+| `mint(address,uint256)` | `0x40c10f19` | after the `hasRole` query (`QuietFrom`) |
+| `burn(address,uint256)` | `0x9dc29fac` | after the `hasRole` query (`QuietFrom`) |
+
+Property 5 for both `updateMultiplier` forms: the registry answered `hasRole(MULTIPLIER_UPDATER_ROLE,
+caller)` with `1`, in the world after the `paused()` query (they check the pause first).
+
+Premises as for `pause_requires_role`.
+-/
+
+namespace Blanc.Lift.Stock
+
+open Jaune Blanc Blanc.Lift
+
+/-- Property 3's claim, at the frame's starting world. -/
+abbrev UnpausedAnswered (F : Exec.Deriv) : Prop :=
+  tokenFlag F.sevm F.devm = 0 ∧
+  ∃ out : Bytes, StaticAnswered F.sevm F.devm registry pausedData out ∧
+    32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 0
+
+def transferSelector : B256 := 0xa9059cbb
+def transferFromSelector : B256 := 0x23b872dd
+def approveSelector : B256 := 0x095ea7b3
+def permitSelector : B256 := 0xd505accf
+def updateMultiplierSelector : B256 := 0x5ffe6146
+def updateMultiplierAtSelector : B256 := 0xbad60f18
+
+section Guard
+
+variable {P : Sevm → Devm → Ninst → Devm → Prop} {fs : List SFunc} {sevm : Sevm}
+
+/-- Into an internal call's callee, whether it returns or halts the run. -/
+theorem rpw_into {k : Nat} {g f : SFunc} {dd : B256} {b : Devm} {S : List B256} {M : Mem} {G : Nat}
+    {o : Outcome} (hk : fs[k]? = some g)
+    (run : SFunc.RunP P fs sevm (St b (dd :: S) M G) (.callNext k f) o) :
+    ∃ G' o', SFunc.RunP P fs sevm (St b S M G') g o' := by
+  obtain ⟨G', ⟨D, callee, _⟩ | ⟨D, callee, _⟩⟩ := rpw_call hk run
+  · exact ⟨G', _, callee⟩
+  · exact ⟨G', _, callee⟩
+
+end Guard
+
+/-- At a call into the `paused()` routine (entry 58) from the frame's starting world with the
+free pointer at `0x80`, followed by the `if (paused()) revert` guard: a successful frame saw both
+flags clear, and the run goes on past the guard over a world reached quietly, with the free
+pointer moved past the registry's reply. -/
+theorem paused_cut {F : Exec.Deriv} {post : Devm} {t r : B256} {S : List B256}
+    {K : List SFunc} {lab : Bytes} {le : lab.length ≤ 32} {dead g : SFunc}
+    (cut : CursorStateAt code cert F
+      (.callNext 58 (.dest (.next (.reg .iszero) (.next (.push lab le) (.branch dead g)))))
+      F.devm (t :: r :: S) freeMem K)
+    (deadOk : dead.noOk = true)
+    (success : F.exn = .ok post) (fork : CoveredFork F.sevm.benvStat.fork) :
+    UnpausedAnswered F ∧ ∃ (R : Exec.Deriv) (b' : Devm) (M' : Mem) (I' : Bytes) (G' : Nat)
+      (n : B256) (o : Outcome),
+      QuietFrom F.sevm F.devm b' ∧ Mem.Reads M' I' ∧ Mem.Wf M' ∧ n.toNat < 2 ^ 255 ∧
+      I'.sliceD 64 32 0 = (bumpFp 128 n).toBytes ∧
+      SFunc.RunP (StepIn R) cert.prog F.sevm (St b' S M' G') g o := by
+  have hsg := fork.histFork.neutral.stateGas
+  obtain ⟨G, state⟩ := cut.state
+  obtain ⟨outcome, run⟩ := cut.placed.sourceRunH cert_check (cut.exn_eq.trans success)
+    (by rw [cut.sevm_eq]; exact hsg)
+  rw [cut.tree, state, cut.sevm_eq] at run
+  have project : ∀ {s d i d'}, StepIn cut.node s d i d' → Ninst.Run s d i d' :=
+    fun h => StepIn.toRun h
+  have onCode : F.sevm.code = code := by
+    rw [← cut.sevm_eq]; exact cut.placed.code_eq
+  have reads : Mem.Reads freeMem (Bytes.writeAt [] 64 (128 : B256).toBytes) :=
+    Mem.reads_empty.write Mem.wf_empty 64 _
+  have wf : Mem.Wf freeMem := Mem.Wf.write Mem.wf_empty 64 _
+  have ptr : (Bytes.writeAt [] 64 (128 : B256).toBytes).sliceD 64 32 0 = (128 : B256).toBytes := by
+    decide
+  obtain ⟨_, D, callee, run⟩ := rpw_callOver (S' := [58, 83, 18]) (g := t_0dc8_c58)
+    (by decide +kernel) rfl (by decide) run
+  obtain ⟨b', w, M', G', rfl, facts⟩ :=
+    paused_returned project fork onCode reads wf ptr (by decide) callee
+  stock_run
+  obtain ⟨guard, _, run⟩ := (rpw_branch run).resolve_left (fun ⟨_, _, d⟩ => rpw_dead deadOk d)
+  have zero : w = 0 := B256.eqCheck_ne_zero_iff.mp guard
+  obtain ⟨flagClear, quiet, out, I', answered, long, word, short, r', w', fp⟩ := facts zero
+  refine ⟨⟨flagClear, out, answered, long, word⟩, cut.node, b', M', I', _, out.length.toB256, _,
+    quiet, r',
+    w', ?_, fp, run⟩
+  rwa [B256.toNat_toB256_of_lt (by omega)]
+
+/-- **`transfer(address,uint256)` runs only unpaused.** -/
+theorem transfer_requires_unpaused {F : Exec.Deriv} {post : Devm}
+    (pc : F.pc = 0) (onCode : F.sevm.code = code)
+    (stack : F.devm.stack = []) (memory : F.devm.memory = Mem.empty)
+    (selector : Sevm.selector F.sevm = transferSelector)
+    (success : F.exn = .ok post) (fork : CoveredFork F.sevm.benvStat.fork) :
+    UnpausedAnswered F := by
+  have neutral := fork.histFork.neutral
+  have hsg := neutral.stateGas
+  obtain ⟨cut⟩ := root_selected pc onCode stack memory success neutral
+  rw [selector] at cut
+  obtain ⟨cut⟩ := SolcSignedQuery.selector_gt_zero cut cert_check (by decide) success neutral
+  obtain ⟨cut⟩ := SolcSignedQuery.selector_gt_zero cut cert_check (by decide) success neutral
+  obtain ⟨cut⟩ := SolcSignedQuery.selector_gt_succ cut cert_check (by decide) success neutral
+  obtain ⟨cut⟩ := cut.destH cert_check success hsg
+  obtain ⟨cut⟩ := SolcSignedQuery.selector_eq_zero cut cert_check (by decide) success neutral
+  obtain ⟨cut⟩ := SolcSignedQuery.selector_eq_zero cut cert_check (by decide) success neutral
+  obtain ⟨cut⟩ := SolcSignedQuery.selector_eq_succ cut cert_check (by decide) rfl success neutral
+  stock_walk [58]
+  exact (paused_cut cut rfl success fork).1
