+theorem paused_tail {P : Sevm → Devm → Ninst → Devm → Prop}
+    (project : ∀ {s d i d'}, P s d i d' → Ninst.Run s d i d')
+    {b D : Devm} {w c2 z r : B256} {S : List B256} {M : Mem} {G : Nat}
+    (run : SFunc.RunP P cert.prog sevm (St b (w :: c2 :: z :: r :: S) M G) t_0e71_c58
