+/-- **The `paused()` routine (entry 58).**  A returning run from the free pointer `p` returns one
+word `w`.  If `w = 0`, the token's own flag was clear and the registry, asked `paused()` from the
+routine's starting world, answered with at least 32 bytes whose first word is `0`; the routine
+returns over a world reached quietly from its starting one, with the free pointer moved past the
+reply. -/
+theorem paused_returned {P : Sevm → Devm → Ninst → Devm → Prop}
+    (project : ∀ {s d i d'}, P s d i d' → Ninst.Run s d i d')
+    (fork : CoveredFork sevm.benvStat.fork) (onCode : sevm.code = code)
+    {b D : Devm} {p r : B256} {S : List B256} {M : Mem} {G : Nat} {I : Bytes}
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = p.toBytes)
+    (lo : 96 ≤ p.toNat)
+    (run : SFunc.RunP P cert.prog sevm (St b (r :: S) M G) t_0dc8_c58 (.returned D)) :
+    ∃ (b' : Devm) (w : B256) (M' : Mem) (G' : Nat), D = St b' (w :: S) M' G' ∧
+      (w = 0 → tokenFlag sevm b = 0 ∧ QuietFrom sevm b b' ∧
+        ∃ (out : Bytes) (I' : Bytes), StaticAnswered sevm b registry pausedData out ∧
+          32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 0 ∧ out.length < 2 ^ 255 ∧
+          Mem.Reads M' I' ∧ Mem.Wf M' ∧
+          I'.sliceD 64 32 0 = (bumpFp p out.length.toB256).toBytes) := by
+  have shanghai := fork.shanghaiOnwards
+  have keep64 : ∀ {M' : Mem}, KeepsTail M M' → (M'.read 64 32).1 = p.toBytes := fun k =>
+    (k 64 32 (by omega)).trans (by rw [reads.read]; exact ptr)
+  rw [paused_head_shape] at run
+  obtain ⟨_, run⟩ := rpw_dest run
+  obtain ⟨_, line, run⟩ := rpw_nexts project pausedHeadA run
+  obtain ⟨M1, G1, rfl, w1, k1⟩ := paused_headA_line onCode wf line
+  obtain ⟨d1, slstep, run⟩ := rpw_next run
+  have slrun := project slstep
+  obtain ⟨_, rfl⟩ := ri_sload shanghai slrun
+  obtain ⟨_, line, run⟩ := rpw_nexts project pausedHeadB run
+  obtain ⟨c2, M2, G2, rfl, w2, k2⟩ := paused_headB_line w1 line
+  have k12 : KeepsTail M M2 := fun j n hj => (k2 j n hj).trans (k1 j n hj)
+  rcases rpw_branch run with ⟨clear, _, run⟩ | ⟨set, _, run⟩
+  · -- the token flag is clear: the registry is asked
+    rw [paused_query_shape] at run
+    have reads2 := Mem.reads_data M2
+    have ptr2 : M2.data.toList.sliceD 64 32 0 = p.toBytes := by
+      rw [← reads2.read]; exact keep64 k12
+    obtain ⟨_, line, run⟩ := rpw_nexts project pausedQuery run
+    obtain ⟨gw, t, ii, is, os, e, s, u, M3, I3, G3, rfl, ht, rfl, rfl, rfl, r3, w3, p3, data⟩ :=
+      paused_query_line reads2 w2 ptr2 lo line
+    obtain ⟨d2, call, run⟩ := rpw_next run
+    obtain ⟨flag, out, post, bound, answered⟩ := ri_staticcall_bounded fork (project call)
+    have callStep := project call
+    rw [post.eq_St] at run callStep
+    obtain ⟨_, line, run⟩ := rpw_nexts project pausedFlag run
+    obtain ⟨_, rfl⟩ := paused_flag_line line
+    rcases rpw_branch run with ⟨_, _, dead⟩ | ⟨accepted, _, run⟩
+    · exact (rpw_dead rfl dead).elim
+    have flagOne : flag = 1 := by
+      rcases post.flag with zero | one
+      · subst zero
+        exact absurd (by decide : B256.eqCheck (B256.eqCheck (0 : B256) 0) 0 = 0) accepted
+      · exact one
+    have n4 : (4 : B256).toNat = 4 := by decide
+    have n32 : (32 : B256).toNat = 32 := by decide
+    have asked := answered flagOne
+    rw [ht, r3.read, n4, data] at asked
+    rw [paused_reply_shape] at run
+    obtain ⟨_, run⟩ := rpw_dest run
+    have r4 := (r3.extends [(ii.toNat, (4 : B256).toNat), (ii.toNat, (32 : B256).toNat)]).write
+      (Mem.Wf.extends _ w3) ii.toNat (out.take (32 : B256).toNat)
+    have w4 := Mem.Wf.write (Mem.Wf.extends [(ii.toNat, (4 : B256).toNat),
+      (ii.toNat, (32 : B256).toNat)] w3) ii.toNat (out.take (32 : B256).toNat)
+    have p4 : (Bytes.writeAt I3 ii.toNat (out.take (32 : B256).toNat)).sliceD 64 32 0 =
+        ii.toBytes := by
+      rw [Bytes.sliceD_writeAt_before _ _ _ _ _ (by omega), p3]
+    obtain ⟨_, line, run⟩ := rpw_nexts project _ run
+    obtain ⟨M5, I5, G5, rfl, r5, w5, keepReply, fp5⟩ := reply_line_at r4 w4 p4 lo line
+    rw [post.returnData] at run fp5
+    obtain ⟨_, D', callee, run⟩ :=
+      rpw_callOver (S' := [83, 18]) (g := t_29f1_c83) (by decide +kernel) rfl (by decide) run
+    obtain ⟨notShort, isBool, G6, rfl⟩ := decoder_returned_at project callee
+    obtain ⟨_, rfl⟩ := paused_tail project run
+    have long : 32 ≤ out.length := by
+      have := le_toNat_of_not_slt notShort
+      rwa [B256.toNat_toB256_of_lt bound] at this
+    have short : out.length < 2 ^ 255 := by
+      have := lt_of_not_slt notShort
+      rwa [B256.toNat_toB256_of_lt bound] at this
+    have takeLen : (out.take 32).length = 32 := by
+      rw [List.length_take]
+      omega
+    have back := Bytes.sliceD_writeAt I3 (out.take 32) ii.toNat
+    rw [takeLen] at back
+    have word : Bytes.toB256 (M5.read ii.toNat 32).1 = Bytes.toB256 (out.take 32) := by
+      rw [r5.read, keepReply, n32, back]
+    refine ⟨d2, _, _, _, rfl, fun zero => ⟨clear, ?_, out, _, ?_, long, ?_, short,
+      r5.extend _ _, Mem.Wf.extend w5 _ _, ?_⟩⟩
+    · exact .step rfl slrun (.step rfl callStep (.refl _))
+    · exact StaticAnswered.of_afterSload asked
+    · rw [← word]; exact zero
+    · exact fp5
+  · -- the token flag is set: it is returned
+    obtain ⟨_, rfl⟩ := paused_tail project run
+    exact ⟨_, _, _, _, rfl, fun zero => absurd zero set⟩
+
+end PausedRoutine
+
