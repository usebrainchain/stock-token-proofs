+/-- A word that is not below `32` as a signed number is below `2 ^ 255`. -/
+theorem lt_of_not_slt {x : B256} (h : ¬ B256.Slt x (Bytes.toB256 [0x20])) : x.toNat < 2 ^ 255 := by
+  have em : (B256.max >>> 1 : B256) = B256.low255 := rfl
+  unfold B256.Slt at h
+  rw [em] at h
+  cases ha : x.highBit
+  · have hand : x &&& B256.low255 = x := by
+      obtain ⟨⟨a, b⟩, ⟨c, d⟩⟩ := x
+      show ((a &&& 0x7fffffffffffffff, b &&& UInt64.max), (c &&& UInt64.max, d &&& UInt64.max)) = _
+      rw [UInt64.and_low63 a ha, UInt64.and_max_self, UInt64.and_max_self, UInt64.and_max_self]
+      rfl
+    have hl : B256.low255.toNat = 2 ^ 255 - 1 := by decide
+    have hle := Nat.and_le_right (n := x.toNat) (m := B256.low255.toNat)
+    rw [← B256.toNat_and, hand, hl] at hle
+    omega
+  · exfalso
+    apply h
+    left
+    rw [ha]
+    decide
+
+end QueryAt2
