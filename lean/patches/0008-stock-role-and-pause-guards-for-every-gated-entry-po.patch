+    Bytes.toB256 [0x5c, 0x97, 0x5a, 0xbb]) <<< (Bytes.toB256 [0xe0]).toNat).toBytes
+  have r1 := r0.write w0 p.toNat ((Bytes.toB256 [0xff, 0xff, 0xff, 0xff] &&&
+    Bytes.toB256 [0x5c, 0x97, 0x5a, 0xbb]) <<< (Bytes.toB256 [0xe0]).toNat).toBytes
