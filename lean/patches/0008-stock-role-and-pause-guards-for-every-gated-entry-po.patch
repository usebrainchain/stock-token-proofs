+import Blanc.Lift.Stock.Roles
+import Blanc.Lift.VyperArraySlot
+import Blanc.Lift.InvWalkLegacy
+
+/-!
+# Stock: registry queries past the first, and the `paused()` routine
+
+A frame's later queries find the free pointer past the earlier replies.  The lemmas here take
+the pointer `p` as a parameter with the facts the code needs of it: it lies above the
+free-pointer word (`96 ≤ p`) and the windows written from it do not wrap.
+
+Their worlds are no longer the frame's starting one: `QuietFrom` says how they are reached, by
+instructions that write no storage and emit no log (`Ninst.quiet`: register instructions other
+than `SSTORE` and `LOG`, and `STATICCALL`), each run from the previous world.
+-/
+
+namespace Blanc.Lift.Stock
+
+open Jaune Blanc Blanc.Lift
+
+/-! ## Worlds reached by quiet instructions -/
+
+/-- `e` is reached from `b` by quiet instructions (`Ninst.quiet`), each run over the previous
+world with some stack, memory and gas. -/
+inductive QuietFrom (sevm : Sevm) : Devm → Devm → Prop
+  | refl (b : Devm) : QuietFrom sevm b b
+  | step {b c e : Devm} {n : Ninst} {S S' : List B256} {M M' : Mem} {G G' : Nat}
+      (quiet : n.quiet = true) (run : Ninst.Run sevm (St b S M G) n (St c S' M' G'))
+      (rest : QuietFrom sevm c e) : QuietFrom sevm b e
+
+theorem St_St (b : Devm) (S S' : List B256) (M M' : Mem) (G G' : Nat) :
+    St (St b S M G) S' M' G' = St b S' M' G' := rfl
+
+theorem QuietFrom.trans {sevm : Sevm} {b c e : Devm} (h : QuietFrom sevm b c)
+    (h' : QuietFrom sevm c e) : QuietFrom sevm b e := by
+  induction h with
+  | refl => exact h'
+  | step quiet run _ ih => exact .step quiet run (ih h')
+
+/-- Quiet instructions keep every storage map (`Ninst.world_of_quiet`). -/
+theorem QuietFrom.getStor {sevm : Sevm} (fork : CoveredFork sevm.benvStat.fork) {b c : Devm}
+    (h : QuietFrom sevm b c) : Devm.getStor c = Devm.getStor b := by
+  induction h with
+  | refl => rfl
+  | step quiet run _ ih =>
+    rw [ih]
+    exact (Ninst.world_of_quiet fork.shanghaiOnwards quiet run).1
+
+/-- A static answer over a storage read's base is one over the base: `SLOAD` only warms a key. -/
+theorem StaticAnswered.of_afterSload {sevm : Sevm} {b : Devm} {k : B256} {t : Adr}
+    {input out : Bytes} (h : StaticAnswered sevm (afterSload sevm b k) t input out) :
+    StaticAnswered sevm b t input out := by
+  have hs : (afterSload sevm b k).state = b.state := by
+    unfold afterSload; split <;> rfl
+  have hc : ∀ a, (afterSload sevm b k).getCode a = b.getCode a := fun a => by
+    simp only [Devm.getCode, Devm.getAcct, hs]
+  unfold StaticAnswered at h ⊢
+  simp only [hc, hs] at h
+  exact h
+
+
+section LineWalk
+
+open _root_.Lean _root_.Lean.Elab _root_.Lean.Elab.Tactic _root_.Lean.Meta
+
+/-- One instruction of the line run `run` (see `stock_line`); `false` once it stops. -/
+def stockLineStepTac : TacticM Bool := withMainContext do withFreshMacroScope do
+  let ld ← getLocalDeclFromUserName `run
+  let ty := (← instantiateMVars ld.type).cleanupAnnotations
+  unless ty.isAppOfArity ``Blanc.Line.Run 4 do return false
+  let ns ← whnfD ty.getAppArgs[2]!
+  let some (n, _) := (match ns.getAppFnArgs with
+    | (``List.cons, #[_, n, t]) => some (n, t)
+    | _ => none) | return false
+  let run := mkIdent `run
+  let step := mkIdent `step
+  let rflPat := mkIdent `rfl
+  match ← stockInvLemma n with
+  | some lem =>
+    try
+      evalTactic (← `(tactic| (obtain ⟨_, $step:ident, $run:ident⟩ := Line.of_run_cons $run; obtain ⟨_, $rflPat:ident⟩ := $lem $step; clear $step)))
+      return true
+    catch _ => return false
+  | none =>
+    evalTactic (← `(tactic| obtain ⟨_, $step:ident, $run:ident⟩ := Line.of_run_cons $run))
+    return false
+
+/-- **Invert the line run `run`** over its straight-line instructions; at the first instruction it
+does not take, that step is left as `step` and the rest as `run`. -/
+syntax (name := stockLineStx) "stock_line" : tactic
+
+@[tactic stockLineStx] def evalStockLine : Tactic := fun _ => do
+  let mut i := 0
+  while i < 100000 do
+    unless ← stockLineStepTac do break
+    i := i + 1
+
+/-- One node of the source run `run` (see `stock_run`); `false` at a node it does not take. -/
+def stockRunStepTac : TacticM Bool := withMainContext do withFreshMacroScope do
+  let ld ← getLocalDeclFromUserName `run
+  let ty := (← instantiateMVars ld.type).cleanupAnnotations
+  unless ty.isAppOfArity ``Blanc.Lift.SFunc.RunP 6 do return false
+  let f ← whnfD ty.getAppArgs[4]!
+  let run := mkIdent `run
+  let project := mkIdent `project
+  let guard := mkIdent `guard
+  let step := mkIdent `step
+  let rflPat := mkIdent `rfl
+  let tryTac (stx : TSyntax `tactic) : TacticM Bool := do
+    try withoutRecover (evalTactic stx); return true catch _ => return false
+  match f.getAppFnArgs with
+  | (``Blanc.Lift.SFunc.dest, _) =>
+    tryTac (← `(tactic| (replace $run:ident := rpw_dest $run; obtain ⟨_, $run:ident⟩ := $run)))
+  | (``Blanc.Lift.SFunc.next, #[n, _]) =>
+    let some lem ← stockInvLemma n | return false
+    tryTac (← `(tactic| (replace $run:ident := rpw_next $run; obtain ⟨_, $step:ident, $run:ident⟩ := $run; obtain ⟨_, $rflPat:ident⟩ := $lem ($project $step); clear $step)))
+  | (``Blanc.Lift.SFunc.branch, _) =>
+    let left ← `((rpw_branch $run).resolve_left (fun ⟨_, _, dead⟩ => rpw_dead rfl dead))
+    if ← tryTac (← `(tactic| (replace $run:ident := $left; obtain ⟨$guard:ident, _, $run:ident⟩ := $run))) then
+      return true
+    let right ← `((rpw_branch $run).resolve_right (fun ⟨_, _, dead⟩ => rpw_dead rfl dead))
+    tryTac (← `(tactic| (replace $run:ident := $right; obtain ⟨$guard:ident, _, $run:ident⟩ := $run)))
+  | _ => return false
+
+/-- **Walk the source run `run`** over `JUMPDEST`s, straight-line instructions and `JUMPI`s whose
+one side cannot succeed (the surviving side's condition kept as `guard`), stopping at the first
+other node.  Needs `project` (the step relation's projection to `Ninst.Run`) in scope. -/
+syntax (name := stockRunStx) "stock_run" : tactic
+
+@[tactic stockRunStx] def evalStockRun : Tactic := fun _ => do
+  let mut i := 0
+  while i < 100000 do
+    unless ← stockRunStepTac do break
+    i := i + 1
+
+end LineWalk
+
+/-! ## Word facts -/
+
+theorem add_sub_cancel_right' (a x : B256) : (x + a) - a = x := by
+  apply B256.toNat_inj
+  have ha := B256.toNat_lt a
+  have hx := B256.toNat_lt x
+  rw [B256.toNat_sub, B256.toNat_add, Nat.lo_eq, Nat.lo_eq]
+  generalize a.toNat = m at *
+  generalize x.toNat = n at *
+  simp only [Nat.reducePow] at *
+  omega
+
+theorem toNat_add_of_lt {a x : B256} (h : a.toNat + x.toNat < 2 ^ 256) :
+    (a + x).toNat = a.toNat + x.toNat := by
+  rw [B256.toNat_add, Nat.lo_eq]
+  exact Nat.mod_eq_of_lt h
+
+/-- The free pointer after a reply of `n` bytes at `p`: `p + ((n + 31) & ~31)`. -/
+def bumpFp (p n : B256) : B256 :=
+  p + ((n + Bytes.toB256 [0x1f]) &&& ~~~ (Bytes.toB256 [0x1f]))
+
+theorem bumpFp_bounds {p n : B256} (h : p.toNat + n.toNat + 31 < 2 ^ 256) :
+    p.toNat ≤ (bumpFp p n).toNat ∧ (bumpFp p n).toNat ≤ p.toNat + n.toNat + 31 := by
+  have h31 : (Bytes.toB256 [0x1f]).toNat = 31 := by decide
+  have hsum : (n + Bytes.toB256 [0x1f]).toNat = n.toNat + 31 := by
+    rw [toNat_add_of_lt (by rw [h31]; omega), h31]
+  have hand : ((n + Bytes.toB256 [0x1f]) &&& ~~~ (Bytes.toB256 [0x1f])).toNat ≤
+      (n + Bytes.toB256 [0x1f]).toNat := by
+    rw [B256.toNat_and]
+    exact Nat.and_le_left
+  unfold bumpFp
+  rw [toNat_add_of_lt (by omega)]
+  omega
+
+/-! ## The `hasRole` query of `_checkRole(role, account)` (entry 119) at a free pointer `p` -/
