+      I'.sliceD 64 32 0 = (bumpFp p b.returnData.length.toB256).toBytes := by
+  have n40 : (Bytes.toB256 [0x40]).toNat = 64 := by decide
+  have r64 : (M.read (Bytes.toB256 [0x40]).toNat 32).1 = p.toBytes := by
+    rw [reads.read, n40]
+    exact ptr
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
+  obtain ⟨_, rfl⟩ := ri_pop step
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
+  obtain ⟨_, rfl⟩ := ri_pop step
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
+  obtain ⟨_, rfl⟩ := ri_pop step
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
+  obtain ⟨_, rfl⟩ := ri_pop step
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
+  obtain ⟨_, rfl⟩ := ri_push step
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
+  obtain ⟨_, rfl⟩ := ri_mload step
+  rw [r64, B256.toB256_toBytes] at run
+  stock_line
+  cases run
+  have w1 : Mem.Wf (M.read (Bytes.toB256 [0x40]).toNat 32).2 := Mem.Wf.extend wf _ _
+  have r1 : Mem.Reads (M.read (Bytes.toB256 [0x40]).toNat 32).2 I := reads.extend _ _
+  refine ⟨_, _, _, rfl, r1.write w1 _ _, Mem.Wf.write w1 _ _, ?_, ?_⟩
