+theorem read_write_32' (μ : Mem) (n : Nat) {ys : Bytes} (h : ys.length = 32) :
+    ((μ.write n ys).read n 32).1 = ys := by
+  rw [← Bytes.toBytes_toB256_of_length h]
+  exact Mem.read_write_word_self μ n _
+
+/-- Memory that agrees with `M` past the first word. -/
+def KeepsTail (M M' : Mem) : Prop := ∀ j n, 32 ≤ j → (M'.read j n).1 = (M.read j n).1
+
+theorem KeepsTail.extend {M M' : Mem} (h : KeepsTail M M') (a m : Nat) :
+    KeepsTail M (M'.read a m).2 := fun j n hj => (memRead_snd_fst M' a m j n).trans (h j n hj)
+
+theorem KeepsTail.write {M M' : Mem} (h : KeepsTail M M') (wf : Mem.Wf M') {xs : Bytes}
+    (len : xs.length = 32) : KeepsTail M (M'.write 0 xs) := fun j n hj =>
+  (Mem.read_write_disjoint wf 0 xs (Or.inl (by omega))).trans (h j n hj)
+
+/-- One scratch-word access at `0`: a load, then a 32-byte store. -/
+theorem scratch_step {M X : Mem} (h : Mem.Wf X ∧ KeepsTail M X) {xs : Bytes} (len : xs.length = 32) :
+    Mem.Wf ((X.read 0 32).2.write 0 xs) ∧ KeepsTail M ((X.read 0 32).2.write 0 xs) :=
+  ⟨Mem.Wf.write (Mem.Wf.read_snd h.1 0 32) 0 xs,
+    KeepsTail.write (KeepsTail.extend h.2 0 32) (Mem.Wf.read_snd h.1 0 32) len⟩
+
+theorem paused_headA_line {b d : Devm} {r : B256} {S : List B256} {M : Mem} {G : Nat}
+    (onCode : sevm.code = code) (wf : Mem.Wf M)
+    (run : Line.Run sevm (St b (r :: S) M G) pausedHeadA d) :
+    ∃ (M' : Mem) (G' : Nat), d = St b (pausedSlot :: r :: S) M' G' ∧ Mem.Wf M' ∧ KeepsTail M M' := by
+  stock_line
+  cases run
+  have z : (Bytes.toB256 []).toNat = 0 := by decide
+  have n20 : (Bytes.toB256 [0x20]).toNat = 32 := by decide
+  have n2d09 : (Bytes.toB256 [0x2d, 0x09]).toNat = 11529 := by decide
+  simp only [z, n20, n2d09, onCode]
+  rw [read_write_32' _ _ (ByteArray.length_sliceD _ _ _ _), slot_word]
+  exact ⟨_, _, rfl, scratch_step (scratch_step ⟨wf, fun _ _ _ => rfl⟩
+    (ByteArray.length_sliceD _ _ _ _)) (B256.length_toBytes _)⟩
