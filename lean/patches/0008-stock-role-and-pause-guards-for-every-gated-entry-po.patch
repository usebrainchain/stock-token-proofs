+
+theorem paused_tail_line {b d : Devm} {w c2 z r : B256} {S : List B256} {M : Mem} {G : Nat}
+    (run : Line.Run sevm (St b (w :: c2 :: z :: r :: S) M G) pausedTail d) :
+    ∃ G', d = St b (r :: w :: S) M G' := by
+  stock_line
+  cases run
