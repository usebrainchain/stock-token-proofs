+theorem paused_headB_line {b d : Devm} {v r : B256} {S : List B256} {M : Mem} {G : Nat}
+    (wf : Mem.Wf M) (run : Line.Run sevm (St b (v :: r :: S) M G) pausedHeadB d) :
+    ∃ (c2 : B256) (M' : Mem) (G' : Nat),
+      d = St b (Bytes.toB256 [0x0e, 0x71] :: (Bytes.toB256 [0xff] &&& v) ::
+        (Bytes.toB256 [0xff] &&& v) :: c2 :: Bytes.toB256 [] :: r :: S) M' G' ∧
+      Mem.Wf M' ∧ KeepsTail M M' := by
+  stock_line
+  cases run
+  have z : (Bytes.toB256 []).toNat = 0 := by decide
+  simp only [z]
+  exact ⟨_, _, _, rfl, scratch_step (scratch_step ⟨wf, fun _ _ _ => rfl⟩
+    (ByteArray.length_sliceD _ _ _ _)) (B256.length_toBytes _)⟩
