+/-- Property 3's claim when the `paused()` query is not the frame's first: the token's flag clear
+in the frame's starting storage, and the registry answered `paused()` with `0` over a world
+reached quietly from the frame's starting one. -/
+abbrev UnpausedAnsweredAfter (F : Exec.Deriv) : Prop :=
+  tokenFlag F.sevm F.devm = 0 ∧
+  ∃ (b' : Devm) (out : Bytes), QuietFrom F.sevm F.devm b' ∧
+    StaticAnswered F.sevm b' registry pausedData out ∧
+    32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 0
+
+/-- After `onlyRole` (a call into entry 88 with the free pointer at `0x80`), a function body
+whose next step is the `paused()` routine and its guard: the paused claim, over the world after
+the role query. -/
+theorem paused_after_role {F : Exec.Deriv} {post : Devm} {g dead : SFunc} {t R c : B256}
+    {S : List B256} {K : List SFunc} {lab lab2 : Bytes} {le : lab.length ≤ 32}
+    {le2 : lab2.length ≤ 32}
+    (cut : CursorStateAt code cert F (.callNext 88 (.dest (.next (.push lab le)
+      (.next (.push [0x0d, 0xc8] (by decide)) (.callNext 58 (.dest (.next (.reg .iszero)
+        (.next (.push lab2 le2) (.branch dead g))))))))) F.devm (t :: R :: c :: S) freeMem K)
+    (deadOk : dead.noOk = true)
+    (success : F.exn = .ok post) (fork : CoveredFork F.sevm.benvStat.fork)
+    (onCode : F.sevm.code = code) :
+    UnpausedAnsweredAfter F := by
+  have hsg := fork.histFork.neutral.stateGas
+  obtain ⟨G, state⟩ := cut.state
+  obtain ⟨outcome, run⟩ := cut.placed.sourceRunH cert_check (cut.exn_eq.trans success)
+    (by rw [cut.sevm_eq]; exact hsg)
+  rw [cut.tree, state, cut.sevm_eq] at run
+  have project : ∀ {s d i d'}, StepIn cut.node s d i d' → Ninst.Run s d i d' :=
+    fun h => StepIn.toRun h
+  have reads : Mem.Reads freeMem (Bytes.writeAt [] 64 (128 : B256).toBytes) :=
+    Mem.reads_empty.write Mem.wf_empty 64 _
+  have wf : Mem.Wf freeMem := Mem.Wf.write Mem.wf_empty 64 _
+  have ptr : (Bytes.writeAt [] 64 (128 : B256).toBytes).sliceD 64 32 0 = (128 : B256).toBytes := by
+    decide
+  obtain ⟨_, D, callee, run⟩ := rpw_callOver (S' := [88, 119, 120, 83, 18, 9]) (g := t_1954_c88)
+    (by decide +kernel) rfl (by decide) run
+  obtain ⟨d, out, M', I', G', rfl, quiet, _, _, _, short, r', w', fp⟩ :=
+    role_check_returned project fork reads wf ptr (by decide) (by decide) callee
+  stock_run
+  obtain ⟨_, D2, callee2, run⟩ := rpw_callOver (S' := [58, 83, 18]) (g := t_0dc8_c58)
+    (by decide +kernel) rfl (by decide) run
+  have bounds := bumpFp_bounds (p := 128) (n := out.length.toB256)
+    (by rw [show (128 : B256).toNat = 128 by decide, B256.toNat_toB256_of_lt (by omega)]; omega)
+  rw [show (128 : B256).toNat = 128 by decide] at bounds
+  obtain ⟨b'', w, M'', G'', rfl, facts⟩ :=
+    paused_returned project fork onCode r' w' fp (by omega) callee2
+  stock_run
+  obtain ⟨guard, _, run⟩ := (rpw_branch run).resolve_left (fun ⟨_, _, d⟩ => rpw_dead deadOk d)
+  obtain ⟨flagClear, _, out2, _, answered, long, word, _⟩ :=
+    facts (B256.eqCheck_ne_zero_iff.mp guard)
+  refine ⟨?_, d, out2, quiet, answered, long, word⟩
+  rw [← flagClear]
+  exact (tokenFlag_of_stor (quiet.getStor fork)).symm
+
+/-- **`mint(address,uint256)` runs only unpaused** (checked after its role). -/
