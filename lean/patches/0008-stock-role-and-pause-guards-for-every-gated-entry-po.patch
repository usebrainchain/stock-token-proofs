+theorem reply_line_at {lab : Bytes} {le : lab.length ≤ 32} {b d : Devm} {p e x1 x2 x3 : B256}
+    {S : List B256} {M : Mem} {G : Nat} {I : Bytes}
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = p.toBytes)
+    (lo : 96 ≤ p.toNat)
+    (run : Line.Run sevm (St b (e :: x1 :: x2 :: x3 :: S) M G) (replyLineAt lab le) d) :
+    ∃ (M' : Mem) (I' : Bytes) (G' : Nat),
+      d = St b (Bytes.toB256 [0x29, 0xf1] :: p :: (p + b.returnData.length.toB256) ::
+        Bytes.toB256 lab :: S) M' G' ∧
