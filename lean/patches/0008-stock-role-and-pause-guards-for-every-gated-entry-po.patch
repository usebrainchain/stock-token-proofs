+/-! ## Cursor cuts and the walk tactic -/
+
+section Cuts
+
+variable {code : ByteArray} {c : Cert} {F : Exec.Deriv} {b : Devm} {S : List B256} {M : Mem}
+  {K : List SFunc} {post : Devm}
+
+/-- One straight-line instruction; its successor state is what `inverse` says. -/
+theorem CursorStateAt.stepH {n : Ninst} {tail : SFunc} {b' : Devm} {S' : List B256} {M' : Mem}
+    (cut : CursorStateAt code c F (.next n tail) b S M K) (checked : Cert.check code c = true)
+    (success : F.exn = .ok post) (hsg : F.sevm.benvStat.rules.stateGas = none)
+    (nonexec : ∀ x : Xinst, n ≠ .exec x)
+    (inverse : ∀ {G d}, Ninst.Run F.sevm (St b S M G) n d → ∃ G', d = St b' S' M' G') :
+    Nonempty (CursorStateAt code c F tail b' S' M' K) :=
+  cut.lineH checked success hsg [n] rfl
+    (by intro m hm x; rw [List.mem_singleton] at hm; subst hm; exact nonexec x)
+    (fun run => by
+      obtain ⟨_, step, run⟩ := Line.of_run_cons run
+      cases run
+      exact inverse step)
+
+end Cuts
+
+section Walk
+
+open _root_.Lean _root_.Lean.Elab _root_.Lean.Elab.Tactic _root_.Lean.Meta
+
+/-- The inversion lemma for a straight-line instruction, as `WalkInvKit` picks it, plus `SLT`
+with its value (`ri_slt_val`). -/
+def stockInvLemma (n : Expr) : MetaM (Option (TSyntax `term)) := do
+  let n ← whnfR n
+  if let (``Jaune.Ninst.reg, #[r]) := n.getAppFnArgs then
+    let r ← whnfR r
+    if r.isConstOf ``Jaune.Rinst.slt then
+      return some (← `(ri_slt_val))
+    if r.isConstOf ``Jaune.Rinst.codecopy then
+      return some (← `(ri_codecopy))
+    if r.isConstOf ``Jaune.Rinst.sload then
+      return some (← `(ri_sload $(mkIdent `shanghai)))
+  WalkKit.invStep n
+
+/-- One node of the cursor `cut` (see `stock_walk`); `false` at a node it does not take. -/
+def stockStepTac (stops : List Nat) : TacticM Bool := withMainContext do withFreshMacroScope do
+  let ld ← getLocalDeclFromUserName `cut
+  let ty := (← instantiateMVars ld.type).cleanupAnnotations
+  unless ty.isAppOfArity ``Blanc.Lift.CursorStateAt 8 do return false
+  let f ← whnfD ty.getAppArgs[3]!
+  let cut := mkIdent `cut
+  let success := mkIdent `success
+  let hsg := mkIdent `hsg
+  let neutral := mkIdent `neutral
+  let run (stx : TSyntax `tactic) : TacticM Bool := do
+    try evalTactic stx; return true catch _ => return false
+  match f.getAppFnArgs with
+  | (``Blanc.Lift.SFunc.dest, _) =>
+    run (← `(tactic| (replace $cut:ident := CursorStateAt.destH $cut cert_check $success $hsg; obtain ⟨$cut⟩ := $cut)))
+  | (``Blanc.Lift.SFunc.next, #[n, _]) =>
+    let some lem ← stockInvLemma n | return false
+    let r := mkIdent `r
+    let rflPat := mkIdent `rfl
+    let inv ← `(fun $r => by obtain ⟨_, $rflPat:ident⟩ := $lem $r; (try dsimp only [List.set, Fin.isValue, Fin.val_zero, Fin.val_one, Fin.val_two]); exact ⟨_, rfl⟩)
+    run (← `(tactic| (replace $cut:ident := CursorStateAt.stepH $cut cert_check $success $hsg (fun _ h => nomatch h) $inv; obtain ⟨$cut⟩ := $cut)))
+  | (``Blanc.Lift.SFunc.branch, _) =>
+    let succ ← `((SolcSignedQuery.guardSucc $cut cert_check rfl $success $neutral).2)
+    if ← run (← `(tactic| (replace $cut:ident := $succ; obtain ⟨$cut⟩ := $cut))) then return true
+    let zero ← `((SolcSignedQuery.guardZero $cut cert_check rfl $success $neutral).2)
+    run (← `(tactic| (replace $cut:ident := $zero; obtain ⟨$cut⟩ := $cut)))
+  | (``Blanc.Lift.SFunc.ret, _) =>
+    run (← `(tactic| (replace $cut:ident := CursorStateAt.retH $cut cert_check $success $hsg; obtain ⟨$cut⟩ := $cut)))
+  | (``Blanc.Lift.SFunc.callNext, #[k, _]) =>
+    let some k := (← whnf k).rawNatLit? | return false
+    if stops.contains k then return false
+    run (← `(tactic| (replace $cut:ident := CursorStateAt.callH $cut cert_check $success $hsg rfl; obtain ⟨$cut⟩ := $cut)))
+  | (``Blanc.Lift.SFunc.jump, _) =>
+    run (← `(tactic| (replace $cut:ident := CursorStateAt.gotoH $cut cert_check $success $hsg rfl; obtain ⟨$cut⟩ := $cut)))
+  | _ => return false
+
+/-- **Walk the cursor `cut`** over `JUMPDEST`s, straight-line instructions, `JUMPI`s whose one side
+cannot succeed, internal calls into entries outside `stops`, returns and jumps, stopping at the
+first other node (an external call, a branch both of whose sides can succeed, a leaf) or at a call
+into a listed entry.  Needs `cert_check`, `success`, `hsg` and `neutral` in scope. -/
+syntax (name := stockWalkStx) "stock_walk" (ppSpace "[" num,* "]")? : tactic
+
+@[tactic stockWalkStx] def evalStockWalk : Tactic := fun stx => do
+  let stops : List Nat :=
+    if stx[1].isNone then [] else (stx[1][1].getSepArgs.toList.filterMap (·.isNatLit?))
+  let mut i := 0
+  while i < 100000 do
+    unless ← stockStepTac stops do break
+    i := i + 1
+
+end Walk
+
+/-! ## From the call into `_checkRole(role)` to the registry's answer -/
+
+/-- At a call into `_checkRole(role)` (entry 88) with `role` under the jump word and the free
+pointer at `0x80`, a successful frame asked the registry `hasRole(role, caller)` from its starting
+world and was answered with a first word `1`. -/
+theorem role_answered {F : Exec.Deriv} {post : Devm} {f : SFunc} {t R : B256} {S : List B256}
+    {K : List SFunc}
+    (cut : CursorStateAt code cert F (.callNext 88 f) F.devm (t :: R :: S) freeMem K)
+    (success : F.exn = .ok post) (fork : CoveredFork F.sevm.benvStat.fork) :
+    ∃ out : Bytes,
+      StaticAnswered F.sevm F.devm registry (hasRoleData R F.sevm.caller) out ∧
+      32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 1 := by
+  have neutral := fork.histFork.neutral
+  have hsg := neutral.stateGas
+  obtain ⟨cut⟩ := cut.callH (g := t_1954_c88) cert_check success hsg rfl
+  stock_walk [119]
+  obtain ⟨cut⟩ := cut.callH (g := t_1e60_c119) cert_check success hsg rfl
+  obtain ⟨G, state⟩ := cut.state
+  obtain ⟨outcome, run⟩ := cut.placed.sourceRunH cert_check (cut.exn_eq.trans success)
+    (by rw [cut.sevm_eq]; exact hsg)
+  rw [cut.tree, state, cut.sevm_eq] at run
+  have reads : Mem.Reads freeMem (Bytes.writeAt [] 64 (128 : B256).toBytes) :=
+    Mem.reads_empty.write Mem.wf_empty 64 _
+  have wf : Mem.Wf freeMem := Mem.Wf.write Mem.wf_empty 64 _
+  have ptr : (Bytes.writeAt [] 64 (128 : B256).toBytes).sliceD 64 32 0 = (128 : B256).toBytes := by
+    decide
+  obtain ⟨out, answered, long, one⟩ :=
+    query_answered (fun h => StepIn.toRun h) fork reads wf ptr run
+  exact ⟨out, by simpa only [hasRoleData, toAdr_toB256] using answered, long, one⟩
+
+/-! ## The role words as pushed -/
