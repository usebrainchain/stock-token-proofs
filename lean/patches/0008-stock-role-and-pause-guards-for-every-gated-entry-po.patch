+section QueryAt
+
+variable {sevm : Sevm}
+
+/-- The memory `queryLine` leaves before its final `MLOAD`, from the free pointer `p`. -/
+def queryMemAt (M : Mem) (p A R : B256) : Mem :=
+  (((M.read (Bytes.toB256 [0x40]).toNat 32).2.write p.toNat
+    (Bytes.toB256 [0x24, 0x74, 0x52, 0x15] <<< (Bytes.toB256 [0xe2]).toNat).toBytes).write
+    (p + Bytes.toB256 [0x04]).toNat R.toBytes).write
+    (p + Bytes.toB256 [0x24]).toNat
+    (((Bytes.toB256 [0x01] <<< (Bytes.toB256 [0xa0]).toNat) - Bytes.toB256 [0x01]) &&& A).toBytes
+
+theorem query_memory_at {M : Mem} {I : Bytes} {p A R : B256}
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = p.toBytes)
+    (lo : 96 ≤ p.toNat) (hi : p.toNat + 68 < 2 ^ 256) :
+    ∃ I3 : Bytes, Mem.Reads (queryMemAt M p A R) I3 ∧ Mem.Wf (queryMemAt M p A R) ∧
+      I3.sliceD 64 32 0 = p.toBytes ∧
+      I3.sliceD p.toNat 68 0 = [0x91, 0xd1, 0x48, 0x54] ++ R.toBytes ++ A.toAdr.toB256.toBytes := by
+  have w0 : Mem.Wf (M.read (Bytes.toB256 [0x40]).toNat 32).2 := Mem.Wf.extend wf _ _
+  have r0 : Mem.Reads (M.read (Bytes.toB256 [0x40]).toNat 32).2 I := reads.extend _ _
+  have w1 := Mem.Wf.write w0 p.toNat
+    (Bytes.toB256 [0x24, 0x74, 0x52, 0x15] <<< (Bytes.toB256 [0xe2]).toNat).toBytes
+  have r1 := r0.write w0 p.toNat
+    (Bytes.toB256 [0x24, 0x74, 0x52, 0x15] <<< (Bytes.toB256 [0xe2]).toNat).toBytes
+  have w2 := Mem.Wf.write w1 (p + Bytes.toB256 [0x04]).toNat R.toBytes
+  have r2 := r1.write w1 (p + Bytes.toB256 [0x04]).toNat R.toBytes
+  have w3 := Mem.Wf.write w2 (p + Bytes.toB256 [0x24]).toNat
+    (((Bytes.toB256 [0x01] <<< (Bytes.toB256 [0xa0]).toNat) - Bytes.toB256 [0x01]) &&& A).toBytes
+  have r3 := r2.write w2 (p + Bytes.toB256 [0x24]).toNat
+    (((Bytes.toB256 [0x01] <<< (Bytes.toB256 [0xa0]).toNat) - Bytes.toB256 [0x01]) &&& A).toBytes
+  have n4 : (p + Bytes.toB256 [0x04]).toNat = p.toNat + 4 := by
+    rw [toNat_add_of_lt (by rw [show (Bytes.toB256 [0x04]).toNat = 4 by decide]; omega)]
+    rfl
+  have n24 : (p + Bytes.toB256 [0x24]).toNat = p.toNat + 36 := by
+    rw [toNat_add_of_lt (by rw [show (Bytes.toB256 [0x24]).toNat = 36 by decide]; omega)]
+    rfl
+  refine ⟨_, r3, w3, ?_, ?_⟩
+  · rw [n4, n24, Bytes.sliceD_writeAt_before _ _ _ _ _ (by omega),
+      Bytes.sliceD_writeAt_before _ _ _ _ _ (by omega),
+      Bytes.sliceD_writeAt_before _ _ _ _ _ (by omega), ptr]
+  · rw [n4, n24, show (68 : Nat) = 4 + (32 + 32) from rfl, List.sliceD_split,
+      List.sliceD_split]
+    have back2 := Bytes.sliceD_writeAt
+      (Bytes.writeAt I p.toNat (Bytes.toB256 [0x24, 0x74, 0x52, 0x15] <<<
+        (Bytes.toB256 [0xe2]).toNat).toBytes) R.toBytes (p.toNat + 4)
+    have back3 := Bytes.sliceD_writeAt
+      (Bytes.writeAt (Bytes.writeAt I p.toNat (Bytes.toB256 [0x24, 0x74, 0x52, 0x15] <<<
+        (Bytes.toB256 [0xe2]).toNat).toBytes) (p.toNat + 4) R.toBytes) (((Bytes.toB256 [0x01] <<<
+        (Bytes.toB256 [0xa0]).toNat) - Bytes.toB256 [0x01]) &&& A).toBytes (p.toNat + 36)
+    rw [B256.length_toBytes] at back2 back3
+    rw [Bytes.sliceD_writeAt_before _ _ p.toNat 4 (p.toNat + 36) (by omega),
+      Bytes.sliceD_writeAt_before _ _ p.toNat 4 (p.toNat + 4) (by omega),
+      Bytes.sliceD_writeAt_inside _ _ p.toNat p.toNat 4 (by omega)
+        (by rw [B256.length_toBytes]; omega),
+      Nat.sub_self, selector_word,
+      Bytes.sliceD_writeAt_before _ _ (p.toNat + 4) 32 (p.toNat + 36) (by omega),
+      show p.toNat + 4 + 32 = p.toNat + 36 by omega, back2, back3,
+      mask_eq, B256.and_comm, and_mask_word, List.append_assoc]
+
+theorem query_line_at {b d : Devm} {p A R : B256} {S : List B256} {M : Mem} {G : Nat} {I : Bytes}
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = p.toBytes)
+    (lo : 96 ≤ p.toNat) (hi : p.toNat + 68 < 2 ^ 256)
+    (run : Line.Run sevm (St b (A :: R :: S) M G) queryLine d) :
+    ∃ (gw t ii is os e s : B256) (M' : Mem) (I' : Bytes) (G' : Nat),
+      d = St b (gw :: t :: ii :: is :: ii :: os :: e :: s :: t :: A :: R :: S) M' G' ∧
+      t.toAdr = registry ∧ ii = p ∧ is = 68 ∧ os = 32 ∧
+      Mem.Reads M' I' ∧ Mem.Wf M' ∧ I'.sliceD 64 32 0 = p.toBytes ∧
+      I'.sliceD p.toNat 68 0 = [0x91, 0xd1, 0x48, 0x54] ++ R.toBytes ++ A.toAdr.toB256.toBytes := by
+  have n40 : (Bytes.toB256 [0x40]).toNat = 64 := by decide
+  have r64 : (M.read (Bytes.toB256 [0x40]).toNat 32).1 = p.toBytes := by
+    rw [reads.read, n40]
+    exact ptr
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
+  obtain ⟨_, rfl⟩ := ri_push step
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
+  obtain ⟨_, rfl⟩ := ri_mload step
+  rw [r64, B256.toB256_toBytes] at run
+  stock_line
+  obtain ⟨gw, _, rfl⟩ := ri_gas step
+  cases run
+  obtain ⟨I3, r3, w3, p3, d3⟩ := query_memory_at (A := A) (R := R) reads wf ptr lo hi
+  have fp : Bytes.toB256 ((queryMemAt M p A R).read (Bytes.toB256 [0x40]).toNat 32).1 = p := by
+    rw [r3.read, n40, p3, B256.toB256_toBytes]
+  refine ⟨gw, _, _, _, _, _, _, _, I3, _, rfl, ?_, fp, ?_, by decide, r3.extend _ _,
+    Mem.Wf.extend w3 _ _, p3, d3⟩
+  · rw [mask_eq]
+    exact registry_word
+  · exact (congrArg (fun z => (Bytes.toB256 [0x44] + p) - z) fp).trans
+      ((add_sub_cancel_right' p _).trans (by decide))
+
+end QueryAt
