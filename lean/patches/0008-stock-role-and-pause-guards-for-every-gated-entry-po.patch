+  have r64 : (M.read (Bytes.toB256 [0x40]).toNat 32).1 = p.toBytes := by
+    rw [reads.read, n40]
+    exact ptr
+  have p64 : Bytes.toB256 (M.read (Bytes.toB256 [0x40]).toNat 32).1 = p := by
+    rw [r64, B256.toB256_toBytes]
