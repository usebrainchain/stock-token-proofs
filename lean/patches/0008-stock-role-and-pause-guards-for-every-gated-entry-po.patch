+theorem paused_query_line {b d : Devm} {p x c2 z r : B256} {S : List B256} {M : Mem} {G : Nat}
+    {I : Bytes} (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = p.toBytes)
+    (lo : 96 ≤ p.toNat)
+    (run : Line.Run sevm (St b (x :: c2 :: z :: r :: S) M G) pausedQuery d) :
+    ∃ (gw t ii is os e s u : B256) (M' : Mem) (I' : Bytes) (G' : Nat),
