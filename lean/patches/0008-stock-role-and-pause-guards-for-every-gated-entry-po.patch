+/-- A returning run of entry 119 from the free pointer `p`: the registry answered `1`, and the
+routine returns over the post-call world with the free pointer moved past the reply. -/
+theorem query119_returned_at {P : Sevm → Devm → Ninst → Devm → Prop}
+    (project : ∀ {s d i d'}, P s d i d' → Ninst.Run s d i d')
+    {b D : Devm} {p A R ret : B256} {S : List B256} {M : Mem} {I : Bytes} {G : Nat}
+    (fork : CoveredFork sevm.benvStat.fork)
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = p.toBytes)
+    (lo : 96 ≤ p.toNat) (hi : p.toNat + 68 < 2 ^ 256)
+    (run : SFunc.RunP P cert.prog sevm (St b (A :: R :: ret :: S) M G) t_1e60_c119
+      (.returned D)) :
+    ∃ (d : Devm) (out : Bytes) (M' : Mem) (I' : Bytes) (G' : Nat), D = St d S M' G' ∧
+      QuietFrom sevm b d ∧
+      StaticAnswered sevm b registry
+        ([0x91, 0xd1, 0x48, 0x54] ++ R.toBytes ++ A.toAdr.toB256.toBytes) out ∧
+      32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 1 ∧ out.length < 2 ^ 255 ∧
+      Mem.Reads M' I' ∧ Mem.Wf M' ∧
+      I'.sliceD 64 32 0 = (bumpFp p out.length.toB256).toBytes := by
+  obtain ⟨out, d, _, _, _, _, M3, I3, _, asked, bound, returned, quiet, r3, w3, p3, reply, run⟩ :=
+    query_called_at project fork reads wf ptr lo hi run
+  rw [reply_shape_at] at run
+  obtain ⟨_, run⟩ := rpw_dest run
+  obtain ⟨_, line, run⟩ := rpw_nexts project _ run
+  obtain ⟨M4, I4, G4, rfl, r4, w4, keep4, fp4⟩ := reply_line_at r3 w3 p3 lo line
+  rw [returned] at run fp4
+  obtain ⟨_, D', callee, run⟩ :=
+    rpw_callOver (S' := [83, 18]) (g := t_29f1_c83) (by decide +kernel) rfl (by decide) run
+  obtain ⟨notShort, isBool, G5, rfl⟩ := decoder_returned_at project callee
+  rw [verdict_shape] at run
+  obtain ⟨_, run⟩ := rpw_dest run
+  obtain ⟨_, step, run⟩ := rpw_next run
+  obtain ⟨_, rfl⟩ := ri_push (project step)
+  rcases rpw_branchTo run with ⟨_, _, rejected⟩ | ⟨granted, g, _, entry9, run⟩
+  · exact (rpw_jumpsDead rejected (by decide +kernel)).elim
+  rw [show cert.prog[9]? = some t_0ed0_c9 from rfl] at entry9
+  cases entry9
+  rw [entry9_shape] at run
+  obtain ⟨_, run⟩ := rpw_dest run
+  obtain ⟨_, step, run⟩ := rpw_next run
+  obtain ⟨_, rfl⟩ := ri_pop (project step)
+  obtain ⟨_, step, run⟩ := rpw_next run
+  obtain ⟨_, rfl⟩ := ri_pop (project step)
+  obtain ⟨_, rfl⟩ := rpw_ret run
+  have long : 32 ≤ out.length := by
+    have := le_toNat_of_not_slt notShort
+    rwa [B256.toNat_toB256_of_lt bound] at this
+  have short : out.length < 2 ^ 255 := by
+    have := lt_of_not_slt notShort
+    rwa [B256.toNat_toB256_of_lt bound] at this
+  have takeLen : (out.take 32).length = 32 := by
+    rw [List.length_take]
+    omega
+  have word : Bytes.toB256 (M4.read p.toNat 32).1 = Bytes.toB256 (out.take 32) := by
+    rw [r4.read, keep4, reply takeLen]
+  rw [word] at granted isBool
+  exact ⟨d, out, _, I4, _, rfl, quiet, asked, long, eq_one_of_bool granted isBool, short,
+    r4.extend _ _, Mem.Wf.extend w4 _ _, fp4⟩
+
+/-- A returning run of `_checkRole(role)` (entry 88) from the free pointer `p`. -/
+theorem role_check_returned {P : Sevm → Devm → Ninst → Devm → Prop}
+    (project : ∀ {s d i d'}, P s d i d' → Ninst.Run s d i d')
+    {b D : Devm} {p R c : B256} {S : List B256} {M : Mem} {I : Bytes} {G : Nat}
+    (fork : CoveredFork sevm.benvStat.fork)
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = p.toBytes)
+    (lo : 96 ≤ p.toNat) (hi : p.toNat + 68 < 2 ^ 256)
+    (run : SFunc.RunP P cert.prog sevm (St b (R :: c :: S) M G) t_1954_c88 (.returned D)) :
+    ∃ (d : Devm) (out : Bytes) (M' : Mem) (I' : Bytes) (G' : Nat), D = St d S M' G' ∧
+      QuietFrom sevm b d ∧ StaticAnswered sevm b registry (hasRoleData R sevm.caller) out ∧
+      32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 1 ∧ out.length < 2 ^ 255 ∧
+      Mem.Reads M' I' ∧ Mem.Wf M' ∧
+      I'.sliceD 64 32 0 = (bumpFp p out.length.toB256).toBytes := by
+  stock_run
+  obtain ⟨_, D', callee, run⟩ := rpw_callRet (g := t_1e60_c119) rfl run
+  obtain ⟨d, out, M', I', G', rfl, quiet, asked, long, one, short, r', w', fp⟩ :=
+    query119_returned_at project fork reads wf ptr lo hi callee
+  stock_run
+  obtain ⟨_, rfl⟩ := rpw_ret run
+  exact ⟨d, out, M', I', _, rfl, quiet, by simpa only [hasRoleData, toAdr_toB256] using asked,
+    long, one, short, r', w', fp⟩
+
+end RoleReturned
