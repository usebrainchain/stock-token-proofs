+import Blanc.Lift.Stock.Paused
+
+/-!
+# Stock: entry points that make no paused check and no blocklist query
+
+Plain statement: from the entry of `adminBurn`, `pause`, `unpause`, `setMetadata`, `pauseOracle`
+and `unpauseOracle`, the checked certificate's control flow (internal calls, jumps and branch
+targets) reaches a closed set of entries that does not contain the `paused()` routine (entry 58),
+and the only external call site in that set is the `hasRole` query of `_checkRole` (entry 119).
+So no run of these entry points checks either paused flag, and none asks the registry anything but
+`hasRole(role, caller)`: in particular `adminBurn` makes no blocklist query.
+
+These are facts about the certificate, which `cert_check` ties to the deployed bytes: every
+successful run of the bytes is a run of the certificate's trees (`CursorOK.sourceRun`), and a run
+only enters entries its trees reference.  They are decided by the kernel over the explicit entry
+sets below.
+-/
+
+namespace Blanc.Lift.Stock
+
+open Jaune Blanc Blanc.Lift
+
+/-- `S` is closed under the entries its members' trees reference. -/
+def RefClosed (fs : List SFunc) (S : List Nat) : Bool :=
+  S.all fun k => match fs[k]? with
+    | some g => g.refs.all (· ∈ S)
+    | none => false
+
+/-- The tree executes a `STATICCALL` somewhere. -/
+def hasStaticcall : SFunc → Bool
+  | .branch f g => hasStaticcall f || hasStaticcall g
+  | .branchTo f _ => hasStaticcall f
+  | .next (.exec .staticcall) _ => true
+  | .next _ f => hasStaticcall f
+  | .dest f => hasStaticcall f
+  | .callNext _ f => hasStaticcall f
+  | .pcAt _ f => hasStaticcall f
+  | _ => false
+
+/-- The entries of `S` with a `STATICCALL` site. -/
+def staticEntries (S : List Nat) : List Nat :=
+  S.filter fun k => (cert.prog[k]?.map hasStaticcall).getD false
+
+/-- From entry `e`, control stays in `S`, which holds neither the `paused()` routine nor any external
+call site but the `hasRole` query. -/
+def OnlyRoleQuery (e : Nat) (S : List Nat) : Prop :=
+  RefClosed cert.prog S = true ∧ e ∈ S ∧ 58 ∉ S ∧ staticEntries S = [119]
+
+theorem adminBurn_no_pause_no_blocklist : OnlyRoleQuery 178
+    [4, 9, 17, 18, 19, 20, 39, 41, 73, 79, 82, 83, 88, 90, 91, 99, 119, 120, 121, 123, 124, 125,
+      136, 143, 178] := by
+  unfold OnlyRoleQuery staticEntries
+  decide +kernel
+
+theorem pause_no_pause_check : OnlyRoleQuery 162 [9, 18, 54, 83, 88, 119, 120, 162] := by
+  unfold OnlyRoleQuery staticEntries
+  decide +kernel
+
+theorem unpause_no_pause_check : OnlyRoleQuery 169 [9, 18, 63, 83, 88, 119, 120, 169] := by
+  unfold OnlyRoleQuery staticEntries
+  decide +kernel
+
+theorem setMetadata_no_pause_check : OnlyRoleQuery 164
+    [5, 8, 9, 18, 22, 23, 24, 25, 26, 56, 57, 80, 83, 88, 97, 101, 104, 105, 119, 120, 126, 127,
+      128, 164] := by
+  unfold OnlyRoleQuery staticEntries
+  decide +kernel
+
+theorem pauseOracle_no_pause_check : OnlyRoleQuery 175 [9, 18, 70, 83, 88, 113, 119, 120, 175] := by
+  unfold OnlyRoleQuery staticEntries
+  decide +kernel
+
+theorem unpauseOracle_no_pause_check :
+    OnlyRoleQuery 172 [9, 18, 66, 83, 88, 109, 119, 120, 172] := by
+  unfold OnlyRoleQuery staticEntries
+  decide +kernel
+
+/-- The dispatcher sends each of these selectors to the entry named above. -/
+theorem dispatch_targets :
+    cert.prog[178]? = some t_023f_c178 ∧ cert.prog[162]? = some t_03ca_c162 ∧
+    cert.prog[169]? = some t_02cc_c169 ∧ cert.prog[164]? = some t_0339_c164 ∧
+    cert.prog[175]? = some t_02ad_c175 ∧ cert.prog[172]? = some t_027c_c172 :=
+  ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩
+
+end Blanc.Lift.Stock
