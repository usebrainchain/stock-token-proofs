+theorem reply_checked_at {P : Sevm → Devm → Ninst → Devm → Prop}
+    (project : ∀ {s d i d'}, P s d i d' → Ninst.Run s d i d')
+    {d : Devm} {p x0 x1 x2 x3 A R : B256} {S : List B256} {M : Mem} {I : Bytes}
+    {G : Nat} {o : Outcome} {out : Bytes}
+    (returned : d.returnData = out) (bound : out.length < 2 ^ 256)
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = p.toBytes)
+    (lo : 96 ≤ p.toNat)
+    (reply : (out.take 32).length = 32 → I.sliceD p.toNat 32 0 = out.take 32)
+    (run : SFunc.RunP P cert.prog sevm (St d (x0 :: x1 :: x2 :: x3 :: A :: R :: S) M G)
+      t_1ecb_c119 o) :
+    32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 1 := by
+  rw [reply_shape_at] at run
+  obtain ⟨_, run⟩ := rpw_dest run
+  obtain ⟨_, line, run⟩ := rpw_nexts project _ run
+  obtain ⟨M4, I4, G4, rfl, r4, w4, p4, _⟩ := reply_line_at reads wf ptr lo line
