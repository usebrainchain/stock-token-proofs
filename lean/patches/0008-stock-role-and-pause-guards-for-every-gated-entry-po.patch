+      (by rw [B256.length_toBytes]), Nat.sub_self]
+    exact Bytes.sliceD_zero_length (B256.length_toBytes _)
+
+/-- The ABI `bool` decoder (entries 83 and 18), called on `[p, p + n)`: a returning run checked
+the length and that the word read is `0` or `1`, and returns it. -/
+theorem decoder_returned_at {P : Sevm → Devm → Ninst → Devm → Prop}
+    (project : ∀ {s d i d'}, P s d i d' → Ninst.Run s d i d')
+    {b D : Devm} {p n ret : B256} {S : List B256} {M : Mem} {G : Nat}
+    (run : SFunc.RunP P cert.prog sevm (St b (p :: (p + n) :: ret :: S) M G) t_29f1_c83
+      (.returned D)) :
+    ¬ B256.Slt n (Bytes.toB256 [0x20]) ∧
+      B256.eqCheck (Bytes.toB256 (M.read p.toNat 32).1)
+        (B256.eqCheck (B256.eqCheck (Bytes.toB256 (M.read p.toNat 32).1) 0) 0) ≠ 0 ∧
+      ∃ G', D = St b (Bytes.toB256 (M.read p.toNat 32).1 :: S) (M.read p.toNat 32).2 G' := by
+  rw [length_shape] at run
+  obtain ⟨_, run⟩ := rpw_dest run
+  obtain ⟨_, line, run⟩ := rpw_nexts project lengthLine run
+  obtain ⟨_, rfl⟩ := length_line line
+  rcases rpw_branch run with ⟨_, _, dead⟩ | ⟨longEnough, _, run⟩
+  · exact (rpw_dead rfl dead).elim
+  have sltZero := B256.eqCheck_ne_zero_iff.mp longEnough
+  rw [add_sub_cancel_left'] at sltZero
+  rw [bool_shape] at run
+  obtain ⟨_, run⟩ := rpw_dest run
+  obtain ⟨_, line, run⟩ := rpw_nexts project boolLine run
+  obtain ⟨_, rfl⟩ := bool_line line
+  rcases rpw_branchTo run with ⟨_, _, dead⟩ | ⟨isBool, g, _, entry18, run⟩
+  · exact (rpw_dead rfl dead).elim
+  rw [show cert.prog[18]? = some t_1a1b_c18 from rfl] at entry18
+  cases entry18
+  rw [unwind_shape] at run
+  obtain ⟨_, run⟩ := rpw_dest run
+  obtain ⟨_, line, run⟩ := rpw_nexts project unwindLine run
+  obtain ⟨_, rfl⟩ := unwind_line line
+  exact ⟨not_slt_of_sltCheck sltZero, isBool, rpw_ret run⟩
