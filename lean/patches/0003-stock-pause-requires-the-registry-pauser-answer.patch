+/-! ## The query, the decoder and the branch after it -/
+
+private theorem not_slt_of_sltCheck {x y : B256} (h : B256.sltCheck x y = 0) :
+    ¬ B256.Slt x y := by
+  intro lt
+  unfold B256.sltCheck at h
+  split at h
+  · exact absurd h (by decide)
+  · contradiction
+
+/-- Entry 119 up to the reply: the `STATICCALL` was answered by the registry (the failed-call
+branch reverts), and the run goes on at the reply handler with the reply written at the free
+pointer. -/
+private theorem query_called {P : Sevm → Devm → Ninst → Devm → Prop}
+    (project : ∀ {s d i d'}, P s d i d' → Ninst.Run s d i d')
+    {sevm : Sevm} {b : Devm} {A R : B256} {S : List B256} {M : Mem} {I : Bytes} {G : Nat}
+    {o : Outcome} (fork : CoveredFork sevm.benvStat.fork)
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = (128 : B256).toBytes)
+    (run : SFunc.RunP P cert.prog sevm (St b (A :: R :: S) M G) t_1e60_c119 o) :
+    ∃ (out : Bytes) (d : Devm) (x0 x1 x2 x3 : B256) (M' : Mem) (I' : Bytes) (G' : Nat),
+      StaticAnswered sevm b registry
+        ([0x91, 0xd1, 0x48, 0x54] ++ R.toBytes ++ A.toAdr.toB256.toBytes) out ∧
+      out.length < 2 ^ 256 ∧ d.returnData = out ∧
+      Mem.Reads M' I' ∧ Mem.Wf M' ∧ I'.sliceD 64 32 0 = (128 : B256).toBytes ∧
+      ((out.take 32).length = 32 → I'.sliceD 128 32 0 = out.take 32) ∧
+      SFunc.RunP P cert.prog sevm (St d (x0 :: x1 :: x2 :: x3 :: A :: R :: S) M' G')
+        t_1ecb_c119 o := by
+  rw [entry119_shape] at run
+  obtain ⟨_, run⟩ := rpw_dest run
+  obtain ⟨_, line, run⟩ := rpw_nexts project queryLine run
+  obtain ⟨gw, t, ii, is, os, e, s, M1, I1, G1, rfl, ht, rfl, rfl, rfl, r1, w1, p1, data⟩ :=
+    query_line reads wf ptr line
+  obtain ⟨d2, call, run⟩ := rpw_next run
+  obtain ⟨flag, out, post, bound, answered⟩ := ri_staticcall_bounded fork (project call)
+  rw [post.eq_St] at run
+  obtain ⟨_, line, run⟩ := rpw_nexts project flagLine run
+  obtain ⟨_, rfl⟩ := flag_line line
+  rcases rpw_branch run with ⟨_, _, dead⟩ | ⟨accepted, _, run⟩
+  · exact (rpw_dead rfl dead).elim
+  have flagOne : flag = 1 := by
+    rcases post.flag with zero | one
+    · subst zero
+      exact absurd (by decide : B256.eqCheck (B256.eqCheck (0 : B256) 0) 0 = 0) accepted
+    · exact one
+  have n128 : (128 : B256).toNat = 128 := by decide
+  have n68 : (68 : B256).toNat = 68 := by decide
+  have n32 : (32 : B256).toNat = 32 := by decide
+  have asked := answered flagOne
+  rw [ht, r1.read, n128, n68, data] at asked
+  refine ⟨out, d2, _, _, _, _, _, _, _, asked, bound, post.returnData,
+    (r1.extends _).write (Mem.Wf.extends _ w1) _ _, Mem.Wf.write (Mem.Wf.extends _ w1) _ _,
+    ?_, ?_, run⟩
+  · rw [Bytes.sliceD_writeAt_before _ _ _ _ _ (by rw [n128]; omega), p1]
+  · intro takeLen
+    have back := Bytes.sliceD_writeAt I1 (out.take 32) 128
+    rw [takeLen] at back
+    rw [n128, n32, back]
+
+/-- The ABI `bool` decoder (entries 83 and 18), called on `[0x80, 0x80 + returndatasize)`:
+a returning run checked the length and that the word read is `0` or `1`, and returns it. -/
+private theorem decoder_returned {P : Sevm → Devm → Ninst → Devm → Prop}
+    (project : ∀ {s d i d'}, P s d i d' → Ninst.Run s d i d')
+    {sevm : Sevm} {b D : Devm} {n ret : B256} {S : List B256} {M : Mem} {G : Nat}
+    (run : SFunc.RunP P cert.prog sevm (St b (128 :: (128 + n) :: ret :: S) M G) t_29f1_c83
+      (.returned D)) :
+    ¬ B256.Slt n (Bytes.toB256 [0x20]) ∧
+      B256.eqCheck (Bytes.toB256 (M.read (128 : B256).toNat 32).1)
+        (B256.eqCheck (B256.eqCheck (Bytes.toB256 (M.read (128 : B256).toNat 32).1) 0) 0) ≠ 0 ∧
+      ∃ G', D = St b (Bytes.toB256 (M.read (128 : B256).toNat 32).1 :: S)
+        (M.read (128 : B256).toNat 32).2 G' := by
+  rw [length_shape] at run
+  obtain ⟨_, run⟩ := rpw_dest run
+  obtain ⟨_, line, run⟩ := rpw_nexts project lengthLine run
+  obtain ⟨_, rfl⟩ := length_line line
+  rcases rpw_branch run with ⟨_, _, dead⟩ | ⟨longEnough, _, run⟩
+  · exact (rpw_dead rfl dead).elim
+  have sltZero := B256.eqCheck_ne_zero_iff.mp longEnough
+  rw [add_sub_cancel_left'] at sltZero
+  rw [bool_shape] at run
+  obtain ⟨_, run⟩ := rpw_dest run
+  obtain ⟨_, line, run⟩ := rpw_nexts project boolLine run
+  obtain ⟨_, rfl⟩ := bool_line line
+  rcases rpw_branchTo run with ⟨_, _, dead⟩ | ⟨isBool, g, _, entry18, run⟩
+  · exact (rpw_dead rfl dead).elim
+  rw [show cert.prog[18]? = some t_1a1b_c18 from rfl] at entry18
+  cases entry18
+  rw [unwind_shape] at run
+  obtain ⟨_, run⟩ := rpw_dest run
+  obtain ⟨_, line, run⟩ := rpw_nexts project unwindLine run
+  obtain ⟨_, rfl⟩ := unwind_line line
+  exact ⟨not_slt_of_sltCheck sltZero, isBool, rpw_ret run⟩
+
+/-- The reply handler of entry 119: a run that does not revert saw at least 32 returned bytes and
+a first word `1`. -/
+private theorem reply_checked {P : Sevm → Devm → Ninst → Devm → Prop}
+    (project : ∀ {s d i d'}, P s d i d' → Ninst.Run s d i d')
+    {sevm : Sevm} {d : Devm} {x0 x1 x2 x3 A R : B256} {S : List B256} {M : Mem} {I : Bytes}
+    {G : Nat} {o : Outcome} {out : Bytes}
+    (returned : d.returnData = out) (bound : out.length < 2 ^ 256)
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = (128 : B256).toBytes)
+    (reply : (out.take 32).length = 32 → I.sliceD 128 32 0 = out.take 32)
+    (run : SFunc.RunP P cert.prog sevm (St d (x0 :: x1 :: x2 :: x3 :: A :: R :: S) M G)
+      t_1ecb_c119 o) :
+    32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 1 := by
+  rw [reply_shape] at run
+  obtain ⟨_, run⟩ := rpw_dest run
+  obtain ⟨_, line, run⟩ := rpw_nexts project replyLine run
+  obtain ⟨M4, I4, G4, rfl, r4, w4, p4⟩ := reply_line reads wf ptr line
+  rw [returned] at run
+  obtain ⟨_, D, callee, run⟩ :=
+    rpw_callOver (S' := [83, 18]) (g := t_29f1_c83) (by decide +kernel) rfl (by decide) run
+  obtain ⟨notShort, isBool, G5, rfl⟩ := decoder_returned project callee
+  rw [verdict_shape] at run
+  obtain ⟨_, run⟩ := rpw_dest run
+  obtain ⟨_, step, run⟩ := rpw_next run
+  obtain ⟨_, rfl⟩ := ri_push (project step)
+  rcases rpw_branchTo run with ⟨_, _, rejected⟩ | ⟨granted, _, _, _, _⟩
+  · exact (rpw_jumpsDead rejected (by decide +kernel)).elim
+  have long : 32 ≤ out.length := by
+    have := le_toNat_of_not_slt notShort
+    rwa [B256.toNat_toB256_of_lt bound] at this
+  have takeLen : (out.take 32).length = 32 := by
+    rw [List.length_take]
+    omega
+  have n128 : (128 : B256).toNat = 128 := by decide
+  have word : Bytes.toB256 (M4.read (128 : B256).toNat 32).1 = Bytes.toB256 (out.take 32) := by
+    rw [r4.read, n128, p4, reply takeLen]
+  rw [word] at granted isBool
+  exact ⟨long, eq_one_of_bool granted isBool⟩
+
+/-- From entry 119 with `account :: role` on the stack and the free pointer at `0x80`, every run
+that does not revert asked the registry `hasRole(role, account)` and was answered with a word
+`1`. -/
+theorem query_answered {P : Sevm → Devm → Ninst → Devm → Prop}
+    (project : ∀ {s d i d'}, P s d i d' → Ninst.Run s d i d')
+    {sevm : Sevm} {b : Devm} {A R : B256} {S : List B256} {M : Mem} {I : Bytes} {G : Nat}
+    {o : Outcome} (fork : CoveredFork sevm.benvStat.fork)
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = (128 : B256).toBytes)
+    (run : SFunc.RunP P cert.prog sevm (St b (A :: R :: S) M G) t_1e60_c119 o) :
+    ∃ out, StaticAnswered sevm b registry
+        ([0x91, 0xd1, 0x48, 0x54] ++ R.toBytes ++ A.toAdr.toB256.toBytes) out ∧
+      32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 1 := by
+  obtain ⟨out, d, _, _, _, _, _, _, _, asked, bound, returned, r, w, p, reply, run⟩ :=
+    query_called project fork reads wf ptr run
+  exact ⟨out, asked, reply_checked project returned bound r w p reply run⟩
+
+/-- **`pause()` requires the pauser role.**  For every state, environment, caller and registry
+code: if a run of Stock's deployed bytes with selector `pause()` succeeds, it made a successful
+`STATICCALL` to the registry with calldata `hasRole(TOKEN_PAUSER_ROLE, caller)` over the frame's
+starting world, and the registry returned at least 32 bytes whose first word is `1`. -/
+theorem pause_requires_role {F : Exec.Deriv} {post : Devm}
+    (pc : F.pc = 0) (onCode : F.sevm.code = code)
+    (stack : F.devm.stack = []) (memory : F.devm.memory = Mem.empty)
+    (selector : Sevm.selector F.sevm = pauseSelector)
+    (success : F.exn = .ok post) (fork : CoveredFork F.sevm.benvStat.fork) :
+    ∃ out : Bytes,
+      StaticAnswered F.sevm F.devm registry (hasRoleData tokenPauserRole F.sevm.caller) out ∧
+      32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 1 := by
+  have neutral := fork.histFork.neutral
+  obtain ⟨atPause⟩ := root_pause pc onCode stack memory selector success neutral
+  obtain ⟨S, ⟨atQuery⟩⟩ := enter_check atPause success neutral.stateGas
+  obtain ⟨G, state⟩ := atQuery.state
+  obtain ⟨outcome, run⟩ := atQuery.placed.sourceRunH cert_check (atQuery.exn_eq.trans success)
+    (by rw [atQuery.sevm_eq]; exact neutral.stateGas)
+  rw [atQuery.tree, state, atQuery.sevm_eq] at run
+  have reads : Mem.Reads freeMem (Bytes.writeAt [] 64 (128 : B256).toBytes) :=
+    Mem.reads_empty.write Mem.wf_empty 64 _
+  have wf : Mem.Wf freeMem := Mem.Wf.write Mem.wf_empty 64 _
+  have ptr : (Bytes.writeAt [] 64 (128 : B256).toBytes).sliceD 64 32 0 = (128 : B256).toBytes := by
+    decide
+  obtain ⟨out, answered, long, one⟩ :=
+    query_answered (fun h => StepIn.toRun h) fork reads wf ptr run
+  refine ⟨out, ?_, long, one⟩
+  simpa only [hasRoleData, toAdr_toB256] using answered
+
+end Blanc.Lift.Stock
