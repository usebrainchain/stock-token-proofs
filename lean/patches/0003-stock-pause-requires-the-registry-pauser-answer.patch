+private theorem root_pause {F : Exec.Deriv} {post : Devm}
+    (pc : F.pc = 0) (onCode : F.sevm.code = code)
+    (stack : F.devm.stack = []) (memory : F.devm.memory = Mem.empty)
+    (selector : Sevm.selector F.sevm = pauseSelector)
+    (success : F.exn = .ok post) (fork : NeutralFork F.sevm.benvStat.fork) :
+    Nonempty (CursorStateAt code cert F t_03ca_c162 F.devm [pauseSelector] freeMem []) := by
+  obtain ⟨selected⟩ := root_selected pc onCode stack memory success fork
+  rw [selector] at selected
+  obtain ⟨c0⟩ := SolcSignedQuery.selector_gt_zero selected cert_check (by decide) success fork
+  obtain ⟨c1⟩ := SolcSignedQuery.selector_gt_succ c0 cert_check (by decide) success fork
+  obtain ⟨o2⟩ := c1.destH cert_check success fork.stateGas
+  obtain ⟨c2⟩ := SolcSignedQuery.selector_gt_succ o2 cert_check (by decide) success fork
+  obtain ⟨o3⟩ := c2.destH cert_check success fork.stateGas
+  obtain ⟨c3⟩ := SolcSignedQuery.selector_eq_zero o3 cert_check (by decide) success fork
+  obtain ⟨c4⟩ := SolcSignedQuery.selector_eq_zero c3 cert_check (by decide) success fork
+  obtain ⟨c5⟩ := SolcSignedQuery.selector_eq_zero c4 cert_check (by decide) success fork
+  exact SolcSignedQuery.selector_eq_succ c5 cert_check (by decide) rfl success fork
