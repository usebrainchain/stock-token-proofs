+/-- The selector prefix, with solc 0.8's `PUSH0` for the calldata offset. -/
+private def selectorLine0 : List Ninst :=
+  [.push [] (by decide), .reg .calldataload, .push [0xe0] (by decide), .reg .shr]
+
+private theorem selector_line0 {sevm : Sevm} {b d : Devm} {S : List B256} {M : Mem} {G : Nat}
+    (run : Line.Run sevm (St b S M G) selectorLine0 d) :
+    ∃ G', d = St b (Sevm.selector sevm :: S) M G' := by
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
+  obtain ⟨_, rfl⟩ := ri_push step
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
+  obtain ⟨_, rfl⟩ := ri_calldataload step
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
+  obtain ⟨_, rfl⟩ := ri_push step
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
+  obtain ⟨_, rfl⟩ := ri_shr step
+  cases run
+  exact ⟨_, rfl⟩
