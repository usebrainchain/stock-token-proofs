+/-! ## Word facts the decoder establishes -/
+
+/-- A word that is not below `32` as a signed number is at least `32`. -/
+private theorem le_toNat_of_not_slt {x : B256} (h : ¬ B256.Slt x (Bytes.toB256 [0x20])) :
+    32 ≤ x.toNat := by
+  have em : (B256.max >>> 1 : B256) = B256.low255 := rfl
+  unfold B256.Slt at h
+  rw [em] at h
+  cases ha : x.highBit
+  · have hand : x &&& B256.low255 = x := by
+      obtain ⟨⟨a, b⟩, ⟨c, d⟩⟩ := x
+      show ((a &&& 0x7fffffffffffffff, b &&& UInt64.max), (c &&& UInt64.max, d &&& UInt64.max)) = _
+      rw [UInt64.and_low63 a ha, UInt64.and_max_self, UInt64.and_max_self, UInt64.and_max_self]
+      rfl
+    have h32m : Bytes.toB256 [0x20] &&& B256.low255 = Bytes.toB256 [0x20] := rfl
+    have h32h : (Bytes.toB256 [0x20]).highBit = false := rfl
+    rw [hand, h32m, ha, h32h] at h
+    have nlt : ¬ x < Bytes.toB256 [0x20] := fun lt => h (Or.inr ⟨rfl, lt⟩)
+    rw [B256.lt_iff_toNat_lt_toNat, show (Bytes.toB256 [0x20]).toNat = 32 by decide] at nlt
+    omega
+  · exfalso
+    apply h
+    left
+    rw [ha]
+    decide
+
+private theorem add_sub_cancel_left' (a x : B256) : (a + x) - a = x := by
+  apply B256.toNat_inj
+  have ha := B256.toNat_lt a
+  have hx := B256.toNat_lt x
+  rw [B256.toNat_sub, B256.toNat_add, Nat.lo_eq, Nat.lo_eq]
+  generalize a.toNat = m at *
+  generalize x.toNat = n at *
+  simp only [Nat.reducePow] at *
+  omega
+
+/-- The decoder accepts a word only if it is `0` or `1`; the branch after it needs it nonzero. -/
+private theorem eq_one_of_bool {v : B256} (nz : v ≠ 0)
+    (ok : B256.eqCheck v (B256.eqCheck (B256.eqCheck v 0) 0) ≠ 0) : v = 1 := by
+  have e0 : B256.eqCheck v 0 = 0 := B256.eqCheck_eq_zero_iff.mpr nz
+  rw [e0, show B256.eqCheck (0 : B256) 0 = 1 by decide] at ok
+  exact B256.eqCheck_ne_zero_iff.mp ok
+
