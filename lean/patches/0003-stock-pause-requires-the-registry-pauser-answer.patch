+private theorem root_selected {F : Exec.Deriv} {post : Devm}
+    (pc : F.pc = 0) (onCode : F.sevm.code = code)
+    (stack : F.devm.stack = []) (memory : F.devm.memory = Mem.empty)
+    (success : F.exn = .ok post) (fork : NeutralFork F.sevm.benvStat.fork) :
+    Nonempty (CursorStateAt code cert F
+      ((SolcSignedQuery.compareLine .gt 0x77 0x06 0xba 0x52 0x01 0x1f).foldr SFunc.next
+        (.branch t_0029_c0 t_011f_c0)) F.devm [Sevm.selector F.sevm] freeMem []) := by
+  have first : CursorStateAt code cert F t_0000_c0 F.devm [] Mem.empty [] :=
+    ⟨F, Cursor.start cert, .refl _, rfl, rfl, cursor_start cert_check pc onCode, rfl,
+      ⟨_, St.self stack memory⟩, rfl⟩
+  obtain ⟨guard⟩ := first.lineH cert_check success fork.stateGas
+    (SolcSignedQuery.prologue 0 0x0f) rfl
+    (by intro ni member xi same; subst ni
+        simp only [SolcSignedQuery.prologue, List.mem_cons, List.not_mem_nil, reduceCtorEq,
+          or_self] at member)
+    SolcSignedQuery.prologue_line
+  obtain ⟨_, ⟨entered⟩⟩ := SolcSignedQuery.guardSucc guard cert_check rfl success fork
+  obtain ⟨opened⟩ := entered.destH cert_check success fork.stateGas
+  obtain ⟨sized⟩ := opened.lineH cert_check success fork.stateGas
+    (SolcSignedQuery.sizeLine 0x02 0x13) rfl
+    (by intro ni member xi same; subst ni
+        simp only [SolcSignedQuery.sizeLine, List.mem_cons, List.not_mem_nil, reduceCtorEq,
+          or_self] at member)
+    SolcSignedQuery.size_line
+  obtain ⟨_, ⟨selecting⟩⟩ := SolcSignedQuery.guardZero sized cert_check rfl success fork
+  exact selecting.lineH cert_check success fork.stateGas selectorLine0 rfl
+    (by intro ni member xi same; subst ni
+        simp only [selectorLine0, List.mem_cons, List.not_mem_nil, reduceCtorEq, or_self] at member)
+    selector_line0
