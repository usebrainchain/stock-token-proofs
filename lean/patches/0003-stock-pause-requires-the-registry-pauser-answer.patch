+/-!
+# Stock: `pause()` succeeds only on the registry's pauser answer
+
+Plain statement (`pause_requires_role`): for every state, environment, caller and registry code,
+if a run of Stock's deployed bytes with selector `pause()` (`0x8456cb59`) succeeds, then the run
+made a successful `STATICCALL` to the access registry `0xe10b…1b00` with calldata
+`hasRole(TOKEN_PAUSER_ROLE, caller)` over the frame's own starting world, and the registry returned
+at least 32 bytes whose first word is `1`.  Nothing is assumed about the registry's code.
+
+Premises: the frame starts at pc 0 of the registered runtime (`code`, sha256 `0ac99e9c…`) with an
+empty stack and memory, on one of Blanc's covered forks (Prague, Osaka, BPO1, BPO2).  Robinhood
+Chain is an Arbitrum Nitro chain; reading this theorem as a statement about it carries the premise
+that Nitro executes these instructions as Ethereum does.
+
+The walk: the cursor follows the checked certificate from entry 0 through the dispatcher to
+`pause()` (entry 162), its `onlyRole` modifier (entry 54), `_checkRole(role)` (entry 88) and
+`_checkRole(role, account)` (entry 119), all frame-free.  From entry 119 the certificate's source
+run is inverted across the `STATICCALL`, the ABI `bool` decoder (entries 83 and 18) and the
+`if (!hasRole) revert` branch; every rejecting branch ends in `REVERT`, which has no run.
+-/
+
+namespace Blanc.Lift.Stock
+
+open Jaune Blanc Blanc.Lift
+
+/-- The access registry named by Stock's immutables. -/
+def registry : Adr := 0xe10b6f6b275de231345c20d14ab812db62151b00
+
+/-- `keccak256("TOKEN_PAUSER_ROLE")`, the role `pause()` asks for. -/
+def tokenPauserRole : B256 :=
+  0xe95e22ec6dbf4c911d1fae59680a3e9cb71dd35b3a1c697d232e4b01a8ff30a2
+
+/-- ABI calldata of `hasRole(bytes32 role, address account)` (selector `0x91d14854`). -/
+def hasRoleData (role : B256) (account : Adr) : Bytes :=
+  [0x91, 0xd1, 0x48, 0x54] ++ role.toBytes ++ account.toB256.toBytes
+
+/-- The `pause()` selector. -/
+def pauseSelector : B256 := 0x8456cb59
+
+/-- Memory after the Solidity prologue: the free-memory pointer `0x80` at `0x40`. -/
+abbrev freeMem : Mem := Mem.empty.write 64 (128 : B256).toBytes
+
+/-! ## Inverting straight lines of a source run -/
+
+section Lines
+
+variable {P : Sevm → Devm → Ninst → Devm → Prop} {fs : List SFunc} {sevm : Sevm}
+
+private theorem rpw_nexts (project : ∀ {s d i d'}, P s d i d' → Ninst.Run s d i d')
+    (ns : List Ninst) {pre : Devm} {tail : SFunc} {o : Outcome}
+    (run : SFunc.RunP P fs sevm pre (ns.foldr SFunc.next tail) o) :
+    ∃ post, Line.Run sevm pre ns post ∧ SFunc.RunP P fs sevm post tail o := by
+  induction ns generalizing pre with
+  | nil => exact ⟨pre, .nil, run⟩
+  | cons n ns ih =>
+    change SFunc.RunP P fs sevm pre (.next n (ns.foldr SFunc.next tail)) o at run
+    obtain ⟨middle, first, rest⟩ := rpw_next run
+    obtain ⟨post, line, tailRun⟩ := ih rest
+    exact ⟨post, .cons (project first) line, tailRun⟩
+
+/-- A line ending in a jump to a tree that cannot succeed has no run. -/
+private theorem rpw_nexts_jump_dead (ns : List Ninst) {k : Nat} {g : SFunc}
+    (lookup : fs[k]? = some g) (dead : g.noOk = true) {pre : Devm} {o : Outcome}
+    (run : SFunc.RunP P fs sevm pre (ns.foldr SFunc.next (.jump k)) o) : False := by
+  induction ns generalizing pre with
+  | nil =>
+    cases run with
+    | jump _ entry _ rest =>
+      rw [lookup] at entry
+      cases entry
+      exact (SFunc.runP_iff_runCutP_nil.mp rest).false_of_noOk dead
+  | cons n ns ih =>
+    change SFunc.RunP P fs sevm pre (.next n (ns.foldr SFunc.next (.jump k))) o at run
+    obtain ⟨_, _, rest⟩ := rpw_next run
+    exact ih rest
+
+private theorem rpw_dead {f : SFunc} (dead : f.noOk = true) {pre : Devm} {o : Outcome}
+    (run : SFunc.RunP P fs sevm pre f o) : False :=
+  (SFunc.runP_iff_runCutP_nil.mp run).false_of_noOk dead
+
+end Lines
+
+/-- Trees whose every path either fails or jumps into an entry that cannot succeed. -/
+private def jumpsDead (fs : List SFunc) : SFunc → Bool
+  | .next _ f => jumpsDead fs f
+  | .dest f => jumpsDead fs f
+  | .jump k => (fs[k]?.map SFunc.noOk).getD true
+  | f => f.noOk
+
+section Dead
+
+variable {P : Sevm → Devm → Ninst → Devm → Prop} {fs : List SFunc} {sevm : Sevm}
+
+private theorem rpw_jumpsDead {f : SFunc} {pre : Devm} {o : Outcome}
+    (run : SFunc.RunP P fs sevm pre f o) (h : jumpsDead fs f = true) : False := by
+  induction run with
+  | next _ _ ih => exact ih h
+  | dest _ _ ih => exact ih h
+  | jump d entry pop rest _ =>
+    simp only [jumpsDead, entry, Option.map_some, Option.getD_some] at h
+    exact rpw_dead h rest
+  | zero d pop rest _ => exact rpw_dead h (.zero d pop rest)
+  | succ d w nz pop rest _ => exact rpw_dead h (.succ d w nz pop rest)
+  | toZero d pop rest _ => exact rpw_dead h (.toZero d pop rest)
+  | toSucc d w nz entry pop rest _ => exact rpw_dead h (.toSucc d w nz entry pop rest)
+  | last hl => exact rpw_dead (P := P) (fs := fs) h (.last hl)
+  | ret _ _ => simp only [jumpsDead, SFunc.noOk, Bool.false_eq_true] at h
+  | callHalt d entry pop callee _ => exact rpw_dead h (.callHalt d entry pop callee)
+  | callRet d entry pop callee rest _ _ => exact rpw_dead h (.callRet d entry pop callee rest)
+  | pcAt _ _ _ _ => simp only [jumpsDead, SFunc.noOk, Bool.false_eq_true] at h
+
+end Dead
+
+/-! ## The `hasRole` query of `_checkRole(role, account)` (entry 119) -/
+
+/-- Entry 119 up to the `STATICCALL`: lay out `hasRole(role, account)` at the free pointer and push
+the call's operands. -/
+private def queryLine : List Ninst :=
+  [.push [0x40] (by decide), .reg .mload, .push [0x24, 0x74, 0x52, 0x15] (by decide),
+   .push [0xe2] (by decide), .reg .shl, .reg (.dup 1), .reg .mstore, .push [0x04] (by decide),
+   .reg (.dup 1), .reg .add, .reg (.dup 3), .reg (.swap 0), .reg .mstore,
+   .push [0x01] (by decide), .push [0x01] (by decide), .push [0xa0] (by decide), .reg .shl,
+   .reg .sub, .reg (.dup 2), .reg (.dup 1), .reg .and, .push [0x24] (by decide), .reg (.dup 3),
+   .reg .add, .reg .mstore,
+   .push [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xe1, 0x0b,
+     0x6f, 0x6b, 0x27, 0x5d, 0xe2, 0x31, 0x34, 0x5c, 0x20, 0xd1, 0x4a, 0xb8, 0x12, 0xdb, 0x62,
+     0x15, 0x1b, 0x00] (by decide),
+   .reg .and, .reg (.swap 0), .push [0x91, 0xd1, 0x48, 0x54] (by decide), .reg (.swap 0),
+   .push [0x44] (by decide), .reg .add, .push [0x20] (by decide), .push [0x40] (by decide),
+   .reg .mload, .reg (.dup 0), .reg (.dup 3), .reg .sub, .reg (.dup 1), .reg (.dup 6), .reg .gas]
+
+/-- The call-flag guard after the `STATICCALL`. -/
+private def flagLine : List Ninst :=
+  [.reg .iszero, .reg (.dup 0), .reg .iszero, .push [0x1e, 0xcb] (by decide)]
+
+/-- The success side: drop the call operands, move the free pointer past the return data, and
+call the ABI `bool` decoder on `[ptr, ptr + returndatasize)`. -/
+private def replyLine : List Ninst :=
+  [.reg .pop, .reg .pop, .reg .pop, .reg .pop, .push [0x40] (by decide), .reg .mload,
+   .reg .returndatasize, .push [0x1f] (by decide), .reg .not, .push [0x1f] (by decide),
+   .reg (.dup 2), .reg .add, .reg .and, .reg (.dup 2), .reg .add, .reg (.dup 0),
+   .push [0x40] (by decide), .reg .mstore, .reg .pop, .reg (.dup 1), .reg .add, .reg (.swap 0),
+   .push [0x1e, 0xef] (by decide), .reg (.swap 1), .reg (.swap 0), .push [0x29, 0xf1] (by decide)]
+
+/-- The decoder's length check (entry 83). -/
+private def lengthLine : List Ninst :=
+  [.push [] (by decide), .push [0x20] (by decide), .reg (.dup 2), .reg (.dup 4), .reg .sub,
+   .reg .slt, .reg .iszero, .push [0x2a, 0x01] (by decide)]
+
+/-- The decoder's `bool` check: the word must equal its own double negation. -/
+private def boolLine : List Ninst :=
+  [.reg (.dup 1), .reg .mload, .reg (.dup 0), .reg .iszero, .reg .iszero, .reg (.dup 1), .reg .eq,
+   .push [0x1a, 0x1b] (by decide)]
+
+/-- The decoder's return shuffle (entry 18). -/
+private def unwindLine : List Ninst :=
+  [.reg (.swap 3), .reg (.swap 2), .reg .pop, .reg .pop, .reg .pop]
+
+private theorem entry119_shape : t_1e60_c119 = .dest (queryLine.foldr SFunc.next
+    (.next (.exec .staticcall) (flagLine.foldr SFunc.next (.branch t_1ec4_c119 t_1ecb_c119)))) :=
+  rfl
+
+private theorem reply_shape : t_1ecb_c119 = .dest (replyLine.foldr SFunc.next
+    (.callNext 83 t_1eef_c119)) := rfl
+
+private theorem length_shape : t_29f1_c83 = .dest (lengthLine.foldr SFunc.next
+    (.branch t_29fe_c83 t_2a01_c83)) := rfl
+
+private theorem bool_shape : t_2a01_c83 = .dest (boolLine.foldr SFunc.next
+    (.branchTo t_2a0d_c83 18)) := rfl
+
+private theorem unwind_shape : t_1a1b_c18 = .dest (unwindLine.foldr SFunc.next .ret) := rfl
+
+private theorem verdict_shape : t_1eef_c119 = .dest (.next (.push [0x0e, 0xd0] (by decide))
+    (.branchTo t_1ef4_c119 9)) := rfl
+
+section Query
+
+variable {sevm : Sevm}
+
+/-- `SLT`, inverted with its value. -/
+private theorem ri_slt_val {b : Devm} {S : List B256} {M : Mem} {G : Nat} {x y : B256} {d : Devm}
+    (h : Ninst.Run sevm (St b (x :: y :: S) M G) (.reg .slt) d) :
+    ∃ G', d = St b (B256.sltCheck x y :: S) M G' := by
+  rcases of_run_reg h with ⟨pc, run⟩
+  simp only [Rinst.run, Rinst.runCore] at run
+  exact St.of_diff (v := B256.sltCheck) (Devm.diffBurn_of_applyBinary run)
+
+private theorem mask_eq :
+    (Bytes.toB256 [0x01] <<< (Bytes.toB256 [0xa0]).toNat) - Bytes.toB256 [0x01] =
+      ~~~ addressMask := by decide
+
+private theorem registry_word :
+    (Bytes.toB256 [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xe1,
+      0x0b, 0x6f, 0x6b, 0x27, 0x5d, 0xe2, 0x31, 0x34, 0x5c, 0x20, 0xd1, 0x4a, 0xb8, 0x12, 0xdb,
+      0x62, 0x15, 0x1b, 0x00] &&& ~~~ addressMask).toAdr = registry := by decide
+
+private theorem selector_word :
+    ((Bytes.toB256 [0x24, 0x74, 0x52, 0x15] <<< (Bytes.toB256 [0xe2]).toNat).toBytes).sliceD 0 4 0 =
+      [0x91, 0xd1, 0x48, 0x54] := by decide
+
+/-- The memory `queryLine` leaves before its final `MLOAD`: `hasRole`'s selector word at the free
+pointer, the role at `+4`, the masked account at `+0x24`. -/
+private def queryMem (M : Mem) (A R : B256) : Mem :=
+  (((M.read (Bytes.toB256 [0x40]).toNat 32).2.write (128 : B256).toNat
+    (Bytes.toB256 [0x24, 0x74, 0x52, 0x15] <<< (Bytes.toB256 [0xe2]).toNat).toBytes).write
+    ((128 : B256) + Bytes.toB256 [0x04]).toNat R.toBytes).write
+    ((128 : B256) + Bytes.toB256 [0x24]).toNat
+    (((Bytes.toB256 [0x01] <<< (Bytes.toB256 [0xa0]).toNat) - Bytes.toB256 [0x01]) &&& A).toBytes
+
+private theorem query_memory {M : Mem} {I : Bytes} {A R : B256}
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = (128 : B256).toBytes) :
+    ∃ I3 : Bytes, Mem.Reads (queryMem M A R) I3 ∧ Mem.Wf (queryMem M A R) ∧
+      I3.sliceD 64 32 0 = (128 : B256).toBytes ∧
+      I3.sliceD 128 68 0 = [0x91, 0xd1, 0x48, 0x54] ++ R.toBytes ++ A.toAdr.toB256.toBytes := by
+  have w0 : Mem.Wf (M.read (Bytes.toB256 [0x40]).toNat 32).2 := Mem.Wf.extend wf _ _
+  have r0 : Mem.Reads (M.read (Bytes.toB256 [0x40]).toNat 32).2 I := reads.extend _ _
+  have w1 := Mem.Wf.write w0 (128 : B256).toNat
+    (Bytes.toB256 [0x24, 0x74, 0x52, 0x15] <<< (Bytes.toB256 [0xe2]).toNat).toBytes
+  have r1 := r0.write w0 (128 : B256).toNat
+    (Bytes.toB256 [0x24, 0x74, 0x52, 0x15] <<< (Bytes.toB256 [0xe2]).toNat).toBytes
+  have w2 := Mem.Wf.write w1 ((128 : B256) + Bytes.toB256 [0x04]).toNat R.toBytes
+  have r2 := r1.write w1 ((128 : B256) + Bytes.toB256 [0x04]).toNat R.toBytes
+  have w3 := Mem.Wf.write w2 ((128 : B256) + Bytes.toB256 [0x24]).toNat
+    (((Bytes.toB256 [0x01] <<< (Bytes.toB256 [0xa0]).toNat) - Bytes.toB256 [0x01]) &&& A).toBytes
+  have r3 := r2.write w2 ((128 : B256) + Bytes.toB256 [0x24]).toNat
+    (((Bytes.toB256 [0x01] <<< (Bytes.toB256 [0xa0]).toNat) - Bytes.toB256 [0x01]) &&& A).toBytes
+  have n0 : (128 : B256).toNat = 128 := by decide
+  have n4 : ((128 : B256) + Bytes.toB256 [0x04]).toNat = 132 := by decide
+  have n24 : ((128 : B256) + Bytes.toB256 [0x24]).toNat = 164 := by decide
+  refine ⟨_, r3, w3, ?_, ?_⟩
+  · rw [n0, n4, n24, Bytes.sliceD_writeAt_before _ _ _ _ _ (by omega),
+      Bytes.sliceD_writeAt_before _ _ _ _ _ (by omega),
+      Bytes.sliceD_writeAt_before _ _ _ _ _ (by omega), ptr]
+  · rw [n0, n4, n24, show (68 : Nat) = 4 + (32 + 32) from rfl, List.sliceD_split,
+      List.sliceD_split, show (128 + 4 : Nat) = 132 from rfl,
+      show (132 + 32 : Nat) = 164 from rfl]
+    have back2 := Bytes.sliceD_writeAt
+      (Bytes.writeAt I 128 (Bytes.toB256 [0x24, 0x74, 0x52, 0x15] <<<
+        (Bytes.toB256 [0xe2]).toNat).toBytes) R.toBytes 132
+    have back3 := Bytes.sliceD_writeAt
+      (Bytes.writeAt (Bytes.writeAt I 128 (Bytes.toB256 [0x24, 0x74, 0x52, 0x15] <<<
+        (Bytes.toB256 [0xe2]).toNat).toBytes) 132 R.toBytes) (((Bytes.toB256 [0x01] <<<
+        (Bytes.toB256 [0xa0]).toNat) - Bytes.toB256 [0x01]) &&& A).toBytes 164
+    rw [B256.length_toBytes] at back2 back3
+    rw [Bytes.sliceD_writeAt_before _ _ 128 4 164 (by omega),
+      Bytes.sliceD_writeAt_before _ _ 128 4 132 (by omega),
+      Bytes.sliceD_writeAt_inside _ _ 128 128 4 (by omega) (by rw [B256.length_toBytes]; omega),
+      Nat.sub_self, selector_word,
+      Bytes.sliceD_writeAt_before _ _ 132 32 164 (by omega), back2, back3,
+      mask_eq, B256.and_comm, and_mask_word, List.append_assoc]
+
+theorem query_line {b d : Devm} {A R : B256} {S : List B256} {M : Mem} {G : Nat} {I : Bytes}
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = (128 : B256).toBytes)
+    (run : Line.Run sevm (St b (A :: R :: S) M G) queryLine d) :
+    ∃ (gw t ii is os e s : B256) (M' : Mem) (I' : Bytes) (G' : Nat),
+      d = St b (gw :: t :: ii :: is :: ii :: os :: e :: s :: t :: A :: R :: S) M' G' ∧
+      t.toAdr = registry ∧ ii = 128 ∧ is = 68 ∧ os = 32 ∧
+      Mem.Reads M' I' ∧ Mem.Wf M' ∧ I'.sliceD 64 32 0 = (128 : B256).toBytes ∧
+      I'.sliceD 128 68 0 = [0x91, 0xd1, 0x48, 0x54] ++ R.toBytes ++ A.toAdr.toB256.toBytes := by
+  have n40 : (Bytes.toB256 [0x40]).toNat = 64 := by decide
+  have r64 : (M.read (Bytes.toB256 [0x40]).toNat 32).1 = (128 : B256).toBytes := by
+    rw [reads.read, n40]
+    exact ptr
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
+  obtain ⟨_, rfl⟩ := ri_push step
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
+  obtain ⟨_, rfl⟩ := ri_mload step
+  rw [r64, B256.toB256_toBytes] at run
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
+  obtain ⟨_, rfl⟩ := ri_push step
+  obtain ⟨_, step, run⟩ := Line.of_run_cons run
