+/-- Property 2's claim for one address `a`: a static call to the registry with calldata
+`isBlocked(a)` succeeds with at least 32 bytes whose first word is `0`, over a world reached from
+the frame's starting one by quiet instructions. -/
+abbrev BlockedClear (F : Exec.Deriv) (a : Adr) : Prop :=
+  ∃ (b' : Devm) (out : Bytes), QuietFrom F.sevm F.devm b' ∧
+    StaticAnswered F.sevm b' registry (isBlockedData a) out ∧
+    32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 0
+
+/-- The address argument `k` of the call: the low 20 bytes of calldata word `4 + 32 k`, as the ABI
+decoder reads it. -/
+def argAdr (sevm : Sevm) (k : Nat) : Adr := (Sevm.dataWord sevm (Nat.toB256 (4 + 32 * k))).toAdr
+
+theorem blocked_data_left (x : B256) :
+    [0xfb, 0xac, 0x39, 0x51] ++ (x &&& ((Bytes.toB256 [0x01] <<< (Bytes.toB256 [0xa0]).toNat) -
+      Bytes.toB256 [0x01])).toBytes = isBlockedData x.toAdr := by
+  rw [mask_eq, and_mask_word]
+  rfl
+
+theorem blocked_data_right (x : B256) :
+    [0xfb, 0xac, 0x39, 0x51] ++ (((Bytes.toB256 [0x01] <<< (Bytes.toB256 [0xa0]).toNat) -
+      Bytes.toB256 [0x01]) &&& x).toBytes = isBlockedData x.toAdr := by
+  rw [mask_eq, B256.and_comm, and_mask_word]
+  rfl
+
+theorem fp_word {M : Mem} {I : Bytes} {p : B256} (reads : Mem.Reads M I)
+    (ptr : I.sliceD 64 32 0 = p.toBytes) :
+    Bytes.toB256 (M.read (Bytes.toB256 [0x40]).toNat 32).1 = p := by
+  rw [reads.read, show (Bytes.toB256 [0x40]).toNat = 64 by decide, ptr, B256.toB256_toBytes]
+
+/-- **`transfer` checks the blocklist** for argAdr F.sevm 0, F.sevm.caller. -/
