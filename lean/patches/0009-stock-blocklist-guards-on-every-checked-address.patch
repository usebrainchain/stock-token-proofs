+  unfold memExtSize
+  split
+  · omega
+  · exact (Nat.le_mul_ceilDiv (i + n) 32 (by omega)).trans
+      (Nat.mul_le_mul_left 32 (Nat.le_max_right _ _))
+
+theorem size_write_ge (μ : Mem) (i : Nat) (xs : Bytes) : μ.size ≤ (μ.write i xs).size := by
