+  rw [fp_word r2 fp2] at run
+  obtain ⟨d3, out3, M3, I3, G3, quiet3, ans3, long3, zero3, -⟩ :=
+    blocked_at project potOf fork r2 w2 fp2 lo2 (by decide) rfl (by decide +kernel) run
+  rw [blocked_data_right, toAdr_toB256] at ans3
+  refine ⟨⟨b1, out2, quiet1, ?_, long2, zero2⟩, ⟨d2, out3, quiet1.trans quiet2, ans3, long3, zero3⟩⟩
+  rwa [argAdr, show Nat.toB256 (4 + 32 * 0) = Bytes.toB256 [0x04] by decide]
