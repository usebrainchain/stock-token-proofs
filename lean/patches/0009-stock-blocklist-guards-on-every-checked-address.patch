+theorem size_read_ge (μ : Mem) (i n : Nat) : μ.size ≤ (μ.read i n).2.size := by
+  show μ.size ≤ memExtSize μ.size i n
+  unfold memExtSize
+  split
+  · exact Nat.le_refl _
+  · exact (Nat.le_mul_ceilDiv μ.size 32 (by omega)).trans
