+  stock_walk [58]
+  obtain ⟨_, R, b1, M1, I1, G1, p1, o, quiet1, r1, w1, fp1, lo1, run⟩ :=
+    paused_cut_pot cut rfl success fork (pot_of_gas memory gas)
