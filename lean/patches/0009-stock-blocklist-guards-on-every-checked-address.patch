+import Blanc.Lift.Stock.Paused
+import Blanc.Lift.MemPotential
+
+/-!
+# Stock: the blocklist guards
+
+Plain statement (property 2, the blocking half, one theorem per entry point): for every state,
+environment, caller and registry code, if a run of Stock's deployed bytes with the entry point's
+selector succeeds and the frame's gas is below `2 ^ 256`, then for every address the entry point
+checks, a static call to the registry with calldata `isBlocked(address)` succeeds with at least 32
+bytes whose first word is `0`, over a world reached from the frame's starting one by quiet
+instructions.
+
+| entry point | addresses checked, in this order |
+|---|---|
+| `transfer(to, value)` | `to` (`argAdr F.sevm 0`), the caller |
+| `transferFrom(from, to, value)` | `from`, `to`, the caller |
+| `approve(spender, value)` | `spender`, the caller |
+| `permit(owner, spender, …)` | `owner`, `spender`, the caller (the relayer) |
+| `mint(to, amount)` | `to`, the caller (the minter) |
+| `burn(from, amount)` | `from`, the caller (the burner) |
+
+`argAdr F.sevm k` is the address argument `k` as the ABI decoder reads it: the low 20 bytes of
+calldata word `4 + 32 k`.  The first check of each comes after the `paused()` query (and, for
+`mint` and `burn`, the role query), so every answer is over a world reached quietly from the
+frame's starting one.
+
+The gas premise: a frame's gas is at most the gas its transaction carried, a 64-bit field, so every
+real frame satisfies it by a factor of 2^192.  The model allows any natural number, and without a
+bound a registry reply of nearly 2^255 bytes could move the free pointer far enough that a later
+query's windows wrap; the premise bounds memory (`FreePtr.Pot`: gas plus memory cost below 2^256)
+and so every pointer the code writes through.
+-/
+
+namespace Blanc.Lift.Stock
+
+open Jaune Blanc Blanc.Lift
+
+/-! ## The memory potential along the frame -/
+
+theorem parentStep_pot {child parent : Exec.Deriv} (edge : Exec.Deriv.ParentStep child parent)
+    (hsg : parent.sevm.benvStat.rules.stateGas = none) (pot : FreePtr.Pot parent.devm) :
+    FreePtr.Pot child.devm := by
+  cases edge with
+  | @cont pc pc' sevm pre post out hstep next =>
+    have h := Evm.step_memory_accounting_output ⟨pc, sevm, pre⟩ hsg
+    rw [hstep] at h
+    exact Nat.lt_of_le_of_lt h.1 pot
+  | @doneOk pc pc' sevm pre post frame resume settled out hstep henter hresume next =>
+    obtain ⟨x, _, spawn, rfl⟩ := Evm.step_spawn_inv hstep
+    have xrun : Xinst.Run sevm pre x .none (.ok post) := by
+      unfold Xinst.Run XStep.Run
+      rw [spawn]
+      exact ⟨_, RunFrame.of_done henter, hresume.symm⟩
+    have run : Ninst.Run sevm pre (.exec x) post :=
+      ⟨.none, trivial, 0, by simpa only [Ninst.StepRun, Ninst.step_exec, XStep.run_toStep,
+        Xinst.Run] using xrun⟩
+    exact FreePtr.Pot.step hsg run pot
+  | @runOk pc pc' sevm pre post frame resume childEvm childRaw out hstep henter excChild hresume
+      next =>
+    obtain ⟨x, _, spawn, rfl⟩ := Evm.step_spawn_inv hstep
+    have xrun : Xinst.Run sevm pre x (.some ⟨childEvm, childRaw⟩) (.ok post) := by
+      unfold Xinst.Run XStep.Run
+      rw [spawn]
+      exact ⟨_, RunFrame.of_run henter, hresume.symm⟩
+    have run : Ninst.Run sevm pre (.exec x) post :=
+      ⟨.some ⟨childEvm, childRaw⟩, ⟨excChild⟩, 0, by simpa only [Ninst.StepRun, Ninst.step_exec, XStep.run_toStep,
+        Xinst.Run] using xrun⟩
+    exact FreePtr.Pot.step hsg run pot
+
+/-- Every node of a frame's own execution keeps the potential of its start. -/
+theorem parentPrefix_pot {start node : Exec.Deriv} (reached : Exec.Deriv.ParentPrefix start node)
+    (hsg : start.sevm.benvStat.rules.stateGas = none) (pot : FreePtr.Pot start.devm) :
+    FreePtr.Pot node.devm := by
+  induction reached with
+  | refl => exact pot
+  | step head _ ih =>
+    exact ih (by rw [Cursor.parentStep_sevm head]; exact hsg) (parentStep_pot head hsg pot)
+
+/-- A frame entered by a message starts with exactly the message's gas as its gas measure, so the
+gas premise is the statement that the message carried less than `2 ^ 256` gas. -/
+theorem gasMeasure_initDevm (msg : Msg) : (initDevm msg).gasMeasure = msg.gas := rfl
+
+theorem pot_of_gas {F : Exec.Deriv} (memory : F.devm.memory = Mem.empty)
+    (gas : F.devm.gasMeasure < 2 ^ 256) : FreePtr.Pot F.devm := by
+  unfold FreePtr.Pot
+  rw [memory]
+  exact gas
+
+/-! ## The `isBlocked(account)` query, at a free pointer `p` -/
+
+/-- ABI calldata of `isBlocked(address)` (selector `0xfbac3951`). -/
+def isBlockedData (account : Adr) : Bytes :=
+  [0xfb, 0xac, 0x39, 0x51] ++ account.toB256.toBytes
+
+/-- The memory an `onlyNotBlocked` site leaves before its second `MLOAD` of the free pointer:
+the selector word at `p`, the account word at `p + 4`. -/
+abbrev blockedMem (M : Mem) (p aw : B256) : Mem :=
+  ((M.read (Bytes.toB256 [0x40]).toNat 32).2.write p.toNat
+    (Bytes.toB256 [0xfb, 0xac, 0x39, 0x51] <<< (Bytes.toB256 [0xe0]).toNat).toBytes).write
+    (p + Bytes.toB256 [0x04]).toNat aw.toBytes
+
+theorem blocked_size (M : Mem) (p aw : B256) :
+    p.toNat + 32 ≤ ((blockedMem M p aw).read (Bytes.toB256 [0x40]).toNat 32).2.size := by
+  have h1 := size_write_window (M.read (Bytes.toB256 [0x40]).toNat 32).2 p.toNat
+    (Bytes.toB256 [0xfb, 0xac, 0x39, 0x51] <<< (Bytes.toB256 [0xe0]).toNat).toBytes
+    (by intro e; have := congrArg List.length e; rw [B256.length_toBytes] at this; cases this)
+  rw [B256.length_toBytes] at h1
+  exact h1.trans ((size_write_ge _ _ _).trans (size_read_ge _ _ _))
+
+theorem blocked_facts {M : Mem} {I : Bytes} {p aw : B256}
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = p.toBytes)
+    (lo : 96 ≤ p.toNat) (hi : p.toNat + 68 < 2 ^ 256) :
+    Bytes.toB256 ((blockedMem M p aw).read (Bytes.toB256 [0x40]).toNat 32).1 = p ∧
+    ∃ Iq : Bytes, Mem.Reads ((blockedMem M p aw).read (Bytes.toB256 [0x40]).toNat 32).2 Iq ∧
+      Mem.Wf ((blockedMem M p aw).read (Bytes.toB256 [0x40]).toNat 32).2 ∧
+      Iq.sliceD 64 32 0 = p.toBytes ∧
+      Iq.sliceD p.toNat 36 0 = [0xfb, 0xac, 0x39, 0x51] ++ aw.toBytes := by
+  have n40 : (Bytes.toB256 [0x40]).toNat = 64 := by decide
+  have n4 : (p + Bytes.toB256 [0x04]).toNat = p.toNat + 4 := by
+    rw [toNat_add_of_lt (by rw [show (Bytes.toB256 [0x04]).toNat = 4 by decide]; omega)]
+    rfl
+  have w0 : Mem.Wf (M.read (Bytes.toB256 [0x40]).toNat 32).2 := Mem.Wf.extend wf _ _
+  have r0 : Mem.Reads (M.read (Bytes.toB256 [0x40]).toNat 32).2 I := reads.extend _ _
+  have w1 := Mem.Wf.write w0 p.toNat
+    (Bytes.toB256 [0xfb, 0xac, 0x39, 0x51] <<< (Bytes.toB256 [0xe0]).toNat).toBytes
+  have r1 := r0.write w0 p.toNat
+    (Bytes.toB256 [0xfb, 0xac, 0x39, 0x51] <<< (Bytes.toB256 [0xe0]).toNat).toBytes
+  have w2 := Mem.Wf.write w1 (p + Bytes.toB256 [0x04]).toNat aw.toBytes
+  have r2 := r1.write w1 (p + Bytes.toB256 [0x04]).toNat aw.toBytes
+  have fp : (Bytes.writeAt (Bytes.writeAt I p.toNat (Bytes.toB256 [0xfb, 0xac, 0x39, 0x51] <<<
+      (Bytes.toB256 [0xe0]).toNat).toBytes) (p + Bytes.toB256 [0x04]).toNat aw.toBytes).sliceD
+      64 32 0 = p.toBytes := by
+    rw [n4, Bytes.sliceD_writeAt_before _ _ _ _ _ (by omega),
+      Bytes.sliceD_writeAt_before _ _ _ _ _ (by omega), ptr]
+  refine ⟨?_, _, r2.extend _ _, Mem.Wf.extend w2 _ _, fp, ?_⟩
+  · rw [r2.read, n40, fp, B256.toB256_toBytes]
+  · rw [n4, show (36 : Nat) = 4 + 32 from rfl, List.sliceD_split]
+    have back := Bytes.sliceD_writeAt
+      (Bytes.writeAt I p.toNat (Bytes.toB256 [0xfb, 0xac, 0x39, 0x51] <<<
+        (Bytes.toB256 [0xe0]).toNat).toBytes) aw.toBytes (p.toNat + 4)
+    rw [B256.length_toBytes] at back
+    rw [Bytes.sliceD_writeAt_before _ _ p.toNat 4 (p.toNat + 4) (by omega),
+      Bytes.sliceD_writeAt_inside _ _ p.toNat p.toNat 4 (by omega)
+        (by rw [B256.length_toBytes]; omega), Nat.sub_self, back]
+    rfl
+
+section BlockedAt
+
+variable {sevm : Sevm}
+
+def flagLineAt (lab : Bytes) (le : lab.length ≤ 32) : List Ninst :=
+  [.reg .iszero, .reg (.dup 0), .reg .iszero, .push lab le]
+
+theorem flag_line_at {lab : Bytes} {le : lab.length ≤ 32} {b d : Devm} {flag : B256}
+    {S : List B256} {M : Mem} {G : Nat}
+    (run : Line.Run sevm (St b (flag :: S) M G) (flagLineAt lab le) d) :
+    ∃ G', d = St b (Bytes.toB256 lab :: B256.eqCheck (B256.eqCheck flag 0) 0 ::
+      B256.eqCheck flag 0 :: S) M G' := by
+  stock_line
+  cases run
+  exact ⟨_, rfl⟩
+
+/-- **One `onlyNotBlocked(account)` site, from its `STATICCALL`.**  The site has laid out
+`isBlocked(account)` from the free pointer `p` (`blockedMem`, account word `aw`) and called the
+registry; a run that goes past the site's revert branches was answered `0`, and goes on at `cont`
+over the post-call world with the free pointer moved past the reply.  The step relation carries
+the memory potential (`potOf`), which bounds `p` below `2 ^ 160`. -/
+theorem blocked_at {P : Sevm → Devm → Ninst → Devm → Prop}
+    (project : ∀ {s d i d'}, P s d i d' → Ninst.Run s d i d')
+    (potOf : ∀ {s d i d'}, P s d i d' → FreePtr.Pot d)
+    (fork : CoveredFork sevm.benvStat.fork)
+    {b : Devm} {p aw gw t e s u : B256} {S : List B256} {M : Mem} {I : Bytes} {G : Nat}
+    {o : Outcome} {lab1 lab2 lab3 : Bytes} {le1 : lab1.length ≤ 32} {le2 : lab2.length ≤ 32}
+    {le3 : lab3.length ≤ 32} {dead1 dead2 cont : SFunc}
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = p.toBytes)
+    (lo : 96 ≤ p.toNat) (ht : t.toAdr = registry)
+    (dead1Ok : dead1.noOk = true) (dead2Ok : jumpsDead cert.prog dead2 = true)
+    (run : SFunc.RunP P cert.prog sevm
+      (St b (gw :: t :: Bytes.toB256 ((blockedMem M p aw).read (Bytes.toB256 [0x40]).toNat 32).1 ::
+        ((Bytes.toB256 [0x24] + p) -
+          Bytes.toB256 ((blockedMem M p aw).read (Bytes.toB256 [0x40]).toNat 32).1) ::
+        Bytes.toB256 ((blockedMem M p aw).read (Bytes.toB256 [0x40]).toNat 32).1 ::
+        Bytes.toB256 [0x20] :: e :: s :: u :: S)
+        ((blockedMem M p aw).read (Bytes.toB256 [0x40]).toNat 32).2 G)
+      (.next (.exec .staticcall) ((flagLineAt lab1 le1).foldr SFunc.next (.branch dead1
+        (.dest ((replyLineAt lab2 le2).foldr SFunc.next (.callNext 83
+          (.dest (.next (.reg .iszero) (.next (.push lab3 le3) (.branch dead2 cont)))))))))) o) :
+    ∃ (d : Devm) (out : Bytes) (M' : Mem) (I' : Bytes) (G' : Nat),
+      QuietFrom sevm b d ∧
+      StaticAnswered sevm b registry ([0xfb, 0xac, 0x39, 0x51] ++ aw.toBytes) out ∧
+      32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 0 ∧
+      Mem.Reads M' I' ∧ Mem.Wf M' ∧
+      I'.sliceD 64 32 0 = (bumpFp p out.length.toB256).toBytes ∧
+      96 ≤ (bumpFp p out.length.toB256).toNat ∧
+      SFunc.RunP P cert.prog sevm (St d S M' G') cont o := by
+  obtain ⟨d2, call, run⟩ := rpw_next run
+  have small : p.toNat + 32 < 2 ^ 160 :=
+    Nat.lt_of_le_of_lt (blocked_size M p aw) (FreePtr.Pot.size_lt (potOf call))
+  obtain ⟨fp2, Iq, rq, wq, pq, dq⟩ :=
+    blocked_facts (aw := aw) reads wf ptr lo (by omega)
+  rw [fp2, add_sub_cancel_right'] at call
+  obtain ⟨flag, out, post, bound, answered⟩ := ri_staticcall_bounded fork (project call)
+  have callStep := project call
+  rw [post.eq_St] at run callStep
+  have quiet : QuietFrom sevm b d2 := .step rfl callStep (.refl _)
+  obtain ⟨_, line, run⟩ := rpw_nexts project (flagLineAt lab1 le1) run
+  obtain ⟨_, rfl⟩ := flag_line_at line
+  rcases rpw_branch run with ⟨_, _, dead⟩ | ⟨accepted, _, run⟩
+  · exact (rpw_dead dead1Ok dead).elim
+  have flagOne : flag = 1 := by
+    rcases post.flag with zero | one
+    · subst zero
+      exact absurd (by decide : B256.eqCheck (B256.eqCheck (0 : B256) 0) 0 = 0) accepted
+    · exact one
+  have n36 : (Bytes.toB256 [0x24]).toNat = 36 := by decide
+  have n32 : (Bytes.toB256 [0x20]).toNat = 32 := by decide
+  have asked := answered flagOne
+  rw [ht, rq.read, n36, dq] at asked
+  obtain ⟨_, run⟩ := rpw_dest run
+  have r4 := (rq.extends [(p.toNat, (Bytes.toB256 [0x24]).toNat),
+    (p.toNat, (Bytes.toB256 [0x20]).toNat)]).write (Mem.Wf.extends _ wq) p.toNat
+    (out.take (Bytes.toB256 [0x20]).toNat)
+  have w4 := Mem.Wf.write (Mem.Wf.extends [(p.toNat, (Bytes.toB256 [0x24]).toNat),
+    (p.toNat, (Bytes.toB256 [0x20]).toNat)] wq) p.toNat (out.take (Bytes.toB256 [0x20]).toNat)
+  have p4 : (Bytes.writeAt Iq p.toNat (out.take (Bytes.toB256 [0x20]).toNat)).sliceD 64 32 0 =
+      p.toBytes := by
+    rw [Bytes.sliceD_writeAt_before _ _ _ _ _ (by omega), pq]
+  obtain ⟨_, line, run⟩ := rpw_nexts project _ run
+  obtain ⟨M5, I5, G5, rfl, r5, w5, keepReply, fp5⟩ := reply_line_at r4 w4 p4 lo line
+  rw [post.returnData] at run fp5
+  obtain ⟨_, D', callee, run⟩ :=
+    rpw_callOver (S' := [83, 18]) (g := t_29f1_c83) (by decide +kernel) rfl (by decide) run
+  obtain ⟨notShort, isBool, G6, rfl⟩ := decoder_returned_at project callee
+  obtain ⟨_, run⟩ := rpw_dest run
+  obtain ⟨_, step, run⟩ := rpw_next run
+  obtain ⟨_, rfl⟩ := ri_iszero (project step)
+  obtain ⟨_, step, run⟩ := rpw_next run
+  obtain ⟨_, rfl⟩ := ri_push (project step)
+  obtain ⟨guard, _, run⟩ := (rpw_branch run).resolve_left
+    (fun ⟨_, _, d⟩ => rpw_jumpsDead d dead2Ok)
+  have long : 32 ≤ out.length := by
+    have := le_toNat_of_not_slt notShort
+    rwa [B256.toNat_toB256_of_lt bound] at this
+  have short : out.length < 2 ^ 255 := by
+    have := lt_of_not_slt notShort
+    rwa [B256.toNat_toB256_of_lt bound] at this
+  have takeLen : (out.take 32).length = 32 := by
+    rw [List.length_take]
+    omega
+  have back := Bytes.sliceD_writeAt Iq (out.take 32) p.toNat
+  rw [takeLen] at back
+  have word : Bytes.toB256 (M5.read p.toNat 32).1 = Bytes.toB256 (out.take 32) := by
+    rw [r5.read, keepReply, n32, back]
+  have zero : Bytes.toB256 (out.take 32) = 0 := by
+    rw [← word]
+    exact B256.eqCheck_ne_zero_iff.mp guard
+  have bounds := bumpFp_bounds (p := p) (n := out.length.toB256)
+    (by rw [B256.toNat_toB256_of_lt (by omega)]; omega)
+  exact ⟨d2, out, _, I5, _, quiet, asked, long, zero, r5.extend _ _, Mem.Wf.extend w5 _ _, fp5,
+    by omega, run⟩
+
+end BlockedAt
+
+/-! ## The paused check, carrying the memory potential -/
+
+/-- `paused_cut` with the frame's potential: the run after the paused guard records the potential
+at every step. -/
+theorem paused_cut_pot {F : Exec.Deriv} {post : Devm} {t r : B256} {S : List B256}
+    {K : List SFunc} {lab : Bytes} {le : lab.length ≤ 32} {dead g : SFunc}
+    (cut : CursorStateAt code cert F
+      (.callNext 58 (.dest (.next (.reg .iszero) (.next (.push lab le) (.branch dead g)))))
+      F.devm (t :: r :: S) freeMem K)
+    (deadOk : dead.noOk = true)
+    (success : F.exn = .ok post) (fork : CoveredFork F.sevm.benvStat.fork)
+    (pot : FreePtr.Pot F.devm) :
+    UnpausedAnswered F ∧ ∃ (R : Exec.Deriv) (b' : Devm) (M' : Mem) (I' : Bytes) (G' : Nat)
+      (p : B256) (o : Outcome),
+      QuietFrom F.sevm F.devm b' ∧ Mem.Reads M' I' ∧ Mem.Wf M' ∧
+      I'.sliceD 64 32 0 = p.toBytes ∧ 96 ≤ p.toNat ∧
+      SFunc.RunP (FreePtr.PotStep (StepIn R)) cert.prog F.sevm (St b' S M' G') g o := by
+  have hsg := fork.histFork.neutral.stateGas
+  obtain ⟨G, state⟩ := cut.state
+  obtain ⟨outcome, run⟩ := cut.placed.sourceRunH cert_check (cut.exn_eq.trans success)
+    (by rw [cut.sevm_eq]; exact hsg)
+  have nodePot := parentPrefix_pot cut.free.1 hsg pot
+  rw [state] at nodePot
+  rw [cut.tree, state, cut.sevm_eq] at run
+  obtain ⟨run, -⟩ := FreePtr.SFunc.RunP.withPot (fun h => StepIn.toRun h) hsg run nodePot
+  have project : ∀ {s d i d'}, FreePtr.PotStep (StepIn cut.node) s d i d' →
+      Ninst.Run s d i d' := fun h => StepIn.toRun h.1
+  have onCode : F.sevm.code = code := by
+    rw [← cut.sevm_eq]; exact cut.placed.code_eq
+  have reads : Mem.Reads freeMem (Bytes.writeAt [] 64 (128 : B256).toBytes) :=
+    Mem.reads_empty.write Mem.wf_empty 64 _
+  have wf : Mem.Wf freeMem := Mem.Wf.write Mem.wf_empty 64 _
+  have ptr : (Bytes.writeAt [] 64 (128 : B256).toBytes).sliceD 64 32 0 = (128 : B256).toBytes := by
+    decide
+  obtain ⟨_, D, callee, run⟩ := rpw_callOver (S' := [58, 83, 18]) (g := t_0dc8_c58)
+    (by decide +kernel) rfl (by decide) run
+  obtain ⟨b', w, M', G', rfl, facts⟩ :=
+    paused_returned project fork onCode reads wf ptr (by decide) callee
+  stock_run
+  obtain ⟨guard, _, run⟩ := (rpw_branch run).resolve_left (fun ⟨_, _, d⟩ => rpw_dead deadOk d)
+  obtain ⟨flagClear, quiet, out, I', answered, long, word, short, r', w', fp, _⟩ :=
+    facts (B256.eqCheck_ne_zero_iff.mp guard)
+  have bounds := bumpFp_bounds (p := 128) (n := out.length.toB256)
+    (by rw [show (128 : B256).toNat = 128 by decide, B256.toNat_toB256_of_lt (by omega)]; omega)
+  rw [show (128 : B256).toNat = 128 by decide] at bounds
+  exact ⟨⟨flagClear, out, answered, long, word⟩, cut.node, b', M', I', _, _, _, quiet, r', w', fp,
+    by omega, run⟩
+
+/-- `paused_after_role` with the frame's potential: after the role query and the paused guard,
+the run goes on over a world reached quietly, the free pointer above `96`. -/
+theorem paused_after_role_pot {F : Exec.Deriv} {post : Devm} {g dead : SFunc} {t R c : B256}
+    {S : List B256} {K : List SFunc} {lab lab2 : Bytes} {le : lab.length ≤ 32}
+    {le2 : lab2.length ≤ 32}
+    (cut : CursorStateAt code cert F (.callNext 88 (.dest (.next (.push lab le)
+      (.next (.push [0x0d, 0xc8] (by decide)) (.callNext 58 (.dest (.next (.reg .iszero)
+        (.next (.push lab2 le2) (.branch dead g))))))))) F.devm (t :: R :: c :: S) freeMem K)
+    (deadOk : dead.noOk = true)
