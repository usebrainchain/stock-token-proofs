+  obtain ⟨d2, out2, M2, I2, G2, quiet2, ans2, long2, zero2, r2, w2, fp2, lo2, run⟩ :=
+    blocked_at project potOf fork r1 w1 fp1 lo1 (by decide) rfl (by decide +kernel) run
+  rw [blocked_data_left] at ans2
+  stock_run
+  obtain ⟨_, step, run⟩ := rpw_next run
