new file mode 100755
index 0000000..66ebd63
--- /dev/null
+++ b/scripts/stock-controls/pause-norole.sh
@@ -0,0 +1,101 @@
+#!/usr/bin/env bash
+# Planted-mutant control for Blanc.Lift.Stock.pause_requires_role.
+#
+# The mutant is the deployed Stock runtime with pause()'s onlyRole call cut out: in the
+# function body at 0x1087, `DUP2 PUSH2 0x1954 JUMP` (the call into _checkRole) becomes
+# `JUMP STOP STOP STOP STOP`, so the body jumps straight to its continuation at 0x10b1 with the
+# same stack and sets the paused flag without asking the registry.  The producer lifts the
+# mutant (its certificate must check: the failure has to come from the theorem, not from the
+# certificate), Pause.lean is replayed against it with the entry numbering moved to the
+# mutant's (one new entry, 0x10b1, at index 103), and the replay must fail inside the role
+# walk `enter_check`.  On the deployed bytes the same file must elaborate.
+set -u
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT"
+WORK="$ROOT/.lake/stock-controls"
+rm -rf "$WORK"; mkdir -p "$WORK"
+
+python3 - "$ROOT/scripts/lift/inputs/stock-runtime.hex" "$WORK/mutant.hex" <<'PY'
+import hashlib, sys
+src, dst = sys.argv[1], sys.argv[2]
+h = open(src).read().strip()
+b = bytearray.fromhex(h[2:] if h.startswith("0x") else h)
+assert hashlib.sha256(b).hexdigest() == "0ac99e9cc7a3738645af72f6d9e8fb8242660b63134d8fb0c44ba6fac39deec2"
+assert b[0x10a9:0x10b2] == bytes.fromhex("6110b181611954565b"), b[0x10a9:0x10b2].hex()
+b[0x10ac:0x10b1] = bytes.fromhex("5600000000")
+open(dst, "w").write(b.hex() + "\n")
+print("mutant sha256", hashlib.sha256(b).hexdigest())
+PY
+sha=$(python3 -c "import hashlib,sys;print(hashlib.sha256(bytes.fromhex(open(sys.argv[1]).read().strip())).hexdigest())" "$WORK/mutant.hex")
+python3 scripts/lift/lift.py --hex "$WORK/mutant.hex" --sha256 "$sha" --namespace Blanc.Lift.StockNoRole \
+  --fold --cert-out "$WORK/Cert.lean" --check-out "$WORK/Check.lean" --check-literal-tries \
+  --check-split-nodes 1000 --check-ranges 600 | grep -E "Counts|verdict" || exit 2
+
+python3 - "$WORK" Blanc/Lift/Stock/Pause.lean <<'PY'
+import re, sys
+work, pause = sys.argv[1], sys.argv[2]
+cert = open(f"{work}/Cert.lean").read()
+check = open(f"{work}/Check.lean").read()
+body = open(pause).read()
+assert "(⟨0x10b1, [.unk, .ret], 0⟩, t_10b1_c103)," in cert
+
+def split(src):
+    lines = src.splitlines()
+    imps = [l for l in lines if l.startswith("import ")]
+    rest = [l for l in lines if not l.startswith("import ")]
+    return imps, "\n".join(rest)
+
+ci, cb = split(cert)
+ki, kb = split(check)
+pi, pb = split(body)
+def shift(m):
+    k = int(m.group(2))
+    return f"{m.group(1)}{k + 1 if k >= 103 else k}"
+pb = pb.replace("t_10b1_c54", "t_10b1_c103")
+pb = re.sub(r"(t_[0-9a-f]{4}_c)(\d+)\b", shift, pb)
+pb = pb.replace("namespace Blanc.Lift.Stock\n", "namespace Blanc.Lift.StockNoRole\n")
+pb = pb.replace("end Blanc.Lift.Stock\n", "end Blanc.Lift.StockNoRole\n")
+imports = []
+for l in ci + ki + pi:
+    if l in ("import Blanc.Lift.StockNoRole.Cert", "import Blanc.Lift.Stock.Jumps"):
+        continue
+    if l not in imports:
+        imports.append(l)
+head = "\n".join(imports) + "\n"
+pre = head + cb + "\n" + kb + "\n"
+open(f"{work}/Mutant.lean", "w").write(pre + pb + "\n")
+start = pre.count("\n") + 1
+m = re.search(r"private theorem enter_check", pb)
+a = pre.count("\n") + pb[:m.start()].count("\n") + 1
+e = pre.count("\n") + pb[:pb.index("/-! ## The query, the decoder")].count("\n") + 1
+open(f"{work}/spans", "w").write(f"{start} {a} {e}\n")
+open(f"{work}/Positive.lean", "w").write(
+    "\n".join(l for l in body.splitlines()) + "\n")
+PY
+read pstart astart aend < "$WORK/spans"
+
+echo "-- deployed bytes: Pause.lean as committed"
+(lake env lean "$WORK/Positive.lean" > "$WORK/positive.out" 2>&1) || {
+  echo "FAIL positive control: the committed proof does not elaborate"; cat "$WORK/positive.out"; exit 1; }
+echo "   elaborates"
+
+echo "-- mutant bytes (onlyRole cut from pause())"
+lake env lean "$WORK/Mutant.lean" > "$WORK/mutant.out" 2>&1
+rc=$?
+if [[ $rc -eq 0 ]]; then
+  echo "FAIL mutant control: the proof elaborated on the mutant"; exit 1
+fi
+first=$(grep -oE "Mutant.lean:[0-9]+:[0-9]+: error" "$WORK/mutant.out" | head -1 | cut -d: -f2)
+if [[ -z "$first" ]]; then
+  echo "FAIL mutant control: no located error"; cat "$WORK/mutant.out" | head -20; exit 1
+fi
+if (( first < pstart )); then
+  echo "FAIL mutant control: the mutant certificate itself failed at line $first"; exit 1
+fi
+if (( first < astart || first >= aend )); then
+  echo "FAIL mutant control: first error at line $first, outside enter_check [$astart, $aend)"
+  grep -A3 "error" "$WORK/mutant.out" | head -20; exit 1
+fi
+echo "   rejected: certificate checks, first error at line $first inside enter_check [$astart, $aend):"
+grep -A2 "Mutant.lean:$first:" "$WORK/mutant.out" | head -4 | sed 's/^/     /'
+echo "OK — pause_requires_role: holds on the deployed bytes, fails in the role walk on the no-role mutant"
