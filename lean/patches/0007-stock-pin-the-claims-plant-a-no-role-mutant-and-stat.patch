index 0000000..a6e1384
--- /dev/null
+++ b/scripts/stock-controls/statement-mutants.py
@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+"""Statement mutants for the Stock theorems.
+
+usage: statement-mutants.py SPEC.json
+
+SPEC: {"file": "Blanc/Lift/Stock/X.lean", "theorems": {NAME: [[label, old, new], ...]}}
+
+For every mutant, the theorem is copied under a fresh name with `old` replaced by `new` in its
+statement only (the text before its first `:= by`), and every copy is appended to one copy of
+the file, elaborated once with `lake env lean`.  The control passes when the unmodified part
+elaborates without an error and every mutant copy carries an error inside its own lines.
+"""
+import json, re, subprocess, sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+spec = json.load(open(sys.argv[1]))
+src = (ROOT / spec["file"]).read_text()
+lines = src.splitlines()
+end_ns = max(i for i, l in enumerate(lines) if l.startswith("end "))
+
+
+def block(name):
+    start = next(i for i, l in enumerate(lines) if re.match(rf"(private )?theorem {re.escape(name)}\b", l))
+    j = start + 1
+    while j < len(lines) and lines[j].strip() and not re.match(r"(theorem|private|/--|/-!|end |def |abbrev )", lines[j]):
+        j += 1
+    while start > 0 and lines[start - 1].startswith(("/--", " ", "  ")) and "-/" in "\n".join(lines[start - 6:start]):
+        break
+    return "\n".join(lines[start:j])
+
+
+out = lines[:end_ns]
+spans = []
+for name, mutants in spec["theorems"].items():
+    text = block(name)
+    head, sep, proof = text.partition(":= by")
+    assert sep, name
+    for label, old, new in mutants:
+        assert old in head, (name, label, old)
+        copy = head.replace(old, new, 1) + sep + proof
+        copy = re.sub(rf"theorem {re.escape(name)}\b", f"theorem {name}_mutant_{label}", copy, count=1)
+        out.append("")
+        a = len(out) + 1
+        out.extend(copy.splitlines())
+        spans.append((f"{name}/{label}", a, len(out)))
+out.extend(lines[end_ns:])
+work = ROOT / ".lake" / "stock-controls"
+work.mkdir(parents=True, exist_ok=True)
+target = work / ("Mutants_" + Path(spec["file"]).stem + ".lean")
+target.write_text("\n".join(out) + "\n")
+res = subprocess.run(["lake", "env", "lean", str(target)], cwd=ROOT, capture_output=True, text=True)
+errs = [int(m.group(1)) for m in re.finditer(rf"{re.escape(target.name)}:(\d+):\d+: error", res.stdout + res.stderr)]
+first_span = spans[0][1] if spans else len(out)
+ok = True
+base = [e for e in errs if e < first_span - 1]
+if base:
+    print(f"FAIL unmodified part has errors at lines {base}")
+    ok = False
+for label, a, b in spans:
+    hit = [e for e in errs if a <= e <= b]
+    if hit:
+        msg = next((l for l in (res.stdout + res.stderr).splitlines() if f":{hit[0]}:" in l), "")
+        print(f"  rejected {label}: error at line {hit[0]} ({msg.split('error:')[-1].strip()[:90]})")
+    else:
+        print(f"FAIL {label}: no error inside lines {a}-{b}")
+        ok = False
+print(("OK" if ok else "REGRESSION") + f" — {len(spans)} statement mutants of {spec['file']}")
+sys.exit(0 if ok else 1)
