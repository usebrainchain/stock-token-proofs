index c63069b..1053989 100644
--- a/scripts/ClaimCheck.lean
+++ b/scripts/ClaimCheck.lean
@@ -88,6 +88,7 @@ import Blanc.Lift.RootMessages
 -- `open private` below; no longer reached transitively under mathlib 4.35.
 import Batteries.Tactic.OpenPrivate
 import Blanc.Lift.Usdc.AllowanceQuiet
