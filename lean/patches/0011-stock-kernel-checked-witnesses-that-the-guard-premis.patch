+import Blanc.Lift.Stock.Registry.Cert
+import Blanc.Lift.CheckFast
+
+/-! GENERATED by scripts/lift/lift.py (registered in scripts/lift/certificates.json) -- do not edit.
+Each entry is decided against trie-backed reads of the exact runtime.
+The generic equality rewrites each result to the unchanged Cert.check. -/
+
+namespace Blanc.Lift.Stock.Registry
+
+open Jaune
+
+/-- Depth 5 covers all 17 runtime byte positions. -/
+def codeTries : CodeTries code 5 :=
+  CodeTries.ofCode code 5 (by decide +kernel) (by decide +kernel)
+
+theorem entry_0 :
+    checkNode code (Cert.entries cert) 0 0x0 [] t_0000_c0 = true := by
+  rw [← checkNodeT_eq codeTries]
+  decide +kernel
+
+theorem cert_check : Cert.check code cert = true := by
+  unfold Cert.check
+  rw [Bool.and_eq_true]
+  refine ⟨by decide +kernel, ?_⟩
+  rw [List.all_eq_true]
+  intro p hp
+  simp only [cert, List.mem_cons, List.not_mem_nil, or_false] at hp
+  rcases hp with rfl
+  · exact entry_0
+
+end Blanc.Lift.Stock.Registry
diff --git a/Blanc/Lift/Stock/Witness.lean b/Blanc/Lift/Stock/Witness.lean
new file mode 100644
index 0000000..47a9747
--- /dev/null
+++ b/Blanc/Lift/Stock/Witness.lean
@@ -0,0 +1,455 @@
+import Blanc.Lift.Stock.InRun
+import Blanc.Lift.Stock.Blocked
+import Blanc.Lift.WitnessStatic
+import Blanc.Lift.Stock.Registry.Check
+import Blanc.ConcreteRun
+
+/-!
+# Stock: the premises of the role, pause and blocklist theorems are satisfiable
+
+For each entry point below, a concrete run of Stock's deployed bytes, checked by the kernel, for
+which every premise of that entry's theorems holds and the run succeeds; each `*_witness` then
+applies the theorems to the run, so their conclusions are exhibited on it.
+
+The world has two accounts and no storage beyond what a witness writes: Stock's runtime (`code`,
+sha256 `0ac99e9c…`) at `tokenAddress`, and at the access registry `0xe10b…1b00` a 17-byte stand-in
+(`Registry.code`, registered as `stock-registry-stub`) that answers `hasRole(bytes32,address)` with
+the word `1` and every other query, `paused()` and `isBlocked(address)` among them, with `0`.  So
+the caller (`callerAddress`) holds every role, the registry reports no global pause, and no account
+is blocked.  Stock itself is unpaused except in the `unpause()` witness, which starts from its paused
+slot at `1`.  Each message carries no value and a million gas, on Prague
+(`(default : BenvStat).fork`), at the outermost call depth, with an empty stack and memory.
+
+Each run is computed by `wrunS` (Blanc's witness interpreter with `CODECOPY`, `ADDMOD`, `MULMOD`
+and `STATICCALL`s whose child is run by the stand-in's own certificate) and checked by
+`kernel_rfl`; `wrunS_done` and `lift_exact` turn it into an `Exec` of the deployed bytes.  The
+registry's code is part of the world, and its runs are checked like the token's.
+
+Covered: `pause`, `unpause` (role, role in run), `mint`, `burn` (role, role in run, unpaused,
+unblocked), `adminBurn`, `pauseOracle`, `unpauseOracle`, `setMetadata` (role, role in run),
+`transfer`, `transferFrom`, `approve` (unpaused, unblocked), `updateMultiplier(uint256)` and
+`updateMultiplier(uint256,uint256)` (unpaused, role after the pause check).  Not covered: `permit`,
+whose run needs a valid signature checked by the `ecrecover` precompile, which this interpreter
+does not run.
+-/
+
+namespace Blanc.Lift.Stock.Witnesses
+
+open Jaune Blanc Blanc.Lift Blanc.Lift.Witness Blanc.ConcreteRun
+
+/-- Where the witness places Stock's runtime. -/
+def tokenAddress : Adr := 0x7070707070707070707070707070707070707070
+
+/-- The witness's caller. -/
+def callerAddress : Adr := 0xcafecafecafecafecafecafecafecafecafecafe
+
+/-- The accounts: the registry stand-in and Stock's runtime, no storage. -/
+def accts : List (Adr × Acct) :=
+  [(registry, ⟨1, 0, .empty, Registry.code⟩), (tokenAddress, ⟨1, 0, .empty, code⟩)]
+
+def world0 : State := stateFoldAcct default accts
+
+/-- The world with the storage writes `ws` on top. -/
+def worldOf (ws : List ((Adr × B256) × B256)) : State := stateFoldStor world0 ws
+
+def gas0 : Nat := 1000000
+
+/-- The message environment for calldata `data`. -/
+def sevmOf (ws : List ((Adr × B256) × B256)) (data : Bytes) : Sevm :=
+  { (default : Sevm) with
+    caller := callerAddress
+    target := some tokenAddress
+    currentTarget := tokenAddress
+    gas := gas0
+    value := 0
+    data := data
+    codeAddress := some tokenAddress
+    code := code
+    depth := 1024
+    benvStat := { (default : BenvStat) with origState := worldOf ws } }
+
+/-- The frame's starting machine: the world, the gas, empty stack and memory. -/
+def preOf (ws : List ((Adr × B256) × B256)) : Devm :=
+  ((default : Devm).withGasLeft gas0).withState (worldOf ws)
+
+def cfgOf (ws : List ((Adr × B256) × B256)) : Cfg :=
+  ⟨preOf ws, t_0000_c0, [], [], [], storShadowOf ws, acctShadowOf accts⟩
+
+theorem cfgOf_agree (ws : List ((Adr × B256) × B256)) : Agree (cfgOf ws) := by
+  refine ⟨fun x => ?_, fun a => ?_, ?_, ?_⟩
+  · show x ∈ (default : Devm).accessedStorageKeys ↔ x ∈ ([] : List (Adr × B256))
+    simp only [show (default : Devm).accessedStorageKeys = .emptyWithCapacity from rfl,
+      Std.HashSet.not_mem_emptyWithCapacity, List.not_mem_nil]
+  · show a ∈ (default : Devm).accessedAddresses ↔ a ∈ ([] : List Adr)
+    simp only [show (default : Devm).accessedAddresses = .emptyWithCapacity from rfl,
+      Std.HashSet.not_mem_emptyWithCapacity, List.not_mem_nil]
+  · exact storOf_stateFoldStor ws (storOf_stateFoldAcct accts)
+  · exact acctAgree_stateFoldStor ws (acctAgree_stateFoldAcct accts)
+
+theorem registry_jumpsOk : Cert.jumpsOk Registry.code Registry.cert = true := by decide +kernel
+
+/-- Every `STATICCALL` runs the stand-in by its certificate. -/
+def child : StaticChild := ⟨Registry.cert.prog, Registry.code, 20⟩
+
+theorem child_sound : child.Sound := fun hcode hfork hr =>
+  lift_exact_noStateGas Registry.cert_check registry_jumpsOk hcode hfork.rules_stateGas_none hr
+
+theorem default_covered : CoveredFork (default : BenvStat).fork :=
+  of_decide_eq_true (by decide +kernel)
+
+theorem prague_shanghai {ws : List ((Adr × B256) × B256)} {data : Bytes} :
+    ShanghaiOnwards (sevmOf ws data).benvStat.fork :=
+  show ShanghaiOnwards (default : BenvStat).fork by decide +kernel
+
+/-- A run that halted without error, with its final storage shadow passing `q`. -/
+def haltedWith (q : StorShadow → Bool) : Res → Bool
+  | .done (.halted d) cl => d.error.isNone && q cl.stor
+  | _ => false
+
+/-- A kernel-checked `haltedWith` run is an `Exec` of Stock's bytes that succeeds, and its final
+storage is the one `q` accepted. -/
+theorem exec_of_haltedWith {ws : List ((Adr × B256) × B256)} {data : Bytes} {n : Nat}
+    {q : StorShadow → Bool}
+    (h : haltedWith q (wrunS child cert.prog (sevmOf ws data) n (cfgOf ws)) = true) :
+    ∃ post, Nonempty (Exec 0 (sevmOf ws data) (preOf ws) (.ok post)) ∧ post.error = none ∧
+      ∃ st : StorShadow, q st = true ∧ ∀ a k, storOf post.state a k = lookupS st a k := by
+  generalize hr : wrunS child cert.prog (sevmOf ws data) n (cfgOf ws) = r at h
+  rcases r with _ | ⟨d | d, cl⟩ | _
+  · simp only [haltedWith, Bool.false_eq_true] at h
+  · simp only [haltedWith, Bool.and_eq_true] at h
+    obtain ⟨run, hag, hst⟩ := wrunS_done child_sound hr (cfgOf_agree ws)
+    refine ⟨d, lift_exact cert_check jumps_ok rfl prague_shanghai ⟨t_0000_c0, rfl, run⟩,
+      Option.isNone_iff_eq_none.mp h.1, cl.stor, h.2, fun a k => ?_⟩
+    rw [hst d rfl]
+    exact hag.2.2.1 a k
+  · simp only [haltedWith, Bool.false_eq_true] at h
+  · simp only [haltedWith, Bool.false_eq_true] at h
+
+theorem fork_covered (ws : List ((Adr × B256) × B256)) (data : Bytes) :
+    CoveredFork (sevmOf ws data).benvStat.fork :=
+  default_covered
+
+/-- The premises shared by the role and pause theorems, for selector `sel`. -/
+def Premises (F : Exec.Deriv) (sel : B256) (post : Devm) : Prop :=
+  F.pc = 0 ∧ F.sevm.code = code ∧ F.devm.stack = [] ∧ F.devm.memory = Mem.empty ∧
+    Sevm.selector F.sevm = sel ∧ F.exn = .ok post ∧ CoveredFork F.sevm.benvStat.fork
+
+theorem premises_of_exec {ws : List ((Adr × B256) × B256)} {data : Bytes} {post : Devm}
+    {sel : B256} (e : Exec 0 (sevmOf ws data) (preOf ws) (.ok post))
+    (hsel : Sevm.selector (sevmOf ws data) = sel) :
+    Premises ⟨0, sevmOf ws data, preOf ws, .ok post, e⟩ sel post :=
+  ⟨rfl, rfl, rfl, rfl, hsel, rfl, fork_covered ws data⟩
+
+theorem gasMeasure_preOf (ws : List ((Adr × B256) × B256)) : (preOf ws).gasMeasure = gas0 := rfl
+
+/-- A kernel-checked successful run, as a derivation satisfying the shared premises and the gas
+premise of the blocklist theorems. -/
+theorem witness_of_kernel {ws : List ((Adr × B256) × B256)} {data : Bytes} {n : Nat}
+    {q : StorShadow → Bool} {sel : B256}
+    (h : haltedWith q (wrunS child cert.prog (sevmOf ws data) n (cfgOf ws)) = true)
+    (hsel : Sevm.selector (sevmOf ws data) = sel) :
+    ∃ (F : Exec.Deriv) (post : Devm), Premises F sel post ∧ F.devm.gasMeasure < 2 ^ 256 ∧
+      F.sevm = sevmOf ws data ∧ F.devm = preOf ws ∧ post.error = none ∧
+      ∃ st : StorShadow, q st = true ∧ ∀ a k, storOf post.state a k = lookupS st a k := by
+  obtain ⟨post, ⟨e⟩, herr, st, hq, hst⟩ := exec_of_haltedWith h
+  refine ⟨_, post, premises_of_exec e hsel, ?_, rfl, rfl, herr, st, hq, hst⟩
+  show (preOf ws).gasMeasure < 2 ^ 256
+  rw [gasMeasure_preOf]
+  decide
+
+/-- Any storage. -/
+def anyStor (_ : StorShadow) : Bool := true
+
+/-- A second account, used as recipient, spender or burn target. -/
+def otherAddress : Adr := 0xbeefbeefbeefbeefbeefbeefbeefbeefbeefbeef
+
+/-! ## `pause()` -/
+
+def pauseData : Bytes := [0x84, 0x56, 0xcb, 0x59]
+
+/-- The token's paused slot holds `v`. -/
+def pausedIs (v : B256) (st : StorShadow) : Bool := decide (lookupS st tokenAddress pausedSlot = v)
+
+theorem pause_kernel :
+    haltedWith (pausedIs 1) (wrunS child cert.prog (sevmOf [] pauseData) 250 (cfgOf [])) = true := by
+  kernel_rfl
+
+theorem pause_selector : Sevm.selector (sevmOf [] pauseData) = pauseSelector := by decide +kernel
+
+/-- **The premises of `pause_requires_role` and `pause_role_in_run` hold together.**  The run of
+`pause()` from `preOf []` (Stock unpaused, the registry stand-in at `registry`) succeeds, and it
+leaves Stock's paused slot at `1`. -/
+theorem pause_premises_hold :
+    ∃ (F : Exec.Deriv) (post : Devm), Premises F pauseSelector post ∧
+      F.sevm = sevmOf [] pauseData ∧ F.devm = preOf [] ∧ post.error = none ∧
+      storOf (preOf []).state tokenAddress pausedSlot = 0 ∧
+      storOf post.state tokenAddress pausedSlot = 1 := by
+  obtain ⟨post, ⟨e⟩, herr, st, hq, hst⟩ := exec_of_haltedWith pause_kernel
+  refine ⟨_, post, premises_of_exec e pause_selector, rfl, rfl, herr,
+    storOf_stateFoldStor [] (storOf_stateFoldAcct accts) _ _, ?_⟩
+  rw [hst]
+  exact of_decide_eq_true hq
+
+/-- **`pause_requires_role` and `pause_role_in_run` are not vacuous**: on the witness run both
+conclusions hold, the role query asked by the run itself. -/
+theorem pause_witness :
+    ∃ (F : Exec.Deriv) (post : Devm), Premises F pauseSelector post ∧ post.error = none ∧
+      RoleCalled F tokenPauserRole ∧
+      ∃ out : Bytes,
+        StaticAnswered F.sevm F.devm registry (hasRoleData tokenPauserRole F.sevm.caller) out ∧
+        32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 1 := by
+  obtain ⟨F, post, hp, -, -, herr, -⟩ := pause_premises_hold
+  obtain ⟨pc, onCode, stack, memory, sel, success, fork⟩ := hp
+  exact ⟨F, post, ⟨pc, onCode, stack, memory, sel, success, fork⟩, herr,
+    pause_role_in_run pc onCode stack memory sel success fork,
+    pause_requires_role pc onCode stack memory sel success fork⟩
+
+/-! ## `unpause()` -/
+
+def unpauseData : Bytes := [0x3f, 0x4b, 0xa8, 0x3a]
+
+/-- Stock paused: its paused slot at `1`. -/
+def pausedWrites : List ((Adr × B256) × B256) := [((tokenAddress, pausedSlot), 1)]
+
+theorem unpause_kernel :
+    haltedWith (pausedIs 0)
+      (wrunS child cert.prog (sevmOf pausedWrites unpauseData) 250 (cfgOf pausedWrites)) = true := by
+  kernel_rfl
+
+theorem unpause_selector : Sevm.selector (sevmOf pausedWrites unpauseData) = unpauseSelector := by
+  decide +kernel
+
+/-- **The premises of `unpause_requires_role` and `unpause_role_in_run` hold together.**  From
+Stock paused, the run of `unpause()` succeeds and leaves the paused slot at `0`. -/
+theorem unpause_premises_hold :
+    ∃ (F : Exec.Deriv) (post : Devm), Premises F unpauseSelector post ∧
+      F.sevm = sevmOf pausedWrites unpauseData ∧ F.devm = preOf pausedWrites ∧
+      post.error = none ∧ storOf (preOf pausedWrites).state tokenAddress pausedSlot = 1 ∧
+      storOf post.state tokenAddress pausedSlot = 0 := by
+  obtain ⟨post, ⟨e⟩, herr, st, hq, hst⟩ := exec_of_haltedWith unpause_kernel
+  refine ⟨_, post, premises_of_exec e unpause_selector, rfl, rfl, herr, ?_, ?_⟩
+  · rw [show (preOf pausedWrites).state =
+        stateFoldStor (stateFoldAcct default accts) pausedWrites from rfl,
+      storOf_stateFoldStor pausedWrites (storOf_stateFoldAcct accts)]
+    decide +kernel
+  · rw [hst]
+    exact of_decide_eq_true hq
+
+theorem unpause_witness :
+    ∃ (F : Exec.Deriv) (post : Devm), Premises F unpauseSelector post ∧ post.error = none ∧
+      RoleCalled F tokenPauserRole ∧
+      ∃ out : Bytes,
+        StaticAnswered F.sevm F.devm registry (hasRoleData tokenPauserRole F.sevm.caller) out ∧
+        32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 1 := by
+  obtain ⟨F, post, hp, -, -, herr, -⟩ := unpause_premises_hold
+  obtain ⟨pc, onCode, stack, memory, sel, success, fork⟩ := hp
+  exact ⟨F, post, ⟨pc, onCode, stack, memory, sel, success, fork⟩, herr,
+    unpause_role_in_run pc onCode stack memory sel success fork,
+    unpause_requires_role pc onCode stack memory sel success fork⟩
+
+/-! ## Role-first entry points with arguments: `mint`, `burn`, `adminBurn` -/
+
+/-- `mint(otherAddress, 1000)`. -/
+def mintData : Bytes :=
+  [0x40, 0xc1, 0x0f, 0x19] ++ otherAddress.toB256.toBytes ++ (1000 : B256).toBytes
+
+theorem mint_kernel :
+    haltedWith anyStor (wrunS child cert.prog (sevmOf [] mintData) 2000 (cfgOf [])) = true := by
+  kernel_rfl
+
+theorem mint_witness :
+    ∃ (F : Exec.Deriv) (post : Devm), Premises F mintSelector post ∧ post.error = none ∧
+      RoleAnswered F minterRole ∧ RoleCalled F minterRole ∧ UnpausedAnsweredAfter F ∧
+      (BlockedClear F (argAdr F.sevm 0) ∧ BlockedClear F F.sevm.caller) := by
+  obtain ⟨F, post, ⟨pc, onCode, stack, memory, sel, success, fork⟩, gas, -, -, herr, -⟩ :=
+    witness_of_kernel (sel := mintSelector) mint_kernel (by decide +kernel)
+  exact ⟨F, post, ⟨pc, onCode, stack, memory, sel, success, fork⟩, herr,
+    mint_requires_role pc onCode stack memory sel success fork,
+    mint_role_in_run pc onCode stack memory sel success fork,
+    mint_requires_unpaused pc onCode stack memory sel success fork,
+    mint_requires_unblocked pc onCode stack memory sel success fork gas⟩
+
+/-- `burn(otherAddress, 0)`. -/
+def burnData : Bytes :=
+  [0x9d, 0xc2, 0x9f, 0xac] ++ otherAddress.toB256.toBytes ++ (0 : B256).toBytes
+
+theorem burn_kernel :
+    haltedWith anyStor (wrunS child cert.prog (sevmOf [] burnData) 2000 (cfgOf [])) = true := by
+  kernel_rfl
+
+theorem burn_witness :
+    ∃ (F : Exec.Deriv) (post : Devm), Premises F burnSelector post ∧ post.error = none ∧
+      RoleAnswered F burnerRole ∧ RoleCalled F burnerRole ∧ UnpausedAnsweredAfter F ∧
+      (BlockedClear F (argAdr F.sevm 0) ∧ BlockedClear F F.sevm.caller) := by
+  obtain ⟨F, post, ⟨pc, onCode, stack, memory, sel, success, fork⟩, gas, -, -, herr, -⟩ :=
+    witness_of_kernel (sel := burnSelector) burn_kernel (by decide +kernel)
+  exact ⟨F, post, ⟨pc, onCode, stack, memory, sel, success, fork⟩, herr,
+    burn_requires_role pc onCode stack memory sel success fork,
+    burn_role_in_run pc onCode stack memory sel success fork,
+    burn_requires_unpaused pc onCode stack memory sel success fork,
+    burn_requires_unblocked pc onCode stack memory sel success fork gas⟩
+
+/-- `adminBurn(otherAddress, 0)`. -/
+def adminBurnData : Bytes :=
+  [0x06, 0xdd, 0x04, 0x19] ++ otherAddress.toB256.toBytes ++ (0 : B256).toBytes
+
+theorem adminBurn_kernel :
+    haltedWith anyStor (wrunS child cert.prog (sevmOf [] adminBurnData) 2000 (cfgOf [])) = true := by
+  kernel_rfl
+
+theorem adminBurn_witness :
+    ∃ (F : Exec.Deriv) (post : Devm), Premises F adminBurnSelector post ∧ post.error = none ∧
+      RoleAnswered F adminBurnerRole ∧ RoleCalled F adminBurnerRole := by
+  obtain ⟨F, post, ⟨pc, onCode, stack, memory, sel, success, fork⟩, -, -, -, herr, -⟩ :=
+    witness_of_kernel (sel := adminBurnSelector) adminBurn_kernel (by decide +kernel)
