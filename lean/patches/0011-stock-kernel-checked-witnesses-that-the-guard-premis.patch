+import Blanc.Lift.Check
+
+/-! GENERATED by scripts/lift/lift.py (registered in scripts/lift/certificates.json) -- do not edit.
+The producer is untrusted; Check.cert_check checks this data. -/
+
+namespace Blanc.Lift.Stock.Registry
+
+open Jaune
+
+-- Code: 17 bytes, SHA-256: 8796cb1f70e6218dd600cb93cb5cb58c96bc24c709b4b43dc4bbd8609da62634
+def code : ByteArray := ⟨#[
+  0x5f, 0x35, 0x60, 0xe0, 0x1c, 0x63, 0x91, 0xd1, 0x48, 0x54, 0x14, 0x5f, 0x52, 0x60, 0x20, 0x5f,
+  0xf3
+]⟩
+
+def t_0000_c0 : SFunc := (.next (.push [] (by decide)) (.next (.reg .calldataload) (.next (.push [0xe0] (by decide)) (.next (.reg .shr) (.next (.push [0x91, 0xd1, 0x48, 0x54] (by decide)) (.next (.reg .eq) (.next (.push [] (by decide)) (.next (.reg .mstore) (.next (.push [0x20] (by decide)) (.next (.push [] (by decide)) (.last .return_)))))))))))
+
+def cert : Cert := [
+  (⟨0x0, [], 0⟩, t_0000_c0)
+]
+
+end Blanc.Lift.Stock.Registry
