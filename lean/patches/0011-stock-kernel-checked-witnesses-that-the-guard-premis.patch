+#!/usr/bin/env bash
+# Control for the non-vacuity witnesses in Blanc/Lift/Stock/Witness.lean.
+#
+# The witnesses run the deployed bytes against a registry stand-in that grants every role.  This
+# control swaps in a stand-in that answers every query with 0 (`PUSH0 PUSH0 MSTORE PUSH1 0x20
+# PUSH0 RETURN`, its certificate written out by hand here; it is only data for the interpreter)
+# and checks, by kernel evaluation of the same interpreter, that the role-gated `pause()` and
+# `mint(address,uint256)` no longer reach a successful halt while `transfer(address,uint256)`,
+# which asks for no role, still does.  So the witnesses' success comes from the registry's
+# answer, not from the interpreter skipping the role check.
+set -u
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT"
+WORK="$ROOT/.lake/stock-controls"
+mkdir -p "$WORK"
+cat > "$WORK/WitnessDeny.lean" <<'LEAN'
+import Blanc.Lift.Stock.Witness
+
+namespace Blanc.Lift.Stock.Witnesses
+open Jaune Blanc Blanc.Lift Blanc.Lift.Witness Blanc.ConcreteRun
+
+def denyCode : ByteArray := ⟨#[0x5f, 0x5f, 0x52, 0x60, 0x20, 0x5f, 0xf3]⟩
+def denyProg : List SFunc :=
+  [.next (.push [] (by decide)) (.next (.push [] (by decide)) (.next (.reg .mstore)
+    (.next (.push [0x20] (by decide)) (.next (.push [] (by decide)) (.last .return_)))))]
+def denyChild : StaticChild := ⟨denyProg, denyCode, 20⟩
+def denyAccts : List (Adr × Acct) :=
+  [(registry, ⟨1, 0, .empty, denyCode⟩), (tokenAddress, ⟨1, 0, .empty, code⟩)]
+def denyWorld : State := stateFoldAcct default denyAccts
+def denySevm (data : Bytes) : Sevm :=
+  { sevmOf [] data with benvStat := { (default : BenvStat) with origState := denyWorld } }
+def denyCfg : Cfg :=
+  ⟨((default : Devm).withGasLeft gas0).withState denyWorld, t_0000_c0, [], [], [], [],
+    acctShadowOf denyAccts⟩
+
+theorem deny_pause :
+    haltedWith anyStor (wrunS denyChild cert.prog (denySevm pauseData) 2000 denyCfg) = false := by
+  kernel_rfl
+theorem deny_mint :
+    haltedWith anyStor (wrunS denyChild cert.prog (denySevm mintData) 2000 denyCfg) = false := by
+  kernel_rfl
+theorem deny_transfer :
+    haltedWith anyStor (wrunS denyChild cert.prog (denySevm transferData) 2000 denyCfg) = true := by
+  kernel_rfl
+
+end Blanc.Lift.Stock.Witnesses
+LEAN
+if ! lake env lean "$WORK/WitnessDeny.lean" > "$WORK/deny.out" 2>&1; then
+  echo "FAIL witness control:"; head -20 "$WORK/deny.out"; exit 1
+fi
+if grep -q "error" "$WORK/deny.out"; then
+  echo "FAIL witness control:"; head -20 "$WORK/deny.out"; exit 1
+fi
+echo "OK — witnesses: with a registry that denies every role, pause() and mint() do not succeed and transfer() still does"
