+import Blanc.Lift.WitnessChild
+
+/-!
+# `STATICCALL` in a witness run
+
+`Blanc.Lift.Witness`'s interpreter takes `CALL`s; this module adds the static call, the same
+way the code-child `CALL` is taken (`callPrep`, `callResume`, `childRun`).
+
+* `staticPrep`: the `.staticcall` arm of `Xinst.step` up to its spawn, warm/cold on the address
+  shadow and the callee's code from the account shadow (`Xinst.step_staticcall_spawn`);
+  `staticPrep_spec` is its agreement with Jaune's step.
+* `staticResume`, `StaticChildOk`, `staticResume_cont`: the configuration after the call from a
+  settled child supplied as data, and the step it makes (a `StepOk`) given that the child is the
+  settlement of an `Exec` from the machine the call's frame enters with (`StaticChildOk`) and
+  that the shadows describe it (`ChildAgree`).
+* `staticChildRun`, `staticChildOk_of_childRun`: the child run by its own certificate discharges
+  both obligations.
+
+Nothing here is contract-specific.
+-/
+
+namespace Blanc.Lift.Witness
+
+open Jaune Blanc.Lift
+
+/-- The `.staticcall` arm of `Xinst.step` up to its spawn, warm/cold on the shadow. -/
+def staticPrep (sevm : Sevm) (c : Cfg) : Option CallPrep :=
+  match c.devm.stack with
+  | gw :: tw :: iiw :: isw :: oiw :: osw :: s =>
+    if decide (CoveredFork sevm.benvStat.fork) ∧ sevm.depth ≠ 0 then
+      let d0 := c.devm.setMach ⟨s, c.devm.memory, c.devm.gasLeft, c.devm.stateGas⟩
+      let ext := d0.extCost [⟨iiw.toNat, isw.toNat⟩, ⟨oiw.toNat, osw.toNat⟩]
+      let callee := tw.toAdr
+      let dA := addAccessedAddress d0 callee
+      let code := (lookupA c.acs callee).code
+      match getDelegatedCodeAddress code with
+      | some _ => none
+      | none =>
+        let acc := accessCostL callee c.adrs
+        let r := calculateMsgCallGas 0 gw.toNat dA.gasLeft ext acc
+        if r.1 + ext ≤ dA.gasLeft then
+          let p := callSpawnParent dA (r.1 + ext) iiw.toNat isw.toNat oiw.toNat osw.toNat
+          some ⟨Frame.ofCall (staticcallSpawnMsg sevm p r.2 callee callee iiw.toNat isw.toNat
+            code false), p, oiw.toNat, osw.toNat, callee :: c.adrs⟩
+        else none
+    else none
+  | _ => none
+
+theorem staticPrep_spec {sevm : Sevm} {c : Cfg} {cp : CallPrep} (h : staticPrep sevm c = some cp)
+    (hA : ∀ a, a ∈ c.devm.accessedAddresses ↔ a ∈ c.adrs) (hC : AcctAgree c.devm.state c.acs) :
+    Xinst.step sevm c.devm .staticcall = .spawn cp.f (.call cp.p cp.oi cp.os) ∧
+      (∀ a, a ∈ cp.p.accessedAddresses ↔ a ∈ cp.adrs) ∧
+      cp.p.accessedStorageKeys = c.devm.accessedStorageKeys ∧
+      cp.f.isCreate = false ∧ cp.f.inner.accessedAddresses = cp.p.accessedAddresses ∧
+      cp.f.inner.accessedStorageKeys = cp.p.accessedStorageKeys ∧
+      cp.f.inner.benv.stat.rules.stateGas = none ∧ cp.f.inner.benv.state = c.devm.state := by
+  rcases c with ⟨devm, f, K, keys, adrs, stor, acs⟩
+  simp only [staticPrep] at h
+  split at h
+  · rename_i gw tw iiw isw oiw osw s hs
+    have hcode : (lookupA acs tw.toAdr).code = (addAccessedAddress
+        (devm.setMach ⟨s, devm.memory, devm.gasLeft, devm.stateGas⟩) tw.toAdr).state.getCode
+        tw.toAdr := (congrArg Acct.code (hC tw.toAdr)).symm
+    simp only [hcode] at h
+    split at h
+    · rename_i hcond
+      obtain ⟨hfork, hdepth⟩ := hcond
+      have hfork' : CoveredFork sevm.benvStat.fork := of_decide_eq_true hfork
+      split at h
+      · cases h
+      · rename_i hdel
+        have hdel' : accessDelegation
+            (addAccessedAddress (devm.setMach ⟨s, devm.memory, devm.gasLeft, devm.stateGas⟩)
+              tw.toAdr) tw.toAdr =
+            ⟨false, tw.toAdr, (addAccessedAddress
+              (devm.setMach ⟨s, devm.memory, devm.gasLeft, devm.stateGas⟩) tw.toAdr).state.getCode
+              tw.toAdr, 0,
+              addAccessedAddress (devm.setMach ⟨s, devm.memory, devm.gasLeft, devm.stateGas⟩)
+                tw.toAdr⟩ := by
+          unfold accessDelegation
+          simp only at hdel ⊢
+          rw [hdel]
+        have hacc : accessCost tw.toAdr
+            (devm.setMach ⟨s, devm.memory, devm.gasLeft, devm.stateGas⟩).accessedAddresses + 0 =
+            accessCostL tw.toAdr adrs := by
+          rw [Nat.add_zero]; exact accessCost_eq_L hA
+        have hins : ∀ a, a ∈ (addAccessedAddress
+            (devm.setMach ⟨s, devm.memory, devm.gasLeft, devm.stateGas⟩) tw.toAdr).accessedAddresses ↔
+            a ∈ tw.toAdr :: adrs := by
+          intro a
+          show a ∈ devm.accessedAddresses.insert tw.toAdr ↔ _
+          rw [Std.HashSet.mem_insert, List.mem_cons, hA a, beq_iff_eq]
+          constructor <;> rintro (h | h) <;> first | exact .inl h.symm | exact .inr h
+        have hsg := hfork'.rules_stateGas_none
+        split at h
+        · rename_i hgas
+          cases h
+          exact ⟨Xinst.step_staticcall_spawn hfork' hs rfl hdel' hacc rfl hgas hdepth,
+            hins, rfl, rfl, rfl, rfl, hsg, rfl⟩
+        · cases h
+    · cases h
+  · cases h
+
+/-! ## Resuming from a settled child -/
+
+/-- The configuration after a `STATICCALL`, from the settled child and its shadows. -/
+def staticResume (sevm : Sevm) (c : Cfg) (child : Devm) (ckeys : List (Adr × B256))
+    (cadrs : List Adr) (cstor : StorShadow) (cacs : AcctShadow) : Option Cfg :=
+  match c.f with
+  | .next (.exec .staticcall) g =>
+    match staticPrep sevm c with
+    | some cp =>
+      match frameEnterS cp.f c.acs with
+      | .run _ =>
+        if child.error.isSome = false ∧ frameEntryForkFree cp.f = true then
+          match resumeCallB cp.p cp.oi cp.os (.ok child) with
+          | some d => some ⟨d, g, c.K, c.keys ++ ckeys, cp.adrs ++ cadrs, cstor, cacs⟩
+          | none => none
+        else none
+      | .done _ => none
+    | none => none
+  | _ => none
+
+/-- A settled machine is the child of the `STATICCALL` at `c`: the settlement of an `Exec` from
+the machine that call's frame enters with. -/
+def StaticChildOk (sevm : Sevm) (c : Cfg) (child : Devm) : Prop :=
+  ∀ cp cevm, staticPrep sevm c = some cp → frameEnterS cp.f c.acs = .run cevm →
+    ∃ raw, Nonempty (Exec cevm.pc cevm.sta cevm.dyna raw) ∧ cp.f.settle raw = .ok child
+
+theorem staticRun_cont {fs : List SFunc} {sevm : Sevm} {c : Cfg} {g : SFunc} {cp : CallPrep}
+    {cevm : Evm} {raw : Execution} {child d : Devm}
+    {ckeys : List (Adr × B256)} {cadrs : List Adr} {cstor : StorShadow} {cacs : AcctShadow}
+    (hf : c.f = .next (.exec .staticcall) g) (hp : staticPrep sevm c = some cp)
+    (he : frameEnterS cp.f c.acs = .run cevm) (hx : Nonempty (Exec cevm.pc cevm.sta cevm.dyna raw))
+    (hs : cp.f.settle raw = .ok child) (hce : child.error.isSome = false)
+    (hr : resumeCallB cp.p cp.oi cp.os (.ok child) = some d)
+    (hca : ChildAgree child ckeys cadrs cstor cacs) :
+    StepOk fs sevm c ⟨d, g, c.K, c.keys ++ ckeys, cp.adrs ++ cadrs, cstor, cacs⟩ := by
+  refine StepOk.of ?_ rfl ?_
+  · intro hc
+    obtain ⟨_, hpa, hpk, -⟩ := staticPrep_spec hp hc.2.1 hc.2.2.2
+    obtain ⟨hda, hdk⟩ := resumeCallB_acc hr
+    refine ⟨fun x => ?_, fun a => ?_, fun a k => ?_, fun a => ?_⟩
+    · show x ∈ d.accessedStorageKeys ↔ x ∈ c.keys ++ ckeys
+      rw [hdk x, hce, hpk, hc.1 x, hca.2.1 x, List.mem_append]
+      simp only [true_and]
+    · show a ∈ d.accessedAddresses ↔ a ∈ cp.adrs ++ cadrs
+      rw [hda a, hce, hpa a, hca.1 a, List.mem_append]
+      simp only [true_and]
+    · show storOf d.state a k = lookupS cstor a k
+      rw [resumeCallB_state hr]; exact hca.2.2.1 a k
+    · show acctView (d.state.get a) = lookupA cacs a
+      rw [resumeCallB_state hr]; exact hca.2.2.2 a
+  · intro hc o r'
+    obtain ⟨hstep, -, -, -, -, -, -, hst⟩ := staticPrep_spec hp hc.2.1 hc.2.2.2
+    have hC : AcctAgree cp.f.inner.benv.state c.acs := by rw [hst]; exact hc.2.2.2
+    rw [hf]
+    refine .next ⟨.some ⟨cevm, raw⟩, hx, fun pc => ?_⟩ r'
+    apply XStep.run_toStep.mpr
+    show XStep.Run (Xinst.step sevm c.devm .staticcall) _ _
+    rw [hstep]
+    refine ⟨_, RunFrame.of_run (by rw [frame_enter_eq_B, frameEnterB_eq_S hC]; exact he), ?_⟩
+    rw [hs]; exact (resumeCallB_sound hr).symm
+
+theorem staticResume_cont {fs : List SFunc} {sevm : Sevm} {c c' : Cfg} {child : Devm}
+    {ckeys : List (Adr × B256)} {cadrs : List Adr} {cstor : StorShadow} {cacs : AcctShadow}
+    (h : staticResume sevm c child ckeys cadrs cstor cacs = some c')
+    (hk : StaticChildOk sevm c child) (ha : ChildAgree child ckeys cadrs cstor cacs) :
+    StepOk fs sevm c c' := by
+  unfold staticResume at h
+  split at h
+  · rename_i g hf
+    split at h
+    · rename_i cp hp
+      split at h
+      · rename_i cevm he
+        split at h
+        · rename_i hce'
+          have hce : child.error.isSome = false := hce'.1
+          split at h
+          · rename_i d hr
+            cases h
+            obtain ⟨raw, hx, hs⟩ := hk cp cevm hp he
+            exact staticRun_cont hf hp he hx hs hce hr ha
+          · cases h
+        · cases h
+      · cases h
+    · cases h
+  · cases h
+
+/-! ## The child run by its own certificate -/
+
+/-- The child frame a `STATICCALL` at `c` enters with, and its start configuration at `f0`. -/
+def staticChildStart (sevm : Sevm) (c : Cfg) (f0 : SFunc) : Option (Evm × Cfg) :=
+  match staticPrep sevm c with
+  | some cp =>
+    match frameEnterS cp.f c.acs with
+    | .run cevm =>
+      if frameEntryForkFree cp.f = true then
+        some (cevm, ⟨cevm.dyna, f0, [], c.keys, cp.adrs, storTransfer cp.f.inner c.stor c.acs,
+          acsTransfer cp.f.inner c.acs⟩)
+      else none
+    | .done _ => none
+  | none => none
+
+/-- The child of the `STATICCALL` at `c`, run for at most `n` steps over `fs`. -/
+def staticChildRun (fs : List SFunc) (code : ByteArray) (sevm : Sevm) (n : Nat) (c : Cfg) :
+    Res :=
+  match fs[0]? with
+  | some f0 =>
+    match staticChildStart sevm c f0 with
+    | some (e, cc) =>
+      if decide (CoveredFork e.sta.benvStat.fork) ∧ e.sta.code.data.toList = code.data.toList
+      then wrun fs e.sta n cc
+      else .stuck
+    | none => .stuck
+  | none => .stuck
+
+theorem staticChildOk_of_start {fs : List SFunc} {code : ByteArray} {sevm : Sevm} {n : Nat}
+    {c c1 cl cc : Cfg} {f0 : SFunc} {cevm : Evm} {post : Devm}
+    (hexact : ∀ {sevm' : Sevm} {pre : Devm}, sevm'.code = code →
+      CoveredFork sevm'.benvStat.fork → SProg.RunExact fs sevm' pre post →
+      Nonempty (Exec 0 sevm' pre (.ok post)))
+    (hagree : Agree c) (h0 : fs[0]? = some f0) (hs : staticChildStart sevm c f0 = some (cevm, cc))
+    (hfork : CoveredFork cevm.sta.benvStat.fork) (hcode : cevm.sta.code = code)
+    (hstep : StepOk fs cevm.sta cc c1) (hrun : wrun fs cevm.sta n c1 = .done (.halted post) cl)
+    (herr : post.error = none) :
+    StaticChildOk sevm c post ∧ ChildAgree post cl.keys cl.adrs cl.stor cl.acs := by
+  unfold staticChildStart at hs
+  split at hs
+  · rename_i cp hp
+    split at hs
+    · rename_i cevm' he
+      split at hs
+      · simp only [Option.some.injEq, Prod.mk.injEq] at hs
+        obtain ⟨h1, h2⟩ := hs
+        subst h1 h2
+        obtain ⟨-, hpa, hpk, hcr, hia, hik, hsg, hst⟩ := staticPrep_spec hp hagree.2.1 hagree.2.2.2
+        have hC : AcctAgree cp.f.inner.benv.state c.acs := by rw [hst]; exact hagree.2.2.2
+        have hent : cp.f.enter = .run cevm' := by
+          rw [frame_enter_eq_B, frameEnterB_eq_S hC]
+          exact he
+        have hstat := Frame.enter_run_benvStat hent
+        have hsweep : cp.f.inner.benv.stat.rules.settle.touchedSweep = false := by
+          rw [← hstat]
+          exact hfork.cases
+            (motive := fun f => f.ruleSet.settle.touchedSweep = false) rfl rfl rfl rfl
+        obtain ⟨hx, hs, ha⟩ := frame_of_wrun he
+          (fun x => by rw [hik, hpk]; exact hagree.1 x)
+          (fun a => by rw [hia]; exact hpa a)
+          (fun a k => by rw [hst]; exact hagree.2.2.1 a k) hC hcr hsg hsweep
+          (hexact hcode hfork) h0 hstep hrun herr
+        refine ⟨fun cp' cevm'' hp' he' => ?_, ha⟩
+        rw [hp] at hp'
+        cases hp'
+        rw [he] at he'
+        cases he'
+        exact ⟨.ok post, hx, hs⟩
+      · cases hs
+    · cases hs
+  · cases hs
+
+/-- `staticChildOk_of_start` for a child that runs straight to its halt. -/
+theorem staticChildOk_of_childRun {fs : List SFunc} {code : ByteArray} {sevm : Sevm} {n : Nat}
+    {c cl : Cfg} {post : Devm}
+    (hexact : ∀ {sevm' : Sevm} {pre : Devm}, sevm'.code = code →
+      CoveredFork sevm'.benvStat.fork → SProg.RunExact fs sevm' pre post →
+      Nonempty (Exec 0 sevm' pre (.ok post)))
+    (hagree : Agree c) (hrun : staticChildRun fs code sevm n c = .done (.halted post) cl)
+    (herr : post.error = none) :
+    StaticChildOk sevm c post ∧ ChildAgree post cl.keys cl.adrs cl.stor cl.acs := by
+  unfold staticChildRun at hrun
+  split at hrun
+  · rename_i f0 h0
+    split at hrun
+    · rename_i cevm cc hcs
+      split at hrun
+      · rename_i hcond
+        exact staticChildOk_of_start hexact hagree h0 hcs (of_decide_eq_true hcond.1)
+          (byteArray_eq_of_toList hcond.2) ⟨id, fun _ _ r => r⟩ hrun herr
+      · cases hrun
+    · cases hrun
+  · cases hrun
+
+end Blanc.Lift.Witness
+
+/-! ## `CODECOPY` -/
+
+namespace Blanc.Lift.Witness
+
+open Jaune Blanc.Lift
+
+/-- `CODECOPY` writing memory through `memWriteB` and reading the code through `List.sliceD`
+(one `drop` and one `take`; `Ninst.runCompiled_codecopy_of`). -/
+def codecopyStep (sevm : Sevm) (c : Cfg) (g : SFunc) : Option Cfg :=
+  match c.devm.stack with
+  | di :: si :: sz :: s =>
+    let cost := gVerylow + gasCopy * ceilDiv sz.toNat 32 + c.devm.extCost [⟨di.toNat, sz.toNat⟩]
+    if cost ≤ c.devm.gasLeft then
+      some ⟨c.devm.setMach ⟨s, memWriteB c.devm.memory di.toNat
+        (sevm.code.data.toList.sliceD si.toNat sz.toNat (Linst.toUInt8 .stop)), c.devm.gasLeft - cost,
+        c.devm.stateGas⟩, g, c.K, c.keys, c.adrs, c.stor, c.acs⟩
+    else none
+  | _ => none
+
+theorem codecopyStep_cont {fs : List SFunc} {sevm : Sevm} {c c' : Cfg} {g : SFunc}
+    (h : codecopyStep sevm c g = some c') (hf : c.f = .next (.reg .codecopy) g) :
+    StepOk fs sevm c c' := by
+  rcases c with ⟨devm, f, K, keys, adrs, stor, acs⟩
+  simp only at hf; subst hf
+  simp only [codecopyStep] at h
+  split at h
+  · rename_i di si sz s hs
+    split at h
+    · rename_i hgas
+      cases h
+      exact StepOk.same rfl rfl rfl rfl (AccKeep.setMach _ _) rfl fun o r =>
+        .next (Ninst.runCompiled_codecopy_of hs rfl
+          (by rw [ByteArray.sliceD_eq, ByteArray.toList_eq_toList_data]; exact mem_write_eq_B _ _ _)
+          (by exact (Nat.sub_add_cancel hgas).symm)) r
+    · cases h
+  · cases h
+
+/-! ## `ADDMOD` and `MULMOD` -/
+
+/-- `ADDMOD` and `MULMOD` through Jaune's own step at pc `0` (neither reads the pc). -/
+def ternaryStep (sevm : Sevm) (c : Cfg) (r : Rinst) (g : SFunc) : Option Cfg :=
+  match Ninst.step ⟨0, sevm, c.devm⟩ (.reg r) with
+  | .cont _ d => some ⟨d, g, c.K, c.keys, c.adrs, c.stor, c.acs⟩
+  | _ => none
+
+theorem ternaryStep_cont {fs : List SFunc} {sevm : Sevm} {c c' : Cfg} {r : Rinst} {g : SFunc}
+    (hr : r = .addmod ∨ r = .mulmod) (h : ternaryStep sevm c r g = some c')
+    (hf : c.f = .next (.reg r) g) : StepOk fs sevm c c' := by
+  unfold ternaryStep at h
+  split at h
+  · rename_i q d hstep
+    cases h
+    have hk : AccKeep c.devm d := by
+      have hs := hstep
+      rw [Ninst.step_reg] at hs
+      unfold Step.ofExecution at hs
+      split at hs
+      · cases hs
+      · cases hs
+        rename_i hd
+        rcases hr with rfl | rfl <;> simp only [Rinst.run, Rinst.runCore] at hd <;>
+        · obtain ⟨_, _, _, hd'⟩ := Devm.diffBurn_of_applyTernary hd
+          exact ⟨hd'.accessedAddresses.symm, hd'.accessedStorageKeys.symm, hd'.state.symm⟩
+    have hpc : Ninst.pcFree (.reg r) = true := by rcases hr with rfl | rfl <;> rfl
+    refine StepOk.same rfl rfl rfl rfl hk rfl fun o run => ?_
+    rw [hf]
+    exact .next (Ninst.runCompiled_of_run hpc
+      ⟨.none, trivial, 0, by simp only [Ninst.StepRun, Step.Run, hstep, ExceptT.stM_eq, and_self]⟩) run
+  · cases h
+
+/-! ## A witness run with static calls to one child code -/
+
+/-- The code every `STATICCALL` of a run reaches, its certificate, and a step bound. -/
+structure StaticChild where
+  fs : List SFunc
+  code : ByteArray
+  steps : Nat
+
+/-- A `STATICCALL` at `c`: its child run by `ch`'s certificate to a halt, then resumed. -/
+def staticStep (ch : StaticChild) (sevm : Sevm) (c : Cfg) : Option Cfg :=
+  match staticChildRun ch.fs ch.code sevm ch.steps c with
+  | .done (.halted d) cl => staticResume sevm c d cl.keys cl.adrs cl.stor cl.acs
+  | _ => none
+
+/-- `wstep`, with `CODECOPY`, `ADDMOD`, `MULMOD` and with `STATICCALL`s to `ch`'s code. -/
+def wstepS (ch : StaticChild) (fs : List SFunc) (sevm : Sevm) (c : Cfg) : Res :=
+  match c.f with
+  | .next (.reg .codecopy) g =>
+    match codecopyStep sevm c g with
+    | some c' => .cont c'
+    | none => .stuck
+  | .next (.reg .addmod) g =>
+    match ternaryStep sevm c .addmod g with
+    | some c' => .cont c'
+    | none => .stuck
+  | .next (.reg .mulmod) g =>
+    match ternaryStep sevm c .mulmod g with
+    | some c' => .cont c'
+    | none => .stuck
+  | .next (.exec .staticcall) _ =>
+    match staticStep ch sevm c with
+    | some c' => .cont c'
+    | none => .stuck
+  | _ => wstep fs sevm c
+
+/-- At most `n` steps of `wstepS`. -/
+def wrunS (ch : StaticChild) (fs : List SFunc) (sevm : Sevm) : Nat → Cfg → Res
+  | 0, c => .cont c
+  | n + 1, c =>
+    match wstepS ch fs sevm c with
+    | .cont c' => wrunS ch fs sevm n c'
+    | r => r
+
+/-- A run of `ch`'s certificate is an `Exec` of `ch`'s code. -/
+def StaticChild.Sound (ch : StaticChild) : Prop :=
+  ∀ {post : Devm} {sevm' : Sevm} {pre : Devm}, sevm'.code = ch.code →
+    CoveredFork sevm'.benvStat.fork → SProg.RunExact ch.fs sevm' pre post →
+    Nonempty (Exec 0 sevm' pre (.ok post))
+
+theorem staticResume_error {sevm : Sevm} {c c' : Cfg} {child : Devm} {ckeys : List (Adr × B256)}
+    {cadrs : List Adr} {cstor : StorShadow} {cacs : AcctShadow}
+    (h : staticResume sevm c child ckeys cadrs cstor cacs = some c') : child.error = none := by
+  unfold staticResume at h
+  split at h
+  · split at h
+    · split at h
+      · split at h
+        · rename_i hce
+          cases he : child.error
+          · rfl
+          · have := hce.1; rw [he] at this; cases this
+        · cases h
+      · cases h
+    · cases h
+  · cases h
+
+theorem staticStep_cont {ch : StaticChild} (hch : ch.Sound) {fs : List SFunc} {sevm : Sevm}
+    {c c' : Cfg} (h : staticStep ch sevm c = some c') : StepOk fs sevm c c' := by
+  unfold staticStep at h
+  split at h
+  · rename_i d cl hrun
+    have herr := staticResume_error h
+    have ok := fun hc : Agree c =>
+      staticChildOk_of_childRun (fun hcode hfork hr => hch hcode hfork hr) hc hrun herr
+    exact ⟨fun hc => (staticResume_cont (fs := fs) h (ok hc).1 (ok hc).2).1 hc,
+      fun o hc r => (staticResume_cont (fs := fs) h (ok hc).1 (ok hc).2).2 o hc r⟩
+  · cases h
+
+theorem wstepS_cont {ch : StaticChild} (hch : ch.Sound) {fs : List SFunc} {sevm : Sevm}
+    {c c' : Cfg} (h : wstepS ch fs sevm c = .cont c') : StepOk fs sevm c c' := by
+  unfold wstepS at h
+  split at h
+  · rename_i g hf
+    split at h
+    · rename_i c'' hs
+      cases h
+      exact codecopyStep_cont hs hf
+    · cases h
+  · rename_i g hf
+    split at h
+    · rename_i c'' hs
+      cases h
+      exact ternaryStep_cont (.inl rfl) hs hf
+    · cases h
+  · rename_i g hf
+    split at h
+    · rename_i c'' hs
+      cases h
+      exact ternaryStep_cont (.inr rfl) hs hf
+    · cases h
+  · split at h
+    · rename_i c'' hs
+      cases h
+      exact staticStep_cont hch hs
+    · cases h
+  · exact wstep_cont h
+
+theorem wstepS_done {ch : StaticChild} {fs : List SFunc} {sevm : Sevm} {c c' : Cfg} {o : Outcome}
+    (h : wstepS ch fs sevm c = .done o c') :
+    RunK fs sevm c.devm c.f c.K o ∧ c' = c ∧ ∀ d, o = .halted d → d.state = c.devm.state := by
+  unfold wstepS at h
+  split at h
+  · split at h <;> cases h
+  · split at h <;> cases h
+  · split at h <;> cases h
+  · split at h <;> cases h
+  · exact wstep_done h
+
+theorem wrunS_cont {ch : StaticChild} (hch : ch.Sound) {fs : List SFunc} {sevm : Sevm} :
+    ∀ {n : Nat} {c c' : Cfg}, wrunS ch fs sevm n c = .cont c' → StepOk fs sevm c c'
+  | 0, c, c', h => by
+    simp only [wrunS, Res.cont.injEq] at h; subst h
+    exact ⟨id, fun _ _ r => r⟩
+  | n + 1, c, c', h => by
+    simp only [wrunS] at h
+    split at h
+    · rename_i c1 h1
+      exact (wstepS_cont hch h1).trans (wrunS_cont hch h)
+    · rename_i r hr
+      exact absurd h (hr _)
+
+theorem wrunS_done {ch : StaticChild} (hch : ch.Sound) {fs : List SFunc} {sevm : Sevm} :
+    ∀ {n : Nat} {c c' : Cfg} {o : Outcome}, wrunS ch fs sevm n c = .done o c' → Agree c →
+      RunK fs sevm c.devm c.f c.K o ∧ Agree c' ∧ ∀ d, o = .halted d → d.state = c'.devm.state
+  | 0, c, c', o, h, _ => by simp only [wrunS, reduceCtorEq] at h
+  | n + 1, c, c', o, h, hc => by
+    simp only [wrunS] at h
+    split at h
+    · rename_i c1 h1
+      have s1 := wstepS_cont hch h1
+      obtain ⟨r, ha, hs⟩ := wrunS_done hch h (s1.1 hc)
+      exact ⟨s1.2 o hc r, ha, hs⟩
+    · obtain ⟨r, rfl, hs⟩ := wstepS_done h
+      exact ⟨r, hc, hs⟩
+
+/-- **A witness run with static calls, as a gas-exact run.** -/
+theorem wrunS_exact {ch : StaticChild} (hch : ch.Sound) {fs : List SFunc} {sevm : Sevm}
+    {pre post : Devm} {f0 : SFunc} {keys : List (Adr × B256)} {adrs : List Adr}
+    {stor : StorShadow} {acs : AcctShadow} {n : Nat} {cl : Cfg}
+    (h0 : fs[0]? = some f0) (hagree : Agree ⟨pre, f0, [], keys, adrs, stor, acs⟩)
+    (h : wrunS ch fs sevm n ⟨pre, f0, [], keys, adrs, stor, acs⟩ = .done (.halted post) cl) :
+    SProg.RunExact fs sevm pre post :=
+  ⟨f0, h0, (wrunS_done hch h hagree).1⟩
+
+end Blanc.Lift.Witness
