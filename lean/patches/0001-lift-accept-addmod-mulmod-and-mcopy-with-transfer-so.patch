+/-- Pop three words and push one computed word (`ADDMOD`, `MULMOD`). -/
+def ternaryTransfer : Pattern → Option Pattern
+  | _ :: _ :: _ :: words => some (none :: words)
+  | _ => none
+
 /-- `regularTransfer`, extended by the regular opcodes of solc output that it
 rejects (and `XOR`, which Vyper uses for `!=`). -/
 def liftRegularTransfer : Rinst → Pattern → Option Pattern
+  | .addmod, words => ternaryTransfer words
+  | .mulmod, words => ternaryTransfer words
+  | .mcopy, words => dropTransfer 3 words
   | .exp, words => binaryTransfer words
   | .slt, words => binaryTransfer words
   | .not, words => unaryTransfer words
@@ -143,6 +152,16 @@ private theorem binaryTransfer_map (φ : Option B256 → Option B256)
           cases checked
           simp only [List.map_cons, hφ]
 
+private theorem ternaryTransfer_map (φ : Option B256 → Option B256)
+    (hφ : φ none = none) {words output : Pattern}
+    (checked : ternaryTransfer words = some output) :
+    ternaryTransfer (words.map φ) = some (output.map φ) := by
+  match words, checked with
+  | _ :: _ :: _ :: words, checked =>
+      simp only [ternaryTransfer, Option.some.injEq] at checked ⊢
+      cases checked
+      simp only [List.map_cons, hφ]
+
 private theorem dropOneTransfer_map (φ : Option B256 → Option B256)
     (_hφ : φ none = none) {words output : Pattern}
