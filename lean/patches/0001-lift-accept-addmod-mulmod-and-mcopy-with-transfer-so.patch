       rw [← dropTransfer_map φ hφ 3 words]
       simpa only [Option.map_eq_some_iff, Option.map_some] using
         congrArg (Option.map (List.map φ)) checked
@@ -353,12 +382,13 @@ private theorem liftRegularTransfer_append {r : Rinst}
     (checked : liftRegularTransfer r words = some output) :
     liftRegularTransfer r (words ++ below) = some (output ++ below) := by
   cases r <;> simp only [liftRegularTransfer] at checked ⊢
+  case addmod | mulmod => exact ternaryTransfer_append checked
   case exp | slt | keccak256 | sdiv | signextend | sgt => exact binaryTransfer_append checked
   case not | balance | extcodesize | extcodehash | tload => exact unaryTransfer_append checked
   case address | origin | chainid | selfbalance | codesize | number | msize => cases checked; rfl
   case log n => exact dropTransfer_append (n.val + 2) checked
   case mod | or | xor | byte | shl => exact binaryTransfer_append checked
-  case calldatacopy | codecopy | returndatacopy => exact dropTransfer_append 3 checked
+  case calldatacopy | codecopy | returndatacopy | mcopy => exact dropTransfer_append 3 checked
   case returndatasize => cases checked; rfl
   case mstore8 | tstore => exact dropTwoTransfer_append checked
   all_goals exact regularTransfer_append checked
@@ -598,6 +628,35 @@ private theorem binary_checked {input output : Pattern}
           simp only [binaryTransfer, Option.some.injEq] at checked
           exact ⟨word, word', tail, rfl, checked.symm⟩
 
+private theorem ternary_checked {input output : Pattern}
+    (checked : ternaryTransfer input = some output) :
+    ∃ a b c tail, input = a :: b :: c :: tail ∧ output = none :: tail := by
+  match input, checked with
+  | a :: b :: c :: tail, checked =>
+      simp only [ternaryTransfer, Option.some.injEq] at checked
+      exact ⟨a, b, c, tail, rfl, checked.symm⟩
+
+/-- A successful `MCOPY` pops its three operands (destination, source, length) and pushes
+nothing. -/
+theorem of_run_mcopy {sevm : Sevm} {s s' : Devm} (run : Ninst.Run sevm s (.reg .mcopy) s') :
+    ∃ x y z, Stack.Pop [x, y, z] s.stack s'.stack := by
+  rcases of_run_reg run with ⟨pc, h⟩
+  simp only [Rinst.run, Rinst.runCore] at h
+  split at h
+  swap
+  · cases h
+  rcases Except.bind_eq_ok h with ⟨⟨di, s₁⟩, h1, h⟩
+  rcases Except.bind_eq_ok h with ⟨⟨si, s₂⟩, h2, h⟩
+  rcases Except.bind_eq_ok h with ⟨⟨sz, s₃⟩, h3, h⟩
+  rcases Except.bind_eq_ok h with ⟨s₄, h4, h5⟩
+  rcases Devm.pop_of_popToNat_val h1 with ⟨x, p1, rfl⟩
+  rcases Devm.pop_of_popToNat_val h2 with ⟨y, p2, rfl⟩
+  rcases Devm.pop_of_popToNat_val h3 with ⟨z, p3, rfl⟩
+  cases h5
+  refine ⟨x, y, z, ?_⟩
+  rw [Devm.memWrite_stack, Devm.memRead_stack, ← (Devm.burn_of_chargeGas h4).stack]
+  exact (Devm.pop_append p1 (Devm.pop_append p2 p3)).stack
+
 private theorem dropOne_checked {input output : Pattern}
     (checked : dropOneTransfer input = some output) :
     ∃ head tail, input = head :: tail ∧ output = tail := by
@@ -1026,6 +1085,16 @@ theorem ninstTransfer_run_lane {sevm : Sevm} {devm devm' : Devm} {n : Ninst}
           simp only [Rinst.run, Rinst.runCore] at hr
           rcases Devm.diffBurn_of_applyBinary hr with ⟨x, y, hd⟩
           exact matches_diff matched hd.stack
+      | addmod | mulmod =>
+          rcases ternary_checked checked with ⟨a, b, c, tail, rfl, rfl⟩
+          rcases of_run_reg run with ⟨pc, hr⟩
+          simp only [Rinst.run, Rinst.runCore] at hr
+          rcases Devm.diffBurn_of_applyTernary hr with ⟨x, y, z, hd⟩
+          exact matches_diff matched hd.stack
+      | mcopy =>
+          rcases of_run_mcopy run with ⟨x, y, z, hp⟩
+          rw [← dropTransfer_eq_drop checked]
+          exact matches_pop matched hp
       | iszero | not =>
           simp only [regularTransfer] at checked
           rcases unary_checked checked with ⟨head, tail, rfl, rfl⟩
