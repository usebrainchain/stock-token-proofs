@@ -302,6 +303,45 @@ theorem run_returndatacopy_memory {sevm : Sevm} {d d' : Devm} {o src z : B256}
   rw [← (Devm.burn_of_chargeGas h3).memory]
   rfl
 
+/-- `MCOPY` writes `length` bytes at its destination, over the memory extended for its source
+window (and the destination's extension is part of the write). -/
+theorem run_mcopy_memory {sevm : Sevm} {d d' : Devm} {o src z : B256} {rest : List B256}
+    (hs : d.stack = o :: src :: z :: rest) (run : Ninst.Run sevm d (.reg .mcopy) d') :
+    ∃ (μ : Mem) (ys : Bytes), μ.data = d.memory.data ∧ d.memory.size ≤ μ.size ∧
+      ys.length = z.toNat ∧ d'.memory = μ.write o.toNat ys := by
+  rcases of_run_reg run with ⟨pc, h⟩
+  simp only [Rinst.run, Rinst.runCore] at h
+  split at h
+  swap
+  · cases h
+  simp only [Bind.bind, Except.bind, Devm.popToNat_cons hs, Devm.withStack_popToNat] at h
+  obtain ⟨d3, h3, h4⟩ := Except.bind_eq_ok h
+  cases h4
+  have hb := (Devm.burn_of_chargeGas h3).memory
+  have hk := MemKeep.memRead d3 src.toNat z.toNat
+  refine ⟨(d3.memRead src.toNat z.toNat).2.memory, (d3.memRead src.toNat z.toNat).1,
+    ?_, ?_, ?_, rfl⟩
+  · rw [hk.1, ← hb]
+    rfl
+  · have hsz := hk.2
+    rw [← hb] at hsz
+    exact hsz
+  · simp only [Devm.memRead, Mem.read, Array.sliceD_eq_map, List.length_map, List.length_range]
+
+theorem run_addmod_memory {sevm : Sevm} {d d' : Devm}
+    (run : Ninst.Run sevm d (.reg .addmod) d') : d'.memory = d.memory := by
+  rcases of_run_reg run with ⟨pc, h⟩
+  simp only [Rinst.run, Rinst.runCore] at h
+  obtain ⟨_, _, _, hd⟩ := Devm.diffBurn_of_applyTernary h
+  exact hd.memory.symm
+
+theorem run_mulmod_memory {sevm : Sevm} {d d' : Devm}
+    (run : Ninst.Run sevm d (.reg .mulmod) d') : d'.memory = d.memory := by
+  rcases of_run_reg run with ⟨pc, h⟩
+  simp only [Rinst.run, Rinst.runCore] at h
+  obtain ⟨_, _, _, hd⟩ := Devm.diffBurn_of_applyTernary h
+  exact hd.memory.symm
+
 theorem run_mload_memory {sevm : Sevm} {d d' : Devm} {o : B256} {rest : List B256}
     (hs : d.stack = o :: rest) (run : Ninst.Run sevm d (.reg .mload) d') :
     d'.memory = d.memory.extend o.toNat 32 := by
