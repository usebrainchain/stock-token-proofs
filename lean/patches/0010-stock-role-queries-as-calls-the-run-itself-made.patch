+import Blanc.Lift.Stock.Query
+import Blanc.Lift.CursorOccurrence
+
+/-!
+# Stock: the registry answered during this run
+
+`StaticAnswered` says that a successful static call to the registry with the given calldata exists
+over a world; it does not record that the call is one the run made.  `CalledInRun` does: it names
+an actual instruction occurrence in the frame's own derivation (`CallOccurrenceStep`, a node of
+the frame reached from its root), a `STATICCALL` whose stack held the registry as target and whose
+input window held the calldata, and whose own step result left the success flag `1` and the reply
+as return data.  The `StaticAnswered` fact is kept beside it, over that node's world.
+
+The cursor reaches the call frame-free (`stock_walk`, `CursorStateAt.gasH` for the `GAS` word),
+takes the call's occurrence (`cursor_next_call_occurrence_forwardH`), and reads the reply off the
+source run from the returned node.
+-/
+
+namespace Blanc.Lift.Stock
+
+open Jaune Blanc Blanc.Lift
+
+/-- **The run itself made the registry call.**  An actual `STATICCALL` occurrence of the frame
+`F`'s own execution, from a machine over the world `b` whose stack held the target `t` and whose
+input window read `data`, left the success flag `1` and returned `out`; and that call is a
+successful static message to `t` over `b`'s world. -/
+def CalledInRun (F : Exec.Deriv) (t : Adr) (data out : Bytes) : Prop :=
+  ∃ step : CallOccurrenceStep F .staticcall,
+    ∃ (b : Devm) (gw tw ii is oi os : B256) (S : List B256) (M : Mem) (G : Nat),
+      step.occurrence.node.devm = St b (gw :: tw :: ii :: is :: oi :: os :: S) M G ∧
+      tw.toAdr = t ∧ (M.read ii.toNat is.toNat).1 = data ∧
+      step.returned.devm.stack = 1 :: S ∧ step.returned.devm.returnData = out ∧
+      StaticAnswered F.sevm b t data out
+
+section Cuts
+
+variable {code : ByteArray} {c : Cert} {F : Exec.Deriv} {b : Devm} {S : List B256} {M : Mem}
+  {K : List SFunc} {post : Devm}
+
+/-- `GAS` at the cursor: the word it pushes is the run's own. -/
+theorem CursorStateAt.gasH {f : SFunc}
+    (cut : CursorStateAt code c F (.next (.reg .gas) f) b S M K)
+    (checked : Cert.check code c = true) (success : F.exn = .ok post)
+    (hsg : F.sevm.benvStat.rules.stateGas = none) :
+    ∃ w, Nonempty (CursorStateAt code c F f b (w :: S) M K) := by
+  obtain ⟨N, κ', _, _, sameSevm, sameExn, ok, tree, primitive, sameK, free⟩ :=
+    cursor_nexts_line_cont_free_forwardH checked cut.placed [.reg .gas] f cut.tree
+      (cut.exn_eq.trans success) (cut.sevm_eq ▸ hsg)
+  obtain ⟨G, state⟩ := cut.state
+  have line : Line.Run F.sevm (St b S M G) [.reg .gas] N.devm := by
+    rw [← cut.sevm_eq, ← state]
+    exact primitive
+  obtain ⟨_, step, rest⟩ := Line.of_run_cons line
+  cases rest
+  obtain ⟨w, G', e⟩ := ri_gas step
+  exact ⟨w, ⟨⟨N, κ', cut.free.trans (free (by
+      intro m hm x
+      rw [List.mem_singleton] at hm
+      subst hm
+      intro h
+      cases h)), sameSevm.trans cut.sevm_eq, sameExn.trans cut.exn_eq, ok, tree, ⟨G', e⟩,
+    by rw [sameK]; exact cut.continuations⟩⟩⟩
+
+theorem SStep.tree_of_next {κ κ' : Cursor} {n : Ninst} {f : SFunc} (h : SStep c κ κ')
+    (t : κ.f = .next n f) : κ'.f = f := by
+  cases h <;> first | (cases t; rfl) | cases t
+
+theorem parentStep_exn {child parent : Exec.Deriv} (e : Exec.Deriv.ParentStep child parent) :
+    child.exn = parent.exn := by
+  cases e <;> rfl
+
+end Cuts
+
+/-- The reply handler of entry 119, from the flag the call left: a run that does not revert saw
+the flag `1`, at least 32 returned bytes and a first word `1`. -/
+theorem flag_reply_checked {P : Sevm → Devm → Ninst → Devm → Prop}
+    (project : ∀ {s d i d'}, P s d i d' → Ninst.Run s d i d')
+    {sevm : Sevm} {d : Devm} {flag e s t A R : B256} {S : List B256} {M : Mem} {I : Bytes}
+    {G : Nat} {o : Outcome} {out : Bytes} (flagCases : flag = 0 ∨ flag = 1)
+    (returned : d.returnData = out) (bound : out.length < 2 ^ 256)
+    (reads : Mem.Reads M I) (wf : Mem.Wf M) (ptr : I.sliceD 64 32 0 = (128 : B256).toBytes)
+    (reply : (out.take 32).length = 32 → I.sliceD 128 32 0 = out.take 32)
+    (run : SFunc.RunP P cert.prog sevm (St d (flag :: e :: s :: t :: A :: R :: S) M G)
+      (flagLine.foldr SFunc.next (.branch t_1ec4_c119 t_1ecb_c119)) o) :
+    flag = 1 ∧ 32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 1 := by
+  obtain ⟨_, line, run⟩ := rpw_nexts project flagLine run
+  obtain ⟨_, rfl⟩ := flag_line line
+  rcases rpw_branch run with ⟨_, _, dead⟩ | ⟨accepted, _, run⟩
+  · exact (rpw_dead rfl dead).elim
+  have flagOne : flag = 1 := by
+    rcases flagCases with zero | one
+    · subst zero
+      exact absurd (by decide : B256.eqCheck (B256.eqCheck (0 : B256) 0) 0 = 0) accepted
+    · exact one
+  exact ⟨flagOne, reply_checked project returned bound reads wf ptr reply run⟩
+
+theorem fp128 :
+    Bytes.toB256 (freeMem.read (Bytes.toB256 [0x40]).toNat 32).1 = (128 : B256) := by
+  rw [(Mem.reads_empty.write Mem.wf_empty 64 (128 : B256).toBytes).read,
+    show (Bytes.toB256 [0x40]).toNat = 64 by decide,
+    show (Bytes.writeAt [] 64 (128 : B256).toBytes).sliceD 64 32 0 = (128 : B256).toBytes by decide,
+    B256.toB256_toBytes]
+
+/-- From a call into `_checkRole(role)` (entry 88) with the free pointer at `0x80`: the run itself
+asked the registry `hasRole(role, caller)` and was answered with at least 32 bytes whose first word
+is `1`. -/
+theorem role_answered_in_run {F : Exec.Deriv} {post : Devm} {f : SFunc} {t R : B256}
+    {S : List B256} {K : List SFunc}
+    (cut : CursorStateAt code cert F (.callNext 88 f) F.devm (t :: R :: S) freeMem K)
+    (success : F.exn = .ok post) (fork : CoveredFork F.sevm.benvStat.fork) :
+    ∃ out : Bytes, CalledInRun F registry (hasRoleData R F.sevm.caller) out ∧
+      32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 1 := by
+  have neutral := fork.histFork.neutral
+  have hsg := neutral.stateGas
+  obtain ⟨cut⟩ := cut.callH (g := t_1954_c88) cert_check success hsg rfl
+  stock_walk [119]
+  obtain ⟨cut⟩ := cut.callH (g := t_1e60_c119) cert_check success hsg rfl
+  stock_walk
+  obtain ⟨gw, ⟨cut⟩⟩ := CursorStateAt.gasH cut cert_check success hsg
+  rw [fp128] at cut
+  have reads : Mem.Reads freeMem (Bytes.writeAt [] 64 (128 : B256).toBytes) :=
+    Mem.reads_empty.write Mem.wf_empty 64 _
+  have wf : Mem.Wf freeMem := Mem.Wf.write Mem.wf_empty 64 _
+  have ptr : (Bytes.writeAt [] 64 (128 : B256).toBytes).sliceD 64 32 0 = (128 : B256).toBytes := by
+    decide
+  obtain ⟨I3, r3, w3, p3, d3⟩ := query_memory_at (A := F.sevm.caller.toB256) (R := R) reads wf ptr
+    (by decide) (by decide)
+  have fp2 : Bytes.toB256 ((queryMemAt freeMem 128 F.sevm.caller.toB256 R).read
+      (Bytes.toB256 [0x40]).toNat 32).1 = 128 := by
+    rw [r3.read, show (Bytes.toB256 [0x40]).toNat = 64 by decide, p3, B256.toB256_toBytes]
+  unfold queryMemAt at r3 w3 fp2
+  obtain ⟨step, κ', hnode, _, prim, sstep, _, ok⟩ :=
+    cursor_next_call_occurrence_forwardH cert_check cut.free.1 cut.placed cut.tree
+      (cut.exn_eq.trans success) (by rw [cut.sevm_eq]; exact hsg)
+  obtain ⟨G, state⟩ := cut.state
+  have callRun := prim.toRun
+  rw [cut.sevm_eq, state] at callRun
+  obtain ⟨flag, out, callPost, bound, answered⟩ := ri_staticcall_bounded fork callRun
+  have tree' : κ'.f = flagLine.foldr SFunc.next (.branch t_1ec4_c119 t_1ecb_c119) :=
+    SStep.tree_of_next sstep cut.tree
+  have exnR : step.returned.exn = .ok post := by
+    rw [parentStep_exn step.edge, hnode, cut.exn_eq, success]
+  have sevmR : step.returned.sevm = F.sevm := by
+    rw [Cursor.parentStep_sevm step.edge, hnode, cut.sevm_eq]
+  obtain ⟨outcome, run⟩ := ok.sourceRunH cert_check exnR (by rw [sevmR]; exact hsg)
+  rw [tree', sevmR, callPost.eq_St] at run
+  simp only [fp2, add_sub_cancel_right'] at run answered callPost
+  have ht : (Bytes.toB256 [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+      0xe1, 0x0b, 0x6f, 0x6b, 0x27, 0x5d, 0xe2, 0x31, 0x34, 0x5c, 0x20, 0xd1, 0x4a, 0xb8, 0x12,
+      0xdb, 0x62, 0x15, 0x1b, 0x00] &&& ((Bytes.toB256 [0x01] <<< (Bytes.toB256 [0xa0]).toNat) -
+      Bytes.toB256 [0x01])).toAdr = registry := by
+    rw [mask_eq]
+    exact registry_word
+  have n68 : (Bytes.toB256 [0x44]).toNat = 68 := by decide
+  have n32 : (Bytes.toB256 [0x20]).toNat = 32 := by decide
+  have n128 : (128 : B256).toNat = 128 := by decide
+  have rq := r3.extend (Bytes.toB256 [0x40]).toNat 32
+  have wq := Mem.Wf.extend w3 (Bytes.toB256 [0x40]).toNat 32
+  have data := (rq.read (128 : B256).toNat (Bytes.toB256 [0x44]).toNat).trans
+    (show I3.sliceD (128 : B256).toNat (Bytes.toB256 [0x44]).toNat 0 = hasRoleData R F.sevm.caller by
+      rw [n68, d3]
+      simp only [hasRoleData, toAdr_toB256])
+  rw [← Mem.read_snd_eq] at data
+  have rM := (rq.extends [((128 : B256).toNat, (Bytes.toB256 [0x44]).toNat),
+    ((128 : B256).toNat, (Bytes.toB256 [0x20]).toNat)]).write (Mem.Wf.extends _ wq)
+      (128 : B256).toNat (out.take (Bytes.toB256 [0x20]).toNat)
+  have wM := Mem.Wf.write (Mem.Wf.extends [((128 : B256).toNat, (Bytes.toB256 [0x44]).toNat),
+    ((128 : B256).toNat, (Bytes.toB256 [0x20]).toNat)] wq) (128 : B256).toNat
+      (out.take (Bytes.toB256 [0x20]).toNat)
+  have pM : (Bytes.writeAt I3 (128 : B256).toNat (out.take (Bytes.toB256 [0x20]).toNat)).sliceD
+      64 32 0 = (128 : B256).toBytes := by
+    rw [Bytes.sliceD_writeAt_before _ _ _ _ _ (by rw [n128]; omega), p3]
+  have replyM : (out.take 32).length = 32 →
+      (Bytes.writeAt I3 (128 : B256).toNat (out.take (Bytes.toB256 [0x20]).toNat)).sliceD 128 32 0 =
+        out.take 32 := by
+    intro takeLen
+    have back := Bytes.sliceD_writeAt I3 (out.take 32) 128
+    rw [takeLen] at back
+    rw [n128, n32, back]
+  obtain ⟨flagOne, long, one⟩ := flag_reply_checked (fun h => StepIn.toRun h) callPost.flag
+    callPost.returnData bound rM wM pM replyM run
+  have asked := answered flagOne
+  rw [ht, data] at asked
+  simp only [fp2, add_sub_cancel_right'] at state
+  exact ⟨out, ⟨step, F.devm, gw, _, _, _, _, _, _, _, G, hnode ▸ state, ht, data,
+    by rw [callPost.stack, flagOne], callPost.returnData, asked⟩, long, one⟩
+
+/-- Property 5's claim in the run-tied form: the run itself asked the registry
+`hasRole(role, caller)` and was answered with at least 32 bytes whose first word is `1`. -/
+abbrev RoleCalled (F : Exec.Deriv) (role : B256) : Prop :=
+  ∃ out : Bytes, CalledInRun F registry (hasRoleData role F.sevm.caller) out ∧
+    32 ≤ out.length ∧ Bytes.toB256 (out.take 32) = 1
+
+/-- **`pause()`: the run itself asked for the role.** -/
+theorem pause_role_in_run {F : Exec.Deriv} {post : Devm}
+    (pc : F.pc = 0) (onCode : F.sevm.code = code)
+    (stack : F.devm.stack = []) (memory : F.devm.memory = Mem.empty)
+    (selector : Sevm.selector F.sevm = pauseSelector)
+    (success : F.exn = .ok post) (fork : CoveredFork F.sevm.benvStat.fork) :
+    RoleCalled F tokenPauserRole := by
+  have neutral := fork.histFork.neutral
+  have hsg := neutral.stateGas
+  obtain ⟨cut⟩ := root_selected pc onCode stack memory success neutral
+  rw [selector] at cut
+  obtain ⟨cut⟩ := SolcSignedQuery.selector_gt_zero cut cert_check (by decide) success neutral
+  obtain ⟨cut⟩ := SolcSignedQuery.selector_gt_succ cut cert_check (by decide) success neutral
+  obtain ⟨cut⟩ := cut.destH cert_check success hsg
+  obtain ⟨cut⟩ := SolcSignedQuery.selector_gt_succ cut cert_check (by decide) success neutral
+  obtain ⟨cut⟩ := cut.destH cert_check success hsg
+  obtain ⟨cut⟩ := SolcSignedQuery.selector_eq_zero cut cert_check (by decide) success neutral
+  obtain ⟨cut⟩ := SolcSignedQuery.selector_eq_zero cut cert_check (by decide) success neutral
+  obtain ⟨cut⟩ := SolcSignedQuery.selector_eq_zero cut cert_check (by decide) success neutral
+  obtain ⟨cut⟩ := SolcSignedQuery.selector_eq_succ cut cert_check (by decide) rfl success neutral
+  stock_walk [88]
+  obtain ⟨out, called, long, one⟩ := role_answered_in_run cut success fork
+  rw [role_word] at called
+  exact ⟨out, called, long, one⟩
+
+/-- **`unpause()`: the run itself asked for the role.** -/
